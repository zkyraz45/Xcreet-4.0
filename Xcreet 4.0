Section(P10, "Movimiento extra")
local gravOn, gravVal = false, math.floor(origGrav)
ToggleStep(P10, "Gravedad", 0, 400, 20, gravVal, function(v)
gravVal = v
if gravOn then Workspace.Gravity = v end
end, function(on)
gravOn = on
Workspace.Gravity = on and gravVal or origGrav
end)
local autoJump, spinOn, spinSpeed, antiVoid = false, false, 6, false
Toggle(P10, "Salto automático", "Salta solo mientras caminas", false, function(v) autoJump = v end)
ToggleStep(P10, "Girar", 2, 20, 2, spinSpeed, function(v) spinSpeed = v end, function(on)
spinOn = on
if not on then
local r = getRoot()
if r then r.AssemblyAngularVelocity = Vector3.new() end
end
end)
Toggle(P10, "Anti-vacío", "Te devuelve al último suelo si caes", false, function(v) antiVoid = v end)
local lastSafe, safeT = nil, 0
track(RunService.Heartbeat:Connect(function(dt)
local hum, root = getHum(), getRoot()
if not (hum and root) then return end
if autoJump and hum.MoveDirection.Magnitude > 0.1 and hum.FloorMaterial ~= Enum.Material.Air then
hum.Jump = true
end
if spinOn then root.AssemblyAngularVelocity = Vector3.new(0, spinSpeed, 0) end
if antiVoid then
safeT = safeT + dt
if hum.FloorMaterial ~= Enum.Material.Air and safeT > 0.5 then
safeT = 0
lastSafe = root.CFrame
end
if lastSafe and root.Position.Y < Workspace.FallenPartsDestroyHeight + 150 then
root.AssemblyLinearVelocity = Vector3.new()
root.CFrame = lastSafe
end
end
end))
Section(P10, "Cámara")
local origZoom = { lp.CameraMinZoomDistance, lp.CameraMaxZoomDistance }
Toggle(P10, "Zoom ilimitado", "Aleja la cámara todo lo que quieras", false, function(v)
lp.CameraMaxZoomDistance = v and 100000 or origZoom[2]
lp.CameraMinZoomDistance = origZoom[1]
end)
