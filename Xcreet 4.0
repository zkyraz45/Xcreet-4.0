Lighting.ClockTime, Lighting.FogEnd, Lighting.GlobalShadows = orig.clock, orig.fog, orig.shadows
toast("Ambiente restaurado")
end)
Section(P10, "Servidor")
local infoRow = Row(P10, 52)
local infoL = label(infoRow, {
Position = UDim2.fromOffset(12, 0), Size = UDim2.new(1, -24, 1, 0), TextSize = 11, Font = Enum.Font.Gotham,
TextColor3 = T.sub, TextWrapped = true, TextTruncate = Enum.TextTruncate.None,
})
local function refreshInfo()
local ping = "?"
pcall(function() ping = tostring(math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue())) .. " ms" end)
local ex = "?"
pcall(function() if identifyexecutor then ex = tostring((identifyexecutor())) end end)
infoL.Text = "Jugadores: " .. #Players:GetPlayers() .. "/" .. Players.MaxPlayers .. " · Ping: " .. ping
		.. "\nJuego: " .. pid .. " · Ejecutor: " .. ex
end
local function hop(small)
report("Buscando servidor…")
local body = getUrl("https://games.roproxy.com/v1/games/" .. pid .. "/servers/Public?sortOrder=Asc&limit=100")
if not body then report("No pude consultar los servidores") return end
local ok, data = pcall(function() return HttpService:JSONDecode(body) end)
if not ok or type(data) ~= "table" or type(data.data) ~= "table" then report("Respuesta inválida") return end
local cands = {}
for _, s in ipairs(data.data) do
if s.id ~= game.JobId and s.playing and s.maxPlayers and s.playing < s.maxPlayers then cands[#cands + 1] = s end
end
if #cands == 0 then report("No hay otros servidores disponibles") return end
local pick = small and cands[math.random(1, math.min(#cands, 5))] or cands[math.random(1, #cands)]
report("Saltando a un servidor con " .. tostring(pick.playing) .. " jugadores…")
TeleportService:TeleportToPlaceInstance(game.PlaceId, pick.id, lp)
end
ButtonRow(P10, {
{ "Servidor vacío", T.accent, function() hop(true) end },
{ "Servidor al azar", T.text, function() hop(false) end },
})
