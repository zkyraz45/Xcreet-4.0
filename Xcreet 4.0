local function track(c) conns[#conns + 1] = c return c end
local T = {
accent = Color3.fromRGB(255, 122, 175),
purple = Color3.fromRGB(190, 160, 255),
green = Color3.fromRGB(46, 158, 106),
red = Color3.fromRGB(214, 66, 100),
yellow = Color3.fromRGB(245, 190, 90),
text = Color3.fromRGB(34, 27, 46),
sub = Color3.fromRGB(94, 82, 112),
white = Color3.new(1, 1, 1),
off = Color3.fromRGB(190, 180, 204),
}
local function new(class, props, parent)
local o = Instance.new(class)
for k, v in pairs(props or {}) do o[k] = v end
if parent then o.Parent = parent end
return o
end
local function tween(o, t, props, style, dir)
local tw = TweenService:Create(o, TweenInfo.new(t, style or Enum.EasingStyle.Quint, dir or Enum.EasingDirection.Out), props)
tw:Play()
return tw
end
local function corner(parent, r) return new("UICorner", { CornerRadius = UDim.new(0, r) }, parent) end
local function circle(parent) return new("UICorner", { CornerRadius = UDim.new(1, 0) }, parent) end
local function stroke(parent, transp, thick, color)
return new("UIStroke", {
Color = color or Color3.fromRGB(255, 255, 255), Transparency = transp or 0.35, Thickness = thick or 1,
ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
}, parent)
end
local function label(parent, props)
local base = {
BackgroundTransparency = 1, Font = Enum.Font.GothamMedium, TextColor3 = T.text,
TextSize = 14, TextXAlignment = Enum.TextXAlignment.Left, Text = "",
TextTruncate = Enum.TextTruncate.AtEnd,
}
for k, v in pairs(props) do base[k] = v end
return new("TextLabel", base, parent)
end
local function safe(cb, ...)
local ok, err = pcall(cb, ...)
if not ok then warn("[Xcreet] " .. tostring(err)) end
end
local function trySet(inst, prop, val)
local ok = pcall(function() inst[prop] = val end)
if not ok and sethiddenproperty then pcall(sethiddenproperty, inst, prop, val) end
end
local accentRegs, repaintFns = {}, {}
local function txtAcc(c)
if 0.299 * c.R + 0.587 * c.G + 0.114 * c.B > 0.42 then return c:Lerp(Color3.new(0, 0, 0), 0.5) end
return c
end
local function accentReg(inst, prop)
accentRegs[#accentRegs + 1] = { inst, prop }
inst[prop] = (prop == "TextColor3") and txtAcc(T.accent) or T.accent
end
local function setAccent(col)
T.accent = col
for i = #accentRegs, 1, -1 do
local r = accentRegs[i]
if r[1].Parent then
pcall(function() r[1][r[2]] = (r[2] == "TextColor3") and txtAcc(col) or col end)
else
table.remove(accentRegs, i)
end
end
for _, f in ipairs(repaintFns) do pcall(f) end
end
