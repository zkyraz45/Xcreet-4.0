end))
local upd = new("TextButton", {
AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -74, 0.5, 0), Size = UDim2.fromOffset(60, 28),
Text = "Actualizar", Font = Enum.Font.GothamBold, TextSize = 11, TextColor3 = T.white, AutoButtonColor = false, BorderSizePixel = 0,
}, r)
accentReg(upd, "BackgroundColor3")
circle(upd)
track(upd.Activated:Connect(function()
local n2 = captureSkin(rec.name)
n2.id = rec.id
skins[i] = n2
skinsSave()
toast("Actualizada con lo que llevas: " .. tostring(rec.name))
rebuildSkins()
end))
local del = new("TextButton", {
AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0), Size = UDim2.fromOffset(58, 28),
BackgroundColor3 = T.red, Text = "Borrar", Font = Enum.Font.GothamBold, TextSize = 11, TextColor3 = T.white,
AutoButtonColor = false, BorderSizePixel = 0,
}, r)
circle(del)
track(del.Activated:Connect(function()
table.remove(skins, i)
skinsSave()
rebuildSkins()
end))
end
end
InputRow(PV, "Nombre de la skin (guarda lo que llevas ahora)", "Guardar", function(t)
local nm = tostring(t or ""):match("^%s*(.-)%s*$")
if nm == "" then nm = "Skin " .. (#skins + 1) end
skins[#skins + 1] = captureSkin(nm)
skinsSave()
toast("Skin guardada: " .. nm)
rebuildSkins()
end)
ButtonRow(PV, {
{ "Copiar todas (código)", T.accent, function()
local ok = pcall(function() setclipboard(HttpService:JSONEncode({ v = 1, list = skins })) end)
toast(ok and "Código copiado" or "Tu executor no permite copiar")
end },
{ "Reparar cuerpo", T.text, function() if env.XC_REPAIR then env.XC_REPAIR() end end },
{ "Mi avatar original", T.green, function() if env.XC_ORIGINAL then env.XC_ORIGINAL() end end },
})
InputRow(PV, "Pegar código de skins", "Importar", function(t)
local ok, d = pcall(function() return HttpService:JSONDecode(tostring(t or "")) end)
if not ok or type(d) ~= "table" or type(d.list) ~= "table" then toast("Código no válido") return end
local n = 0
for _, rec in ipairs(d.list) do
if type(rec) == "table" and rec.name then
rec.id = tostring(os.time()) .. tostring(math.random(100, 999))
skins[#skins + 1] = rec
n = n + 1
end
end
skinsSave()
rebuildSkins()
toast(n .. " skins importadas")
end)
rebuildSkins()
Section(PV, "En este juego")
local gmGrid = XC.grid(PV)
local gmNote = Note(PV, "")
local gmSig = ""
local function scanGame()
local out, seen = {}, {}
local pg = lp:FindFirstChildOfClass("PlayerGui")
local function nameNear(o)
local p = o
for _ = 1, 3 do
p = p and p.Parent
if not p then break end
for _, c in ipairs(p:GetChildren()) do
if (c:IsA("TextLabel") or c:IsA("TextButton")) and c.Text ~= "" and #c.Text < 40 and not c.Text:match("^[%d%s%p]+$") then return c.Text end
end
end
return nil
end
if pg then
local n = 0
for _, o in ipairs(pg:GetDescendants()) do
n = n + 1
if n > 8000 then break end
if not o:IsDescendantOf(gui) then
local oid
if o:IsA("ImageLabel") or o:IsA("ImageButton") then
local im = tostring(o.Image)
oid = im:match("type=Outfit&id=(%d+)") or im:match("[Oo]utfit%D+(%d+)")
end
if not oid then
local a = o:GetAttribute("OutfitId") or o:GetAttribute("outfitId") or o:GetAttribute("OutfitID")
if a then oid = tostring(a):match("%d+") end
end
if not oid and (o:IsA("IntValue") or o:IsA("NumberValue") or o:IsA("StringValue")) and tostring(o.Name):lower():find("outfit", 1, true) then
oid = tostring(o.Value):match("%d+")
end
if oid and not seen["o" .. oid] then
seen["o" .. oid] = true
out[#out + 1] = { kind = "outfit", id = tonumber(oid), name = nameNear(o) or ("Outfit " .. oid) }
end
end
end
end
local nm = 0
for _, d in ipairs(Workspace:GetDescendants()) do
nm = nm + 1
if nm > 20000 or #out > 90 then break end
if d:IsA("Humanoid") then
local model = d.Parent
if model and model:IsA("Model") and model ~= lp.Character and not Players:GetPlayerFromCharacter(model)
and string.sub(model.Name, 1, 3) ~= "XC_" and not seen[model] then
seen[model] = true
out[#out + 1] = { kind = "model", hum = d, name = model.Name }
end
end
end
local RS = game:GetService("ReplicatedStorage")
local k = 0
for _, d in ipairs(RS:GetDescendants()) do
k = k + 1
if k > 6000 then break end
if d:IsA("HumanoidDescription") and not seen[d] then
seen[d] = true
out[#out + 1] = { kind = "hdesc", inst = d, name = d.Parent and d.Parent.Name ~= "" and d.Parent.Name or d.Name }
end
end
return out
end
local function gmCard(e)
local function getDesc()
if e.kind == "outfit" then return Players:GetHumanoidDescriptionFromOutfitId(e.id) end
if e.kind == "model" then return e.hum:GetAppliedDescription() end
return e.inst:Clone()
end
local isO = e.kind == "outfit"
XC.card({
id = e.id or 0, name = e.name, price = isO and "Outfit" or (e.kind == "model" and "Maniquí" or "Descripción"), tag = "Juego",
thumb = isO and ("rbxthumb://type=Outfit&id=" .. tostring(e.id) .. "&w=420&h=420") or "",
primary = function()
if isO then copyOutfit(e.id, e.name) else copyFromDesc(getDesc, e.name) end
end,
active = function() return isO and Sess.copy ~= nil and Sess.copy.outfitId == e.id end,
second = function()
local ok, d = pcall(getDesc)
view3dDesc(e.name, ok and d or nil, isO and ("rbxthumb://type=Outfit&id=" .. tostring(e.id) .. "&w=420&h=420") or nil)
end, secondText = "3D",
}, gmGrid)
end
env.XC_AvScan = function(force)
if src == 2 or src == 3 or src == 4 then
clearList(gmGrid)
gmSig = ""
gmNote.Text = ""
return
end
local list = scanGame()
local P = (kw ~= "") and M.prep(kw) or nil
local arr = {}
for i, e in ipairs(list) do
local sc = P and M.score(e.name, P) or 0
if not P or sc > 30 then arr[#arr + 1] = { e = e, s = sc, i = i } end
end
table.sort(arr, function(a, b)
if a.s ~= b.s then return a.s > b.s end
return a.i < b.i
end)
local sig = kw
for i, a in ipairs(arr) do
if i > 60 then break end
sig = sig .. "|" .. a.e.kind .. tostring(a.e.id or a.e.name)
end
if sig == gmSig and not force then return end
gmSig = sig
clearList(gmGrid)
for i, a in ipairs(arr) do
if i > 60 then break end
gmCard(a.e)
end
if #arr == 0 then
		gmNote.Text = P and ("Nada del juego coincide con \"" .. kw .. "\"") or (isAC
and "Abre la lista de outfits del juego y toca Escanear"
or "No encontré maniquíes ni outfits en este juego")
else
gmNote.Text = #arr .. ((#arr == 1) and " avatar del juego" or " avatares del juego")
end
end
Button(PV, "Escanear este juego", T.accent, function() env.XC_AvScan(true) end)
Section(PV, "En el servidor")
local srvGrid = XC.grid(PV)
local srvNote = Note(PV, "")
Section(PV, "Comunidad")
local comGrid = XC.grid(PV)
local comNote = Note(PV, "")
Section(PV, "Catálogo de Roblox")
local catGrid = XC.grid(PV)
local catNote = Note(PV, "")
local moreB = Button(PV, "Cargar más", T.accent, function() env.XC_AvRun(true) end)
moreB.Visible = false
local function srvCard(pl)
local uid = pl.UserId
XC.card({
id = uid, name = pl.DisplayName, price = "@" .. pl.Name, tag = "Servidor",
thumb = "rbxthumb://type=Avatar&id=" .. tostring(uid) .. "&w=420&h=420",
primary = function() copySkin(uid, pl.Name) end,
active = function() return Sess.copy ~= nil and Sess.copy.userId == uid end,
second = function() view3d(uid, pl.Name) end, secondText = "3D",
}, srvGrid)
end
local function rebuildServer()
clearList(srvGrid)
if src == 3 or src == 4 or src == 5 then srvNote.Text = "" return end
local P = (kw ~= "") and M.prep(kw) or nil
local arr = {}
for _, pl in ipairs(Players:GetPlayers()) do
if pl ~= lp then
local sc = P and playerScore(pl, P) or 0
if not P or sc > 30 then arr[#arr + 1] = { pl = pl, s = sc } end
end
end
table.sort(arr, function(a, b)
if a.s ~= b.s then return a.s > b.s end
return a.pl.Name:lower() < b.pl.Name:lower()
end)
for i, e in ipairs(arr) do
if i > 48 then break end
srvCard(e.pl)
end
if #arr == 0 then
		srvNote.Text = (P and "Nadie del servidor coincide con \"" .. kw .. "\"") or "No hay otros jugadores"
else
		srvNote.Text = #arr .. ((#arr == 1) and " avatar" or " avatares") .. ((P and (" para \"" .. kw .. "\"")) or " en el servidor")
end
end
local function bundleTypes()
if typeSel == 1 then return { "BodyParts" } end
if typeSel == 2 then return { "DynamicHeadAvatar" } end
return { "BodyParts", "DynamicHeadAvatar" }
end
local function maxPrice()
return ({ nil, 0, 100, 500 })[priceSel]
end
local function fetch(word)
local p = CatalogSearchParams.new()
p.SearchKeyword = word
pcall(function() p.SortType = Enum.CatalogSortType.Relevance end)
pcall(function() p.IncludeOffSale = false end)
local mx = maxPrice()
if mx then pcall(function() p.MaxPrice = mx p.MinPrice = 0 end) end
p.BundleTypes = XC.enumList(bundleTypes(), Enum.BundleType)
return AvatarEditorService:SearchCatalog(p)
end
local function addBundle(it)
local id = it.Id or it.id
if not id or catSeen[id] then return false end
catSeen[id] = true
local nm = tostring(it.Name or it.name or "Avatar")
catItems = catItems + 1
XC.card({
id = id, name = nm, price = XC.price(it.Price or it.price), tag = "Avatar",
thumb = "rbxthumb://type=BundleThumbnail&id=" .. tostring(id) .. "&w=420&h=420",
primary = function() XC.bundle(id, nm) end, active = function() return XC.bundleKeys[id] ~= nil end,
second = function()
openViewer(nm, nil, nil, nil, nil, "rbxthumb://type=BundleThumbnail&id=" .. tostring(id) .. "&w=420&h=420")
end,
secondText = "Ver",
}, catGrid)
return true
end
local function rankBatch(items, P)
local arr = {}
for i, it in ipairs(items) do
local sc = P and math.max(M.score(it.Name or it.name, P), M.score(it.CreatorName or "", P) * 0.4) or 0
arr[#arr + 1] = { it = it, s = sc, i = i }
end
table.sort(arr, function(a, b)
if a.s ~= b.s then return a.s > b.s end
return a.i < b.i
end)
return arr
end
local function runCatalog(append)
if src == 2 or src == 4 or src == 5 then
clearList(catGrid)
catNote.Text = ""
moreB.Visible = false
return
end
if not AvatarEditorService or not CatalogSearchParams then
catNote.Text = "Este executor no permite leer el catálogo"
return
end
catToken = catToken + 1
local tk = catToken
if not append then
clearList(catGrid)
catPages, catItems, catSeen = nil, 0, {}
end
catNote.Text = "Buscando…"
moreB.Visible = false
local P = (kw ~= "") and M.prep(kw) or nil
local words = { kw }
if P then
local alt = {}
for _, w in ipairs(P.toks) do alt[#alt + 1] = ALT[w] or w end
local a = table.concat(alt, " ")
if a ~= kw:lower() and a ~= "" then words[#words + 1] = a end
end
local batch, hasMore = {}, false
local ok = pcall(function()
if append and catPages then
catPages:AdvanceToNextPageAsync()
for _, it in ipairs(catPages:GetCurrentPage()) do batch[#batch + 1] = it end
hasMore = not catPages.IsFinished
else
for wi, w in ipairs(words) do
local pg = fetch(w)
if wi == 1 then catPages = pg hasMore = not pg.IsFinished end
for _, it in ipairs(pg:GetCurrentPage()) do batch[#batch + 1] = it end
end
end
end)
if tk ~= catToken then return end
if not ok then
catNote.Text = "No se pudo conectar al catálogo"
return
end
local P2 = nil
if words[2] then P2 = M.prep(words[2]) end
local ranked = rankBatch(batch, P)
if P2 then
for _, e in ipairs(ranked) do
local s2 = M.score(e.it.Name or e.it.name, P2)
if s2 > e.s then e.s = s2 * 0.95 end
end
table.sort(ranked, function(a, b)
if a.s ~= b.s then return a.s > b.s end
return a.i < b.i
end)
end
for _, e in ipairs(ranked) do addBundle(e.it) end
	catNote.Text = catItems .. " resultados" .. ((kw ~= "") and (" para \"" .. kw .. "\"") or "")
moreB.Visible = hasMore and #batch > 0
end
local comTok = 0
local function jget(url)
local ok, body = pcall(function() return game:HttpGet(url) end)
if not (ok and type(body) == "string") then
body = nil
local req = (syn and syn.request) or (http and http.request) or http_request or request
if req then
local ok2, r = pcall(req, { Url = url, Method = "GET" })
if ok2 and r and type(r.Body) == "string" then body = r.Body end
end
end
if type(body) ~= "string" then return nil end
local ok3, d = pcall(function() return HttpService:JSONDecode(body) end)
return ok3 and d or nil
end
local function runCommunity()
comTok = comTok + 1
local tk = comTok
clearList(comGrid)
if src == 2 or src == 3 or src == 5 then comNote.Text = "" return end
if kw == "" then comNote.Text = "Escribe una palabra para buscar skins de la comunidad" return end
comNote.Text = "Buscando en la comunidad…"
local P = M.prep(kw)
local words = { kw }
local alt = {}
for _, w in ipairs(P.toks) do alt[#alt + 1] = ALT[w] or w end
local a = table.concat(alt, " ")
if a ~= "" and a ~= kw:lower() then words[#words + 1] = a end
local users, seenU = {}, {}
for _, w in ipairs(words) do
local d = jget("https://users.roproxy.com/v1/users/search?keyword=" .. HttpService:UrlEncode(w) .. "&limit=10")
for ui, u in ipairs((d and d.data) or {}) do
if ui > 12 then break end
if type(u) == "table" and u.id and not seenU[u.id] then
seenU[u.id] = true
users[#users + 1] = u
end
end
end
if tk ~= comTok then return end
	if #users == 0 then comNote.Text = "Sin resultados en la comunidad para \"" .. kw .. "\"" return end
for _, u in ipairs(users) do
u.s = math.max(M.score(u.name, P), M.score(u.displayName, P))
end
table.sort(users, function(x, y) return x.s > y.s end)
local cand = {}
for i, u in ipairs(users) do
if i > 6 then break end
cand[#cand + 1] = { kind = "user", u = u, s = u.s + 5 }
local od = jget("https://avatar.roproxy.com/v1/users/" .. tostring(u.id) .. "/outfits?page=1&itemsPerPage=25&isEditable=true")
for oi, o in ipairs((od and od.data) or {}) do
if oi > 30 then break end
if type(o) == "table" and o.id then
local sc = math.max(M.score(o.name, P), u.s * 0.8)
if sc > 30 then cand[#cand + 1] = { kind = "outfit", o = o, u = u, s = sc } end
end
end
if tk ~= comTok then return end
end
table.sort(cand, function(x, y) return x.s > y.s end)
clearList(comGrid)
local n = 0
for _, c in ipairs(cand) do
if n >= 36 then break end
n = n + 1
if c.kind == "user" then
local uid = c.u.id
XC.card({
id = uid, name = tostring(c.u.displayName or c.u.name), price = "@" .. tostring(c.u.name), tag = "Usuario",
thumb = "rbxthumb://type=Avatar&id=" .. tostring(uid) .. "&w=420&h=420",
primary = function() copySkin(uid, c.u.name) end,
active = function() return Sess.copy ~= nil and Sess.copy.userId == uid end,
second = function() view3d(uid, c.u.name) end, secondText = "3D",
}, comGrid)
else
local oid, onm = c.o.id, tostring(c.o.name or "Outfit")
XC.card({
id = oid, name = onm, price = "@" .. tostring(c.u.name), tag = "Outfit",
thumb = "rbxthumb://type=Outfit&id=" .. tostring(oid) .. "&w=420&h=420",
primary = function() copyOutfit(oid, onm) end,
active = function() return Sess.copy ~= nil and Sess.copy.outfitId == oid end,
second = function()
local ok, d = pcall(function() return Players:GetHumanoidDescriptionFromOutfitId(oid) end)
view3dDesc(onm, ok and d or nil, "rbxthumb://type=Outfit&id=" .. tostring(oid) .. "&w=420&h=420")
end, secondText = "3D",
}, comGrid)
end
end
	comNote.Text = n .. " resultados de la comunidad para \"" .. kw .. "\""
end
env.XC_AvSearch = function(q)
kw = tostring(q or "")
if not win.open then openWindow() end
selectTab(13)
env.XC_AvRun(false)
end
env.XC_AvRun = function(append)
	status.Text = (kw ~= "") and ("Buscando \"" .. kw .. "\"…") or "Mostrando todo"
if not append then rebuildServer() end
task.spawn(safe, runCatalog, append)
if not append then
task.spawn(safe, runCommunity)
pcall(env.XC_AvScan, true)
end
	status.Text = (kw ~= "") and ("Resultados para \"" .. kw .. "\"") or "Servidor y catálogo"
end
local liveTok = 0
local function liveRefresh()
liveTok = liveTok + 1
local my = liveTok
task.delay(isAC and 0.6 or 1.5, function()
if my == liveTok and pages[13].Visible then pcall(rebuildServer) end
end)
end
track(Players.PlayerAdded:Connect(function(pl)
liveRefresh()
track(pl.CharacterAppearanceLoaded:Connect(liveRefresh))
end))
track(Players.PlayerRemoving:Connect(liveRefresh))
for _, pl in ipairs(Players:GetPlayers()) do
if pl ~= lp then track(pl.CharacterAppearanceLoaded:Connect(liveRefresh)) end
end
local first = true
tabHooks[13] = function()
if first then
first = false
env.XC_AvRun(false)
else
rebuildServer()
pcall(env.XC_AvScan, false)
pcall(rebuildSkins)
end
end
if isAC then
local scanAcc = 0
track(RunService.Heartbeat:Connect(function(dt)
scanAcc = scanAcc + (tonumber(dt) or 0)
if scanAcc < 6 then return end
scanAcc = 0
if pages[13].Visible then pcall(env.XC_AvScan, false) end
end))
end
end)
if not okP then DG_Fail("Pestaña Avatares", eP) end
end
if GAME.evade then
do
local okP, eP = pcall(function()
local P12 = pages[14]
local H = env.XC_H
local PT, PS = H.PT, H.PS
Note(P12, "Juego detectado: " .. (GAME.name ~= "" and GAME.name or "Evade"))
local EV = {
hop = false, hopMode = 1, hopAlways = false, crouchMode = 1, crouchKey = "C", strafe = false, pow = 5, control = 5,
cap = 0, keep = false, keepF = 10, slide = 0,
}
local KEYS = { "C", "LeftControl", "X", "Q" }
Section(P12, "Movimiento")
local tHop = PT(P12, "Auto salto", "Salta al tocar el suelo mientras te mueves", "ev_hop", function(v) EV.hop = v end)
Note(P12, "Método de salto")
Chips(P12, { "Humanoide", "Tecla espacio" }, 110, function(i) EV.hopMode = i end, 1)
PT(P12, "Saltar siempre", "Aunque no estés caminando", "ev_hopalways", function(v) EV.hopAlways = v end)
local tStrafe = PT(P12, "Air strafe", "Control y aceleración en el aire", "ev_strafe", function(v) EV.strafe = v end)
PS(P12, "Fuerza de aceleración aérea", 1, 10, 1, "ev_pow", 5, "", function(v) EV.pow = v end)
PS(P12, "Control aéreo", 0, 10, 1, "ev_control", 5, "", function(v) EV.control = v end)
PS(P12, "Tope de velocidad propio (0 = sin tope)", 0, 400, 10, "ev_cap", 0, "", function(v) EV.cap = v end)
PT(P12, "Conservar impulso al aterrizar", "Evita perder velocidad entre saltos", "ev_keep", function(v) EV.keep = v end)
PS(P12, "Impulso conservado", 5, 12, 1, "ev_keepf", 10, "", function(v) EV.keepF = v end)
Note(P12, "Agacharse automático")
local crouchChips = Chips(P12, { "Apagado", "Al aterrizar", "En el aire", "Siempre" }, 96, function(i)
EV.crouchMode = i
Sess.ev.ev_crouch = i
SessSave()
end, tonumber(Sess.ev.ev_crouch) or 1)
EV.crouchMode = tonumber(Sess.ev.ev_crouch) or 1
Note(P12, "Tecla de agacharse del juego")
Chips(P12, { "C", "Ctrl izq.", "X", "Q" }, 80, function(i, _)
EV.crouchKey = ({ "C", "LeftControl", "X", "Q" })[i]
end, 1)
PS(P12, "Impulso al agacharse (deslizar)", 0, 20, 1, "ev_slide", 0, "", function(v) EV.slide = v end)
Note(P12, "Spam de agacharse · " .. H.devName() .. " (la tecla en PC, el botón del juego en móvil)")
local spam = { on = false, rate = 12, hold = false }
local tSpam = PT(P12, "Spam de agacharse", "Pulsa agacharse muy rápido", "ev_spam", function(v) spam.on = v end)
PS(P12, "Pulsaciones por segundo", 2, 30, 1, "ev_spamrate", 12, "", function(v) spam.rate = v end)
PT(P12, "Solo mientras mantengo la tecla (PC)", nil, "ev_spamhold", function(v) spam.hold = v end)
local spamAcc = 0
track(RunService.Heartbeat:Connect(function(dt)
if not spam.on then return end
spamAcc = spamAcc + (tonumber(dt) or 0)
local step = 1 / math.max(2, spam.rate)
if spamAcc < step then return end
spamAcc = 0
if spam.hold and H.dev() == "pc" and not UIS:IsKeyDown(Enum.KeyCode[EV.crouchKey] or Enum.KeyCode.C) then return end
H.crouchTap(EV.crouchKey, math.min(0.03, step * 0.5))
end))
local wasAir, lastH, crouchHeld, hopCd = false, Vector3.zero, false, 0
local function setCrouch(on)
if crouchHeld == on then return end
crouchHeld = on
H.crouchDown(EV.crouchKey, on)
end
track(RunService.Heartbeat:Connect(function(dt)
dt = tonumber(dt) or 0.016
local hum, root = getHum(), getRoot()
if not (hum and root) then return end
local air = hum.FloorMaterial == Enum.Material.Air
local v = root.AssemblyLinearVelocity
local h = Vector3.new(v.X, 0, v.Z)
local md = hum.MoveDirection
hopCd = hopCd - dt
if wasAir and not air then
if EV.keep and lastH.Magnitude > 1 then
local dir = (h.Magnitude > 1) and h.Unit or lastH.Unit
local nh = dir * (lastH.Magnitude * EV.keepF / 10)
root.AssemblyLinearVelocity = Vector3.new(nh.X, v.Y, nh.Z)
h = nh
end
if EV.crouchMode == 2 then H.crouchTap(EV.crouchKey, 0.3) end
end
if EV.hop and not air and hopCd <= 0 and (md.Magnitude > 0.1 or EV.hopAlways) then
hopCd = 0.12
if EV.hopMode == 1 or H.dev() == "movil" then
hum.Jump = true
pcall(function() hum:ChangeState(Enum.HumanoidStateType.Jumping) end)
else
H.keyTap(Enum.KeyCode.Space, 0.04)
end
end
if EV.crouchMode == 3 then setCrouch(air)
elseif EV.crouchMode == 4 then setCrouch(true)
elseif crouchHeld then setCrouch(false) end
if air then
local changed = false
if EV.strafe and md.Magnitude > 0.1 then
local wish = md.Unit
local hm = h.Magnitude
if EV.control > 0 and hm > 1 then
local nd = h.Unit:Lerp(wish, math.clamp(EV.control * dt * 1.6, 0, 1))
if nd.Magnitude > 0.01 then h = nd.Unit * hm end
end
local proj = h:Dot(wish)
local add = math.clamp(6 + EV.pow * 1.4 - proj, 0, EV.pow * 18 * dt)
h = h + wish * add
changed = true
end
if EV.cap > 0 and h.Magnitude > EV.cap then
h = h.Unit * EV.cap
changed = true
end
if changed then root.AssemblyLinearVelocity = Vector3.new(h.X, v.Y, h.Z) end
lastH = h
else
lastH = h
end
wasAir = air
end))
track(UIS.InputBegan:Connect(function(input, gp)
if gp or EV.slide <= 0 then return end
if input.KeyCode == (Enum.KeyCode[EV.crouchKey] or Enum.KeyCode.C) then
local hum, root = getHum(), getRoot()
if hum and root and hum.MoveDirection.Magnitude > 0.1 and hum.FloorMaterial ~= Enum.Material.Air then
root.AssemblyLinearVelocity = root.AssemblyLinearVelocity + hum.MoveDirection.Unit * EV.slide * 3
end
end
end))
Section(P12, "Velocidad, salto y topes")
Note(P12, "Actúan sobre los atributos del personaje y del jugador si el juego los usa.")
local MULT = { speed = 10, jump = 10, accel = 10, fric = 10 }
local uncap = false
local origAttr = {}
local PATS = {
{ "speed", { "speed" } }, { "jump", { "jump" } }, { "accel", { "accel" } }, { "fric", { "friction" } },
}
local function rescale()
for _, t in ipairs({ lp.Character, lp }) do
if t then
for k, v in pairs(t:GetAttributes()) do
if type(v) == "number" then
local lk = k:lower()
local isCap = lk:find("cap", 1, true) or lk:find("max", 1, true) or lk:find("limit", 1, true)
for _, p in ipairs(PATS) do
for _, w in ipairs(p[2]) do
if lk:find(w, 1, true) then
origAttr[t] = origAttr[t] or {}
local rec = origAttr[t][k]
if rec == nil or (t:GetAttribute(k) ~= rec.set and rec.set ~= nil and false) then
rec = { orig = v }
origAttr[t][k] = rec
end
local m = MULT[p[1]] / 10
if p[1] == "fric" then m = (m ~= 0) and (1 / m) or 1 end
local val = rec.orig * m
if uncap and isCap then val = rec.orig * 10 * math.max(m, 1) end
if val ~= v then
rec.set = val
pcall(function() t:SetAttribute(k, val) end)
end
end
end
end
end
end
end
end
end
local multAcc, multOn = 0, false
track(RunService.Heartbeat:Connect(function(dt)
if not multOn then return end
multAcc = multAcc + (tonumber(dt) or 0)
if multAcc < 0.3 then return end
multAcc = 0
pcall(rescale)
end))
local function multRestore()
for t, list in pairs(origAttr) do
for k, rec in pairs(list) do pcall(function() t:SetAttribute(k, rec.orig) end) end
end
origAttr = {}
end
PS(P12, "Velocidad (10 = normal)", 5, 60, 1, "ev_m_speed", 10, "", function(v) MULT.speed = v end)
PS(P12, "Salto (10 = normal)", 5, 60, 1, "ev_m_jump", 10, "", function(v) MULT.jump = v end)
PS(P12, "Aceleración (10 = normal)", 5, 60, 1, "ev_m_accel", 10, "", function(v) MULT.accel = v end)
PS(P12, "Fricción (10 = normal, más = menos fricción)", 5, 60, 1, "ev_m_fric", 10, "", function(v) MULT.fric = v end)
PT(P12, "Quitar topes de velocidad", "Sube los límites máximos de velocidad y salto", "ev_uncap", function(v) uncap = v end)
PT(P12, "Aplicar multiplicadores", "Se reaplican cada instante", "ev_multon", function(v)
multOn = v
if not v then multRestore() end
end)
Button(P12, "Restaurar valores originales", T.red, function() multRestore() multOn = false toast("Valores originales") end)
Section(P12, "Visión")
local botOn, plrOn, hudOn, radarOn = false, false, true, false
local botNames = { "nextbot" }
local marks, cands = {}, {}
local function unmark(model)
local m = marks[model]
if m then
pcall(function() m.hl:Destroy() end)
pcall(function() m.bb:Destroy() end)
marks[model] = nil
end
end
local function clearKind(kind)
local list = {}
for model, m in pairs(marks) do if m.kind == kind then list[#list + 1] = model end end
for _, model in ipairs(list) do unmark(model) end
end
local COLORS = { bot = Color3.fromRGB(255, 70, 90), plr = Color3.fromRGB(90, 230, 140), down = Color3.fromRGB(255, 205, 80) }
local function mark(model, kind)
local m = marks[model]
if m and m.kind == kind then return m end
unmark(model)
local col = COLORS[kind]
local part = model.PrimaryPart or model:FindFirstChild("HumanoidRootPart") or model:FindFirstChildWhichIsA("BasePart")
if not part then return nil end
local hl = new("Highlight", {
Adornee = model, FillColor = col, OutlineColor = Color3.fromRGB(255, 255, 255), FillTransparency = 0.6,
OutlineTransparency = 0.1, DepthMode = Enum.HighlightDepthMode.AlwaysOnTop,
}, gui)
local bb = new("BillboardGui", {
Adornee = part, AlwaysOnTop = true, Size = UDim2.fromOffset(150, 26), StudsOffset = Vector3.new(0, 3.5, 0),
}, gui)
local lbl = label(bb, {
Size = UDim2.fromScale(1, 1), TextSize = 13, Font = Enum.Font.GothamBold, TextColor3 = col,
TextXAlignment = Enum.TextXAlignment.Center, TextStrokeTransparency = 0.3,
})
m = { hl = hl, bb = bb, lbl = lbl, kind = kind, part = part }
marks[model] = m
return m
end
local function consider(d)
local model
if d:IsA("Humanoid") then
model = d.Parent
elseif d:IsA("Model") then
local n = d.Name:lower()
for _, p in ipairs(botNames) do
if n:find(p, 1, true) then model = d break end
end
end
if model and model:IsA("Model") and not Players:GetPlayerFromCharacter(model) and model ~= lp.Character then
cands[model] = true
end
end
local function initialScan()
cands = {}
for _, d in ipairs(Workspace:GetDescendants()) do consider(d) end
end
track(Workspace.DescendantAdded:Connect(function(d) if botOn or radarOn or EV.escape or EV.dodge then consider(d) end end))
env.XC_H.bots = cands
local alertF = new("Frame", {
AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 118), Size = UDim2.fromOffset(210, 28),
BackgroundColor3 = Color3.fromRGB(14, 14, 16), BackgroundTransparency = 0.2, BorderSizePixel = 0, Visible = false,
}, gui)
corner(alertF, 14)
local alertS = new("UIStroke", { Thickness = 1.5, Color = Color3.fromRGB(70, 160, 110), Transparency = 0.2 }, alertF)
local alertL = label(alertF, {
Size = UDim2.fromScale(1, 1), TextXAlignment = Enum.TextXAlignment.Center, TextColor3 = Color3.fromRGB(245, 245, 247),
TextSize = 12, Font = Enum.Font.GothamBold,
})
local RAD, RANGE = 62, 140
local radar = new("Frame", {
AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -12, 0, 112), Size = UDim2.fromOffset(RAD * 2, RAD * 2),
BackgroundColor3 = Color3.fromRGB(12, 12, 14), BackgroundTransparency = 0.35, BorderSizePixel = 0, Visible = false,
}, gui)
circle(radar)
new("UIStroke", { Thickness = 1, Color = Color3.fromRGB(255, 255, 255), Transparency = 0.7 }, radar)
local rc = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(5, 5), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0 }, radar)
circle(rc)
local dots = {}
for i = 1, 30 do
local d = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(5, 5), BorderSizePixel = 0, Visible = false, ZIndex = 2 }, radar)
circle(d)
dots[i] = d
end
local nearest = { name = nil, dist = math.huge, pos = nil }
local acc2, escCd, dodgeCd = 0, 0, 0
local safeCF
track(RunService.Heartbeat:Connect(function(dt)
dt = tonumber(dt) or 0.016
escCd = escCd - dt
dodgeCd = dodgeCd - dt
acc2 = acc2 + dt
if acc2 < 0.12 then return end
acc2 = 0
local root = getRoot()
local cam = Workspace.CurrentCamera
nearest = { name = nil, dist = math.huge, pos = nil }
local used = 0
local function dot(pos, col)
if not (radarOn and root and cam) or used >= #dots then return end
local rel = pos - root.Position
local look = Vector3.new(cam.CFrame.LookVector.X, 0, cam.CFrame.LookVector.Z)
if look.Magnitude < 0.01 then return end
look = look.Unit
right = Vector3.new(-look.Z, 0, look.X)
local x, z = rel:Dot(right) / RANGE * RAD, rel:Dot(look) / RANGE * RAD
local m = math.sqrt(x * x + z * z)
local edge = RAD - 4
if m > edge then x, z = x / m * edge, z / m * edge end
used = used + 1
local d = dots[used]
d.Visible = true
d.BackgroundColor3 = col
d.Position = UDim2.new(0.5, x, 0.5, -z)
end
local wantBots = botOn or radarOn or EV.escape or EV.dodge
for model in pairs(cands) do
if not model.Parent or not model:IsDescendantOf(Workspace) then
cands[model] = nil
unmark(model)
elseif wantBots then
local part = model.PrimaryPart or model:FindFirstChild("HumanoidRootPart") or model:FindFirstChildWhichIsA("BasePart")
if part and root then
local dist = (part.Position - root.Position).Magnitude
if dist < nearest.dist then nearest = { name = model.Name, dist = dist, pos = part.Position } end
dot(part.Position, COLORS.bot)
if botOn then
local m = mark(model, "bot")
if m then m.lbl.Text = model.Name .. " · " .. math.floor(dist) end
end
end
end
end
if plrOn or radarOn then
for _, pl in ipairs(Players:GetPlayers()) do
local ch = pl.Character
if pl ~= lp and ch and ch.Parent then
local down = ch:GetAttribute("Downed") == true
local part = ch:FindFirstChild("HumanoidRootPart")
if part and root then
dot(part.Position, down and COLORS.down or COLORS.plr)
if plrOn then
local m = mark(ch, down and "down" or "plr")
if m and m.part.Parent then
m.lbl.Text = pl.DisplayName .. (down and " · caído" or "") .. " · " .. math.floor((m.part.Position - root.Position).Magnitude)
end
end
end
end
end
for model, m in pairs(marks) do
if (m.kind == "plr" or m.kind == "down") and (not plrOn or not model.Parent or not Players:GetPlayerFromCharacter(model)) then unmark(model) end
end
end
for i = used + 1, #dots do dots[i].Visible = false end
radar.Visible = radarOn
if hudOn and botOn and nearest.name then
alertF.Visible = true
alertL.Text = nearest.name .. " a " .. math.floor(nearest.dist) .. " studs"
alertS.Color = (nearest.dist < 40 and Color3.fromRGB(230, 70, 90)) or (nearest.dist < 90 and Color3.fromRGB(230, 170, 60)) or Color3.fromRGB(70, 160, 110)
else
alertF.Visible = false
end
if root and nearest.pos then
if EV.escape and nearest.dist < EV.escDist and safeCF and escCd <= 0 then
escCd = 2.5
root.CFrame = safeCF
toast("Escapando al punto seguro")
elseif EV.dodge and nearest.dist < EV.dodgeDist and dodgeCd <= 0 then
dodgeCd = 0.7
local away = Vector3.new(root.Position.X - nearest.pos.X, 0, root.Position.Z - nearest.pos.Z)
if away.Magnitude > 0.1 then
local hum = getHum()
if hum then hum.Jump = true end
root.AssemblyLinearVelocity = root.AssemblyLinearVelocity + away.Unit * EV.dodgeForce * 6 + Vector3.new(0, 18, 0)
end
end
end
end))
local tBot = PT(P12, "ESP de bots", "Resalta nextbots con la distancia", "ev_botesp", function(v)
botOn = v
if v then initialScan() else clearKind("bot") end
end)
PT(P12, "ESP de jugadores", "Verde, amarillo si están caídos", "ev_plresp", function(v)
plrOn = v
if not v then clearKind("plr") clearKind("down") end
end)
PT(P12, "Alerta de distancia", "Barra con el bot más cercano", "ev_alert", function(v) hudOn = v end)
local tRadar = PT(P12, "Radar", "Mapa circular con bots y jugadores", "ev_radar", function(v)
radarOn = v
if v and next(cands) == nil then initialScan() end
end)
InputRow(P12, "Nombre extra de bot (ej: bot, npc)", "Añadir", function(txt)
local n = tostring(txt or ""):lower():gsub("^%s+", ""):gsub("%s+$", "")
if n == "" then toast("Escribe un nombre") return end
botNames[#botNames + 1] = n
initialScan()
toast("Buscando modelos con «" .. n .. "»")
end)
Button(P12, "Volver a escanear bots", T.text, function() initialScan() toast("Listo") end)
Section(P12, "Supervivencia")
EV.escDist, EV.dodgeDist, EV.dodgeForce = 45, 40, 8
Button(P12, "Guardar punto seguro aquí", T.accent, function()
local r = getRoot()
if r then safeCF = r.CFrame toast("Punto seguro guardado") end
end)
PS(P12, "Distancia de escape", 15, 120, 5, "ev_escdist", 45, "", function(v) EV.escDist = v end)
local tEsc = PT(P12, "Escapar al punto seguro", "Te lleva allí si un bot se acerca", "ev_escape", function(v)
EV.escape = v
if v and next(cands) == nil then initialScan() end
if v and not safeCF then toast("Guarda un punto seguro primero") end
end)
PS(P12, "Distancia de esquiva", 10, 100, 5, "ev_dodgedist", 40, "", function(v) EV.dodgeDist = v end)
PS(P12, "Fuerza de esquiva", 2, 20, 1, "ev_dodgeforce", 8, "", function(v) EV.dodgeForce = v end)
local tDodge = PT(P12, "Esquiva automática", "Salta y se aleja del bot cercano", "ev_dodge", function(v)
EV.dodge = v
if v and next(cands) == nil then initialScan() end
end)
local reviveOn, reviveBack, reviveCd = false, true, 0
local function nearestDowned()
local root = getRoot()
if not root then return nil end
local best, bd
for _, pl in ipairs(Players:GetPlayers()) do
local ch = pl.Character
local r = ch and ch:FindFirstChild("HumanoidRootPart")
if pl ~= lp and r and ch:GetAttribute("Downed") == true then
local d = (r.Position - root.Position).Magnitude
if not bd or d < bd then best, bd = pl, d end
end
end
return best, bd
end
local function doRevive()
local pl = nearestDowned()
local root = getRoot()
if not (pl and root) then return false end
local tr = pl.Character:FindFirstChild("HumanoidRootPart")
for model in pairs(cands) do
local p = model.PrimaryPart or model:FindFirstChild("HumanoidRootPart")
if p and (p.Position - tr.Position).Magnitude < 35 then return false, "hay un bot cerca" end
end
local back = root.CFrame
root.CFrame = tr.CFrame * CFrame.new(0, 0, 3)
task.wait(0.25)
local fired = false
if fireproximityprompt then
for _, d in ipairs(pl.Character:GetDescendants()) do
if d:IsA("ProximityPrompt") then
local ok = pcall(fireproximityprompt, d)
fired = fired or ok
end
end
end
if not fired then H.keyTap(Enum.KeyCode.E, 2.4) end
task.wait(fired and 1.6 or 2.6)
if reviveBack then
local r2 = getRoot()
if r2 then r2.CFrame = back end
end
return true
end
local reviveAcc = 0
track(RunService.Heartbeat:Connect(function(dt)
if not reviveOn then return end
reviveAcc = reviveAcc + (tonumber(dt) or 0)
if reviveAcc < 1 then return end
reviveAcc = 0
if reviveCd > os.clock() then return end
reviveCd = os.clock() + 6
task.spawn(function() pcall(doRevive) end)
end))
local tRev = PT(P12, "Auto revivir", "Va al compañero caído más cercano y lo ayuda", "ev_revive", function(v) reviveOn = v end)
PT(P12, "Volver después de revivir", nil, "ev_reviveback", function(v) reviveBack = v end)
Button(P12, "Revivir ahora", T.accent, function()
task.spawn(function()
local ok, why = pcall(doRevive)
if not nearestDowned() then toast("Nadie caído") end
end)
end)
Button(P12, "Ir al compañero caído", T.text, function()
local pl = nearestDowned()
local root = getRoot()
local r = pl and pl.Character and pl.Character:FindFirstChild("HumanoidRootPart")
if r and root then root.CFrame = r.CFrame * CFrame.new(0, 0, 3) else toast("Nadie caído") end
end)
Section(P12, "Hitbox")
Note(P12, "El objeto no cambia de tamaño. Se crea un cubo invisible más grande que sí te engancha, y puedes verlo como un cuadro.")
local HB = { on = {}, mult = 15, axis = 1, ghost = false, show = false, solid = true, custom = "" }
local HBK = {
{ "Carros", { "car", "truck", "bus", "taxi", "vehicle" } },
{ "Postes", { "pole", "post", "lamp", "pillar" } },
{ "Letreros", { "sign", "billboard", "banner" } },
{ "Vallas", { "fence", "gate", "rail", "barrier" } },
{ "Cactus", { "cactus", "cacti" } },
{ "Árboles y troncos", { "tree", "log", "trunk", "palm" } },
{ "Rampas y escaleras", { "ramp", "stair", "slope" } },
}
local hbFolder = new("Folder", { Name = "XC_Hitboxes" }, Workspace)
local hbStore, hbTk = {}, 0
local function hbWords()
local w = {}
for i, c in ipairs(HBK) do
if HB.on[i] then for _, k in ipairs(c[2]) do w[#w + 1] = k end end
end
if HB.custom ~= "" then w[#w + 1] = HB.custom end
return w
end
local function hbMatch(p, words)
local node, depth = p, 0
while node and node ~= Workspace and depth < 4 do
local n = node.Name:lower()
for _, k in ipairs(words) do
if n:find(k, 1, true) then return true end
end
node = node.Parent
depth = depth + 1
end
return false
end
local function hbRestore(p)
local o = hbStore[p]
if o then
if o.box then pcall(function() o.box:Destroy() end) end
if o.sel then pcall(function() o.sel:Destroy() end) end
pcall(function() p.CanCollide = o.cc end)
hbStore[p] = nil
end
end
local function hbSize(sz)
local m = HB.mult / 10
if HB.axis == 2 then return Vector3.new(sz.X * m, sz.Y, sz.Z * m) end
if HB.axis == 3 then return Vector3.new(sz.X, sz.Y * m, sz.Z) end
return sz * m
end
local hbCount = 0
local function hbApply(p, words)
if not (p:IsA("BasePart") and not p:IsA("Terrain") and p.Anchored) then return end
if p:IsDescendantOf(hbFolder) then return end
local par = p.Parent
if par and par:FindFirstChildOfClass("Humanoid") then return end
local want = hbMatch(p, words)
local o = hbStore[p]
if want then
if not o then
if hbCount > 600 then return end
o = { size = p.Size, cc = p.CanCollide }
hbStore[p] = o
end
if not (o.box and o.box.Parent) then
o.box = new("Part", {
Name = "XC_Hit", Anchored = true, CanQuery = true, CanTouch = true, CastShadow = false, Transparency = 1,
Material = Enum.Material.SmoothPlastic,
}, hbFolder)
end
o.box.Size = hbSize(o.size)
o.box.CFrame = p.CFrame
o.box.CanCollide = HB.solid and not HB.ghost
p.CanCollide = (not HB.ghost) and o.cc
if HB.show then
if not (o.sel and o.sel.Parent) then
o.sel = new("SelectionBox", {
Adornee = o.box, LineThickness = 0.045, Color3 = T.accent, SurfaceColor3 = T.accent, SurfaceTransparency = 0.88,
}, hbFolder)
end
o.sel.Color3 = T.accent
elseif o.sel then
o.sel:Destroy()
o.sel = nil
end
elseif o then
hbRestore(p)
end
end
local function hbRun()
hbTk = hbTk + 1
local tk = hbTk
local words = hbWords()
task.spawn(function()
if #words == 0 then
for p in pairs(hbStore) do hbRestore(p) end
return
end
local n = 0
for _, p in ipairs(Workspace:GetDescendants()) do
if tk ~= hbTk then return end
pcall(hbApply, p, words)
n = n + 1
if n % 400 == 0 then task.wait() end
end
hbCount = 0
for p in pairs(hbStore) do
if not p.Parent then hbRestore(p) else hbCount = hbCount + 1 end
end
end)
end
track(Workspace.DescendantAdded:Connect(function(p)
if p:IsA("BasePart") and #hbWords() > 0 then
task.defer(function() pcall(hbApply, p, hbWords()) end)
end
end))
for i, c in ipairs(HBK) do
PT(P12, c[1], nil, "hb_" .. i, function(v) HB.on[i] = v hbRun() end)
end
InputRow(P12, "Palabra personalizada (nombre del objeto)", "Añadir", function(txt)
HB.custom = tostring(txt or ""):lower():gsub("^%s+", ""):gsub("%s+$", "")
hbRun()
toast(HB.custom ~= "" and ("Hitbox: " .. HB.custom) or "Sin palabra")
end)
PS(P12, "Tamaño del cubo (10 = igual al objeto)", 5, 60, 1, "hb_mult", 15, "", function(v) HB.mult = v hbRun() end)
Note(P12, "Ejes")
Chips(P12, { "Todos", "Horizontal", "Vertical" }, 96, function(i) HB.axis = i hbRun() end, 1)
PT(P12, "Ver los cubos", "Muestra cada hitbox como un cuadro", "hb_show", function(v) HB.show = v hbRun() end)
PT(P12, "Cubo sólido", "Si lo apagas solo detecta el contacto", "hb_solid", function(v) HB.solid = v or false hbRun() end)
PT(P12, "Atravesar el objeto original", "Quita la colisión del objeto y del cubo", "hb_ghost", function(v) HB.ghost = v hbRun() end)
Button(P12, "Restaurar objetos", T.red, function()
HB.on = {}
HB.custom = ""
for p in pairs(hbStore) do hbRestore(p) end
toast("Objetos restaurados")
end)
local botScale, plrScale = 10, 10
local entStore = setmetatable({}, { __mode = "k" })
local function entApply(root, scale, ghostTr)
if not (root and root:IsA("BasePart")) then return end
local o = entStore[root]
if not o then
o = { size = root.Size, cc = root.CanCollide, tr = root.Transparency }
entStore[root] = o
end
root.Size = o.size * (scale / 10)
if scale ~= 10 then
root.CanCollide = false
root.Transparency = ghostTr
else
root.CanCollide, root.Transparency = o.cc, o.tr
end
end
local entAcc = 0
track(RunService.Heartbeat:Connect(function(dt)
entAcc = entAcc + (tonumber(dt) or 0)
if entAcc < 0.4 then return end
entAcc = 0
if botScale ~= 10 or next(entStore) ~= nil then
for model in pairs(cands) do
local r = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
if r then pcall(entApply, r, botScale, 0.85) end
end
end
if plrScale ~= 10 or next(entStore) ~= nil then
for _, pl in ipairs(Players:GetPlayers()) do
local r = pl ~= lp and pl.Character and pl.Character:FindFirstChild("HumanoidRootPart")
if r then pcall(entApply, r, plrScale, 0.8) end
end
end
end))
PS(P12, "Hitbox de bots (10 = normal)", 2, 40, 1, "hb_bots", 10, "", function(v)
botScale = v
if v ~= 10 and next(cands) == nil then initialScan() end
end)
PS(P12, "Hitbox de jugadores (10 = normal)", 5, 40, 1, "hb_plr", 10, "", function(v) plrScale = v end)
Section(P12, "Lag switch")
Note(P12, "Congela lo que envías al servidor: los demás te ven quieto o a saltos. El método FFlag depende de tu executor.")
local LAG = { on = false, method = 0, level = 1, auto = 0, key = "Ninguna", hold = false, token = 0 }
local LAGLV = { 1, 3, 6 }
local lagFlagOrig = "15"
local function lagApply(on)
LAG.on = on
LAG.token = LAG.token + 1
local tk = LAG.token
if on then
local usedFlag = false
if LAG.method ~= 2 and setfflag then
usedFlag = pcall(setfflag, "DFIntS2PhysicsSenderRate", tostring(LAGLV[LAG.level] or 1))
end
if not usedFlag then
pcall(function() settings().Network.IncomingReplicationLag = LAG.level * 0.8 end)
end
if LAG.auto > 0 then
task.delay(LAG.auto, function()
if LAG.on and LAG.token == tk then
if H.lagObj then H.lagObj.Set(false) else lagApply(false) end
end
end)
end
else
if setfflag then pcall(setfflag, "DFIntS2PhysicsSenderRate", lagFlagOrig) end
pcall(function() settings().Network.IncomingReplicationLag = 0 end)
end
end
local tLag = Toggle(P12, "Lag switch", "No se guarda entre sesiones", false, function(v) lagApply(v) end)
H.lagObj = tLag
Note(P12, "Método")
Chips(P12, { "Automático", "Solo FFlag", "Solo replicación" }, 110, function(i)
LAG.method = (i == 1) and 0 or ((i == 2) and 1 or 2)
if LAG.on then lagApply(true) end
end, 1)
Note(P12, "Intensidad")
Chips(P12, { "Suave", "Media", "Fuerte" }, 90, function(i)
LAG.level = i
if LAG.on then lagApply(true) end
end, 1)
PS(P12, "Apagar solo tras (s, 0 = manual)", 0, 30, 1, "ev_lagauto", 0, "", function(v) LAG.auto = v end)
Note(P12, "Tecla (PC)")
Chips(P12, { "Ninguna", "L", "Z", "Y", "V" }, 70, function(i, name) LAG.key = name end, 1)
Toggle(P12, "Solo mientras mantengo la tecla", nil, false, function(v) LAG.hold = v end)
track(UIS.InputBegan:Connect(function(input, gp)
if gp or LAG.key == "Ninguna" then return end
if input.KeyCode == Enum.KeyCode[LAG.key] then
if LAG.hold then tLag.Set(true) else tLag.Set(not tLag.state) end
end
end))
track(UIS.InputEnded:Connect(function(input)
if LAG.hold and LAG.key ~= "Ninguna" and input.KeyCode == Enum.KeyCode[LAG.key] then tLag.Set(false) end
end))
Section(P12, "Botones en pantalla")
Note(P12, "Toca para activar o desactivar. Arrástralos donde quieras y bloquéalos cuando te gusten.")
local pillsOn, pillsLock = true, false
local pills, pillList = {}, {}
local function pillVisible(p) return pillsOn and Sess.ev["pv_" .. p.name] ~= false end
local function pill(text, get, set)
local idx = #pills + 1
local col, row = (idx - 1) % 4, math.floor((idx - 1) / 4)
local b = new("Frame", {
Name = "XC_Pill", Size = UDim2.fromOffset(112, 30), BackgroundColor3 = Color3.fromRGB(14, 14, 16), BackgroundTransparency = 0.22,
BorderSizePixel = 0, Visible = false,
}, gui)
corner(b, 15)
local st = new("UIStroke", { Thickness = 1, Color = Color3.new(1, 1, 1), Transparency = 0.75 }, b)
label(b, {
Position = UDim2.fromOffset(12, 0), Size = UDim2.new(1, -52, 1, 0), Text = text, TextSize = 11, Font = Enum.Font.GothamMedium,
TextColor3 = Color3.fromRGB(235, 235, 240),
})
local stateL = label(b, {
AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -10, 0, 0), Size = UDim2.fromOffset(34, 30), Text = "OFF", TextSize = 10,
Font = Enum.Font.GothamBold, TextColor3 = Color3.fromRGB(140, 140, 148), TextXAlignment = Enum.TextXAlignment.Right,
})
local rec = { name = text, frame = b }
H.drag(b, "pill_" .. text, function() return pillsLock end, function() set(not get()) end,
UDim2.new(0.5, (col - 1.5) * 118 - 56, 1, -(86 + row * 38)))
rec.update = function()
local on = get()
stateL.Text = on and "ON" or "OFF"
stateL.TextColor3 = on and T.green or Color3.fromRGB(140, 140, 148)
st.Color = on and T.green or Color3.new(1, 1, 1)
st.Transparency = on and 0.1 or 0.75
b.Visible = pillVisible(rec)
end
rec.default = UDim2.new(0.5, (col - 1.5) * 118 - 56, 1, -(86 + row * 38))
pills[idx] = rec
return rec
end
local function viaObj(obj) return function() return obj.state end, function(v) obj.Set(v) end end
do
local g, st = viaObj(tHop) pill("Auto salto", g, st)
g, st = viaObj(tStrafe) pill("Air strafe", g, st)
end
local lastCrouch = 2
pill("Agacharse", function() return EV.crouchMode > 1 end, function(v)
local m = v and lastCrouch or 1
if EV.crouchMode > 1 then lastCrouch = EV.crouchMode end
EV.crouchMode = m
Sess.ev.ev_crouch = m
SessSave()
pcall(function() crouchChips.Set(m, true) end)
end)
pill("Spam agacharse", function() return spam.on end, function(v) tSpam.Set(v) end)
do
local g, st = viaObj(tLag) pill("Lag switch", g, st)
g, st = viaObj(tBot) pill("ESP bots", g, st)
g, st = viaObj(tRadar) pill("Radar", g, st)
g, st = viaObj(tEsc) pill("Escape", g, st)
g, st = viaObj(tDodge) pill("Esquiva", g, st)
g, st = viaObj(tRev) pill("Revivir", g, st)
end
local pillAcc = 0
track(RunService.Heartbeat:Connect(function(dt)
pillAcc = pillAcc + (tonumber(dt) or 0)
if pillAcc < 0.1 then return end
pillAcc = 0
for _, p in ipairs(pills) do p.update() end
end))
local tPills = PT(P12, "Mostrar botones en pantalla", "Interruptor general", "ev_pills", function(v) pillsOn = v end)
if Sess.ev.ev_pills == nil then tPills.Set(true) end
PT(P12, "Bloquear posición de los botones", nil, "ev_pilllock", function(v) pillsLock = v end)
Note(P12, "Cuáles quieres ver")
for _, p in ipairs(pills) do
local key = "pv_" .. p.name
Toggle(P12, p.name, nil, Sess.ev[key] ~= false, function(v)
Sess.ev[key] = v
SessSave()
end)
end
Button(P12, "Restablecer posiciones", T.text, function()
H.resetPos("pill_")
for _, p in ipairs(pills) do p.frame.Position = p.default end
end)
H.attrEditor(P12)
Section(P12, "Herramientas")
local function dumpTree(inst, depth, maxDepth, lines, prefix)
if depth > maxDepth then return end
local kids = inst:GetChildren()
for i, k in ipairs(kids) do
if i > 25 then lines[#lines + 1] = prefix .. "… (+" .. (#kids - 25) .. " más)" break end
lines[#lines + 1] = prefix .. k.Name .. " [" .. k.ClassName .. "]"
dumpTree(k, depth + 1, maxDepth, lines, prefix .. "  ")
end
end
Button(P12, "Copiar información del juego", T.accent, function()
local lines = { "PlaceId: " .. tostring(game.PlaceId), "Nombre: " .. tostring(GAME.name) }
local ch = lp.Character
if ch then for k, v in pairs(ch:GetAttributes()) do lines[#lines + 1] = "Atributo personaje: " .. tostring(k) .. " = " .. tostring(v) end end
for k, v in pairs(lp:GetAttributes()) do lines[#lines + 1] = "Atributo jugador: " .. tostring(k) .. " = " .. tostring(v) end
lines[#lines + 1] = "--- Workspace ---"
dumpTree(Workspace, 1, 3, lines, "")
	local text = table.concat(lines, "\n"):sub(1, 18000)
local cp = setclipboard or toclipboard or set_clipboard
if cp then pcall(cp, text) toast("Copiado (" .. #lines .. " líneas)") else warn(text) toast("Sin portapapeles, mira la consola") end
end)
table.insert(env.DG_Cleanups or {}, function()
pcall(multRestore)
for p in pairs(hbStore) do pcall(hbRestore, p) end
pcall(function() hbFolder:Destroy() end)
pcall(function() setCrouch(false) end)
pcall(lagApply, false)
for model in pairs(marks) do pcall(unmark, model) end
for r, o in pairs(entStore) do pcall(function() r.Size, r.CanCollide, r.Transparency = o.size, o.cc, o.tr end) end
pcall(function() alertF:Destroy() radar:Destroy() end)
for _, p in ipairs(pills) do pcall(function() p.frame:Destroy() end) end
end)
end)
if not okP then DG_Fail("Pestaña Evade", eP) end
end
end
track(UIS.InputBegan:Connect(function(input, gp)
if gp then return end
if input.KeyCode == Enum.KeyCode.RightShift then toggleWindow() end
end))
local cam = Workspace.CurrentCamera
if cam then
track(cam:GetPropertyChangedSignal("ViewportSize"):Connect(updateFit))
end
track(gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(updateFit))
updateFit()
env.DG_Loader = function(opts)
opts = opts or {}
local Stats = game:GetService("Stats")
local root = new("CanvasGroup", {
Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(9, 9, 11), BorderSizePixel = 0, ZIndex = 300,
GroupTransparency = 1, Active = true,
}, gui)
local W, G, Dk = Color3.fromRGB(244, 244, 246), Color3.fromRGB(128, 128, 136), Color3.fromRGB(52, 52, 58)
local con, finished, called
local function kill()
if con then pcall(function() con:Disconnect() end) con = nil end
pcall(function() root:Destroy() end)
end
env.DG_Cleanups = env.DG_Cleanups or {}
table.insert(env.DG_Cleanups, kill)
local function box(par, ax, ay, px, py, sx, sy, col, tr, z)
return new("Frame", {
AnchorPoint = Vector2.new(ax, ay), Position = px, Size = sx, BackgroundColor3 = col or W,
BackgroundTransparency = tr or 0, BorderSizePixel = 0, ZIndex = z or 301,
}, par)
end
local function txt(par, props)
props.TextTruncate = Enum.TextTruncate.None
props.ZIndex = props.ZIndex or 303
return label(par, props)
end
for i = 1, 7 do
for j = 1, 4 do
local cx, cy = UDim2.new(i / 8, 0, j / 5, 0), nil
box(root, 0.5, 0.5, cx, cy and cx or UDim2.new(i / 8, 0, j / 5, 0), UDim2.fromOffset(9, 1), nil, W, 0.93, 301)
box(root, 0.5, 0.5, UDim2.new(i / 8, 0, j / 5, 0), nil, UDim2.fromOffset(1, 9), nil, W, 0.93, 301)
end
end
for _, c in ipairs({ { 0, 0 }, { 1, 0 }, { 0, 1 }, { 1, 1 } }) do
local ax, ay = c[1], c[2]
local pos = UDim2.new(ax, ax == 0 and 24 or -24, ay, ay == 0 and 24 or -24)
box(root, ax, ay, pos, nil, UDim2.fromOffset(18, 1), nil, G, 0.4)
box(root, ax, ay, pos, nil, UDim2.fromOffset(1, 18), nil, G, 0.4)
end
local center = new("Frame", {
AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.5, 0), Size = UDim2.fromOffset(2, 2),
BackgroundTransparency = 1, ZIndex = 301,
}, root)
local orbits = {}
for i, r in ipairs({ 150, 215, 290 }) do
local ring = new("Frame", {
AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(r * 2, r * 2),
BackgroundTransparency = 1, ZIndex = 301,
}, center)
circle(ring)
new("UIStroke", { Thickness = 1, Color = W, Transparency = 0.93 + i * 0.01 }, ring)
local dot = box(center, 0.5, 0.5, UDim2.fromOffset(0, 0), nil, UDim2.fromOffset(i == 2 and 5 or 3, i == 2 and 5 or 3), nil, W, 0.25 + i * 0.1, 302)
circle(dot)
orbits[i] = { dot = dot, r = r, sp = (i == 2 and -0.35 or 0.28) / i, ph = i * 1.7 }
end
local colW = 260
local col = new("Frame", {
AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(colW, 150),
BackgroundTransparency = 1, ZIndex = 302,
}, root)
local mark = txt(col, {
AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 0), Size = UDim2.new(1, 0, 0, 30),
Text = "X  C  R  E  E  T", Font = Enum.Font.GothamMedium, TextSize = 21, TextColor3 = W,
TextXAlignment = Enum.TextXAlignment.Center, TextTransparency = 1,
})
local stage = txt(col, {
Position = UDim2.fromOffset(0, 44), Size = UDim2.new(1, -50, 0, 14), Text = "Iniciando", Font = Enum.Font.Gotham,
TextSize = 10, TextColor3 = G,
})
local pct = txt(col, {
AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 44), Size = UDim2.fromOffset(50, 14), Text = "000",
Font = Enum.Font.Code, TextSize = 10, TextColor3 = W, TextXAlignment = Enum.TextXAlignment.Right,
})
local lineBg = box(col, 0, 0, UDim2.fromOffset(0, 64), nil, UDim2.new(1, 0, 0, 1), nil, Dk, 0, 302)
local fill = box(lineBg, 0, 0, UDim2.fromOffset(0, 0), nil, UDim2.new(0, 0, 1, 0), nil, W, 0, 303)
local glow = box(fill, 1, 0.5, UDim2.new(1, 0, 0.5, 0), nil, UDim2.fromOffset(44, 3), nil, W, 0, 303)
new("UIGradient", { Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 0.1) }) }, glow)
local TICKS = 53
local ticks = {}
for i = 1, TICKS do
local h = (i % 5 == 1) and 6 or 3
ticks[i] = box(col, 0, 0, UDim2.new((i - 1) / (TICKS - 1), (i == TICKS) and -1 or 0, 0, 70), nil, UDim2.fromOffset(1, h), nil, Dk, 0, 302)
end
local labels, values = { "FPS", "PING", "MEMORIA", "JUGADORES" }, {}
for i, l in ipairs(labels) do
local x = (i - 1) / 4
txt(col, { Position = UDim2.new(x, 0, 0, 92), Size = UDim2.new(0.25, 0, 0, 12), Text = l, Font = Enum.Font.Gotham, TextSize = 8, TextColor3 = G })
values[i] = txt(col, { Position = UDim2.new(x, 0, 0, 104), Size = UDim2.new(0.25, 0, 0, 16), Text = "--", Font = Enum.Font.Code, TextSize = 13, TextColor3 = W })
end
txt(col, { Position = UDim2.fromOffset(0, 132), Size = UDim2.new(0.5, 0, 0, 12), Text = "RENDIMIENTO", Font = Enum.Font.Gotham, TextSize = 8, TextColor3 = G })
local qual = txt(col, {
AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 131), Size = UDim2.new(0.5, 0, 0, 14), Text = "midiendo",
Font = Enum.Font.GothamMedium, TextSize = 10, TextColor3 = W, TextXAlignment = Enum.TextXAlignment.Right,
})
local meter = {}
for i = 1, 5 do
meter[i] = box(col, 0, 0, UDim2.new((i - 1) / 5, 0, 0, 148), nil, UDim2.new(0.2, -3, 0, 2), nil, Dk, 0, 302)
end
local LP = { text = "Iniciando", prog = 0, done = false }
local function rep2(t, f)
LP.text = t
if f and f > LP.prog then LP.prog = f end
end
if opts.work then
task.spawn(function()
local ok, e = pcall(opts.work, rep2)
if not ok then warn("[Xcreet] carga: " .. tostring(e)) end
LP.prog = 1
LP.done = true
end)
else
LP.prog, LP.done, LP.text = 1, true, "Vista previa"
end
local t0 = os.clock()
local fpsS, sampled, fpsSum, fpsN = 60, false, 0, 0
local pingNow, minTime, score = 0, 2.6, 1
local shown, acc, called2 = 0, 0, false
tween(root, 0.45, { GroupTransparency = 0.02 })
local function readPing()
local ok, v = pcall(function() return Stats.Network.ServerStatsItem["Data Ping"]:GetValue() end)
return (ok and type(v) == "number") and v or 0
end
local function readMem()
local ok, v = pcall(function() return Stats:GetTotalMemoryUsageMb() end)
return (ok and type(v) == "number") and v or 0
end
con = RunService.RenderStepped:Connect(function(dt)
dt = (type(dt) == "number" and dt > 0) and dt or 0.016
local el = os.clock() - t0
fpsS = fpsS + ((1 / dt) - fpsS) * math.min(1, dt * 4)
if el > 0.3 and el <= 1.4 then fpsSum, fpsN = fpsSum + 1 / dt, fpsN + 1 end
acc = acc + dt
if acc >= 0.2 then
acc = 0
pingNow = readPing()
values[1].Text = tostring(math.floor(fpsS + 0.5))
values[2].Text = (pingNow > 0) and (tostring(math.floor(pingNow + 0.5)) .. " ms") or "--"
values[3].Text = string.format("%d MB", math.floor(readMem()))
values[4].Text = tostring(#Players:GetPlayers())
end
if not sampled and el > 1.4 then
sampled = true
local f = (fpsN > 0) and (fpsSum / fpsN) or fpsS
local fs = math.clamp(f / 60, 0, 1)
local ps = (pingNow > 0) and math.clamp(1 - (pingNow - 60) / 340, 0, 1) or 1
score = fs * 0.6 + ps * 0.4
minTime = 2.6 + (1 - score) * 4.4
local word = (score >= 0.8 and "Óptimo") or (score >= 0.55 and "Estable") or (score >= 0.3 and "Limitado") or "Crítico"
qual.Text = word
for i = 1, 5 do
meter[i].BackgroundColor3 = (score * 5 > i - 0.5) and W or Dk
end
end
if opts.work == nil then minTime = 3.2 end
local timeProg = math.clamp(el / minTime, 0, 1)
local target = math.min(LP.prog, timeProg)
if sampled == false then target = math.min(target, 0.35) end
shown = math.max(shown, shown + (target - shown) * (1 - math.exp(-dt * 5)))
local s = math.clamp(shown, 0, 1)
mark.TextTransparency = 1 - math.clamp(el / 0.8, 0, 1)
fill.Size = UDim2.new(s, 0, 1, 0)
pct.Text = string.format("%03d", math.floor(s * 100 + 0.5))
stage.Text = LP.text
local on = math.floor(s * TICKS + 0.5)
local sweep = (el * 18) % (TICKS + 8)
for i, tk in ipairs(ticks) do
if i <= on then
tk.BackgroundColor3 = W
else
local d = math.abs(i - sweep)
tk.BackgroundColor3 = (d < 2.5) and G or Dk
end
end
for _, o in ipairs(orbits) do
local a = el * o.sp * 2 + o.ph
o.dot.Position = UDim2.fromOffset(math.cos(a) * o.r, math.sin(a) * o.r)
end
local ready = LP.done and shown >= 0.992 and el >= minTime
if (ready or el > 20) and not finished then
finished = true
if not called2 then
called2 = true
if opts.onDone then pcall(opts.onDone) end
end
tween(root, 0.6, { GroupTransparency = 1 })
task.delay(0.7, kill)
if con then pcall(function() con:Disconnect() end) con = nil end
end
end)
task.delay(60, function()
if not finished then
finished = true
if not called2 and opts.onDone then called2 = true pcall(opts.onDone) end
kill()
end
end)
end
applyStyle()
selectTab(1)
task.delay(0.5, function() setMode("pill") end)
local BOOT_FILE = "Xcreet_boot.flag"
local function bootFlag(v) pcall(function() if writefile then writefile(BOOT_FILE, v) end end) end
env.XC_SAFE = false
pcall(function()
if isfile and readfile and isfile(BOOT_FILE) and readfile(BOOT_FILE) == "1" then env.XC_SAFE = true end
end)
local function bootWork(rep2)
bootFlag("1")
rep2("Interfaz", 0.1)
if lp.Character then onChar(lp.Character) end
rep2("Personaje", 0.25)
restoreSession(function(t, f) rep2(t, 0.25 + 0.45 * f) end)
bootFlag("0")
rep2("Animaciones", 0.75)
pcall(function() if env.XC_H.anim then env.XC_H.anim() end end)
rep2("Gráficos", 0.85)
pcall(function() if env.XC_H.gfx then env.XC_H.gfx() end end)
rep2("Ajustes", 0.94)
pcall(function() if env.XC_H.ev then env.XC_H.ev() end end)
rep2("Listo", 1)
sessReady = true
end
if Style.loadAnim == false then
panelShow(win)
task.spawn(function()
pcall(bootWork, function() end)
sessReady = true
end)
else
env.DG_Loader({ work = bootWork, onDone = function() panelShow(win) end })
end
end, function(e) return debug.traceback(tostring(e), 2) end)
if not DG_OK then DG_Fail("inicio", DG_ERR) end
