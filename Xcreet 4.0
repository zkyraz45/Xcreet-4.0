local SIdx, sectionOf = {}, {}
local function idxAdd(page, title, desc, obj, kind)
if type(title) ~= "string" or #title < 2 or title:match("^%d+$") then return end
SIdx[#SIdx + 1] = { t = title, d = desc, page = page, obj = obj, sec = sectionOf[page], kind = kind or "item" }
end
do
local ACC = {
["á"] = "a", ["é"] = "e", ["í"] = "i", ["ó"] = "o", ["ú"] = "u", ["ü"] = "u", ["ñ"] = "n",
["Á"] = "a", ["É"] = "e", ["Í"] = "i", ["Ó"] = "o", ["Ú"] = "u", ["Ñ"] = "n",
}
local ALIAS = {
volar = { "fly", "vuelo" }, vuelo = { "fly" }, fly = { "volar", "vuelo" }, velocidad = { "speed", "correr" }, speed = { "velocidad" },
saltar = { "salto", "jump" }, salto = { "jump" }, jump = { "salto" }, atravesar = { "noclip" }, pared = { "noclip", "rayos" },
wallhack = { "rayos", "resaltados", "esp" }, esp = { "resaltados", "rayos", "jugadores" }, apuntar = { "aim", "aimbot" },
punteria = { "aim", "aimbot" }, aimbot = { "aim", "apuntar" }, disparar = { "trigger" },
color = { "tema", "acento", "estilo" }, tema = { "estilo", "color" }, fondo = { "imagen", "wallpaper" },
fps = { "rendimiento", "contador", "booster" }, rendimiento = { "fps", "booster" }, lag = { "latencia", "ping" },
teclado = { "keyboard", "teclas" }, keyboard = { "teclado" }, ropa = { "camisa", "pantalon", "catalogo" }, skin = { "avatar", "copiar" },
skins = { "avatar", "copiar", "avatares" }, avatar = { "skin", "copiar" }, bailar = { "emote", "animacion" }, baile = { "emote" },
emotes = { "rueda", "animaciones" }, rueda = { "emotes" }, graficos = { "sombras", "shader", "luz" }, sombras = { "graficos" },
stream = { "streaming", "ocultar" }, streaming = { "stream" }, ocultar = { "stream", "esconder" }, esconder = { "ocultar" },
hitbox = { "cubos", "hitboxes" }, cubos = { "hitbox" }, escapar = { "evade", "supervivencia" }, botones = { "pantalla" },
guardar = { "sesion", "restaurar" }, sesion = { "guardar", "restaurar" }, stickers = { "decorar", "pegatinas" },
pegatinas = { "decorar", "stickers" }, musica = { "audio", "sonido" }, camara = { "zoom", "vista" }, zoom = { "camara" },
}
local function norm(x)
x = tostring(x or ""):lower()
for a, b in pairs(ACC) do x = x:gsub(a, b) end
x = x:gsub("[^%w%s]", " "):gsub("%s+", " "):gsub("^ ", ""):gsub(" $", "")
return x
end
local function lev(a, b, cap)
local la, lb = #a, #b
if math.abs(la - lb) > cap then return cap + 1 end
local prev = {}
for j = 0, lb do prev[j] = j end
for i = 1, la do
local cur = { [0] = i }
local mn = i
for j = 1, lb do
local c = (a:byte(i) == b:byte(j)) and 0 or 1
local v = math.min(prev[j] + 1, cur[j - 1] + 1, prev[j - 1] + c)
cur[j] = v
if v < mn then mn = v end
end
if mn > cap then return cap + 1 end
prev = cur
end
return prev[lb]
end
local M = {}
function M.prep(q)
local n = norm(q)
local toks, ex = {}, {}
for w in n:gmatch("%S+") do toks[#toks + 1] = w end
for _, w in ipairs(toks) do
for _, a in ipairs(ALIAS[w] or {}) do ex[#ex + 1] = norm(a) end
end
return { full = table.concat(toks, " "), toks = toks, ex = ex }
end
function M.score(text, P)
if not text or text == "" or #P.toks == 0 then return 0 end
local t = norm(text)
if t == "" then return 0 end
local best = 0
if t == P.full then best = 1000
elseif t:sub(1, #P.full) == P.full then best = 800
elseif (" " .. t):find(" " .. P.full, 1, true) then best = 650
elseif t:find(P.full, 1, true) then best = 450 end
local words = {}
for w in t:gmatch("%S+") do words[#words + 1] = w end
local sum, hit = 0, 0
for _, tok in ipairs(P.toks) do
local b = 0
for _, w in ipairs(words) do
local v = 0
if w == tok then v = 120
elseif w:sub(1, #tok) == tok then v = 95
elseif #tok >= 3 and w:find(tok, 1, true) then v = 60
elseif #tok >= 4 then
local cap = (#tok >= 7) and 2 or 1
local d = lev(w, tok, cap)
if d <= cap then v = 75 - 25 * d end
end
if v > b then b = v end
end
if b > 0 then hit = hit + 1 end
sum = sum + b
end
local tokScore = (sum / #P.toks) * (hit / #P.toks)
local ax = 0
for _, a in ipairs(P.ex) do
if a ~= "" and t:find(a, 1, true) then ax = 55 break end
end
local sc = math.max(best, tokScore, ax)
if sc > 0 then sc = sc - math.min(#t, 80) * 0.15 end
return sc
end
env.XC_M = M
