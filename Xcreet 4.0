report(ok and "Script ejecutado" or ("Error: " .. tostring(e2):sub(1, 80)))
end)
Note(P10, "Notas rápidas (se guardan solas)")
local NOTES_FILE = "DeltaGlass_notes.txt"
local notesRow = Row(P10, 100)
local notes = new("TextBox", {
Position = UDim2.fromOffset(8, 8), Size = UDim2.new(1, -16, 1, -16), BackgroundTransparency = 1, Text = "",
PlaceholderText = "Escribe aquí…", PlaceholderColor3 = T.sub, TextColor3 = T.text, Font = Enum.Font.Gotham,
TextSize = 12, TextWrapped = true, MultiLine = true, ClearTextOnFocus = false,
TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top,
}, notesRow)
if isfile and readfile then
pcall(function() if isfile(NOTES_FILE) then notes.Text = readfile(NOTES_FILE) end end)
end
track(notes.FocusLost:Connect(function()
if writefile then pcall(function() writefile(NOTES_FILE, notes.Text) end) end
