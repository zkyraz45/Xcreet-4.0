local function tabOf(obj)
local p = obj
while p do
for i, pg in ipairs(pages) do
if pg == p then return i end
end
p = p.Parent
end
return nil
end
local function flash(obj)
pcall(function()
local f = new("Frame", {
Size = UDim2.fromScale(1, 1), BackgroundColor3 = T.accent, BackgroundTransparency = 0.55, BorderSizePixel = 0,
ZIndex = (obj.ZIndex or 1) + 10,
}, obj)
corner(f, 12)
tween(f, 1.4, { BackgroundTransparency = 1 })
task.delay(1.5, function() f:Destroy() end)
end)
end
local function scrollTo(tab, obj)
pcall(function()
local pg = pages[tab]
local y = obj.AbsolutePosition.Y - pg.AbsolutePosition.Y + pg.CanvasPosition.Y - 8
pg.CanvasPosition = Vector2.new(0, math.max(0, y))
end)
end
local results = {}
local function hide()
dd.Visible = false
clearB.Visible = false
end
local function go(e)
if e.act then
box.Text = ""
hide()
task.spawn(safe, e.act)
return
end
local tab = e.tab or tabOf(e.obj)
if not tab then return end
if not win.open then openWindow() end
selectTab(tab)
box.Text = ""
hide()
if e.obj and e.kind ~= "tab" then
task.delay(0.55, function()
scrollTo(tab, e.obj)
flash(e.obj)
end)
end
end
local function render(list, q)
for _, c in ipairs(dd:GetChildren()) do
if c:IsA("GuiObject") then c:Destroy() end
end
results = list
if #list == 0 then
local l = label(dd, {
				Size = UDim2.new(1, 0, 0, 34), Text = "Sin resultados para \"" .. q .. "\"", TextSize = 12, Font = Enum.Font.Gotham,
TextColor3 = T.sub, ZIndex = 81, TextXAlignment = Enum.TextXAlignment.Center,
})
dd.Size = UDim2.new(1, -24, 0, 42)
dd.Visible = true
return
end
for i, e in ipairs(list) do
local b = new("TextButton", {
Size = UDim2.new(1, 0, 0, 42), BackgroundTransparency = (i == 1) and 0.8 or 1, BackgroundColor3 = T.accent, Text = "",
AutoButtonColor = false, BorderSizePixel = 0, LayoutOrder = i, ZIndex = 81,
}, dd)
corner(b, 12)
local sub
if e.kind == "tab" then
sub = "Pestaña"
elseif e.kind == "act" then
sub = "Acción"
else
local tb = e.tab or tabOf(e.obj)
sub = (tb and tabNames[tb] or "") .. ((e.sec and e.sec ~= "") and (" · " .. e.sec) or "")
end
label(b, {
Position = UDim2.fromOffset(12, 4), Size = UDim2.new(1, -24, 0, 18), Text = e.t, TextSize = 13, Font = Enum.Font.GothamBold,
ZIndex = 82, TextTruncate = Enum.TextTruncate.AtEnd,
})
label(b, {
Position = UDim2.fromOffset(12, 22), Size = UDim2.new(1, -24, 0, 16), Text = sub, TextSize = 10, Font = Enum.Font.Gotham,
TextColor3 = T.sub, ZIndex = 82, TextTruncate = Enum.TextTruncate.AtEnd,
})
track(b.Activated:Connect(function() go(e) end))
end
dd.Size = UDim2.new(1, -24, 0, math.min(#list, 7) * 44 + 8)
dd.Visible = true
end
local tok = 0
local function query()
local q = box.Text
clearB.Visible = q ~= ""
if norm(q) == "" then hide() return end
local P = M.prep(q)
local all = {}
for i, n in ipairs(tabNames) do
local sc = M.score(n, P)
if sc > 30 then all[#all + 1] = { t = n, tab = i, kind = "tab", s = sc * 1.25 } end
end
local keep = {}
for _, e in ipairs(SIdx) do
if e.obj and e.obj.Parent and e.obj:IsDescendantOf(G) then
keep[#keep + 1] = e
local sc = M.score(e.t, P)
if e.d then sc = math.max(sc, M.score(e.d, P) * 0.45) end
if e.sec and e.sec ~= "" then sc = math.max(sc, M.score(e.sec, P) * 0.3) end
if e.kind == "note" then sc = sc * 0.55 elseif e.kind == "sec" then sc = sc * 1.05 elseif e.kind == "chip" then sc = sc * 0.9 end
if sc > 30 then
all[#all + 1] = { t = e.t, d = e.d, obj = e.obj, sec = e.sec, kind = e.kind, s = sc }
end
end
end
for i = #SIdx, 1, -1 do
local e = SIdx[i]
if not (e.obj and e.obj.Parent) then table.remove(SIdx, i) end
end
table.sort(all, function(a, b)
if a.s ~= b.s then return a.s > b.s end
return #a.t < #b.t
end)
local seen, out = {}, {}
for _, e in ipairs(all) do
local k = (e.kind == "tab" and "tab:" or "") .. norm(e.t) .. "|" .. tostring(e.sec)
if not seen[k] then
seen[k] = true
out[#out + 1] = e
if #out >= 12 then break end
end
end
local qq = tostring(q):match("^%s*(.-)%s*$") or q
		out[#out + 1] = { t = "Buscar \"" .. qq .. "\" en Avatares", kind = "act", act = function() if env.XC_AvSearch then env.XC_AvSearch(qq) end end }
		out[#out + 1] = { t = "Buscar \"" .. qq .. "\" en el catálogo", kind = "act", act = function() if env.XC_CatSearch then env.XC_CatSearch(qq) end end }
render(out, q)
end
track(box:GetPropertyChangedSignal("Text"):Connect(function()
tok = tok + 1
local my = tok
task.delay(0.12, function()
if my == tok then query() end
end)
end))
track(box.FocusLost:Connect(function(enter)
if enter and results[1] then go(results[1]) end
end))
track(clearB.Activated:Connect(function()
box.Text = ""
hide()
end))
env.XC_Search = { focus = function() pcall(function() box:CaptureFocus() end) end }
end
local function Section(page, text)
local l = label(page, {
Text = string.upper(text), Size = UDim2.new(1, 0, 0, 18), TextSize = 12, Font = Enum.Font.FredokaOne,
TextColor3 = T.sub, LayoutOrder = nextOrder(),
})
new("UIPadding", { PaddingLeft = UDim.new(0, 22) }, l)
local dot = new("Frame", { Position = UDim2.new(0, -14, 0.5, -4), Size = UDim2.fromOffset(8, 8), BorderSizePixel = 0 }, l)
circle(dot)
accentReg(dot, "BackgroundColor3")
sectionOf[page] = text
idxAdd(page, text, nil, l, "sec")
end
local function Note(page, text)
local l = label(page, {
Text = text, Size = UDim2.new(1, 0, 0, 16), TextSize = 11, Font = Enum.Font.Gotham, TextColor3 = T.sub,
LayoutOrder = nextOrder(),
})
new("UIPadding", { PaddingLeft = UDim.new(0, 8) }, l)
if #text > 8 and #text < 160 then idxAdd(page, text, nil, l, "note") end
return l
end
local function LogBox(page, text)
local row = new("Frame", {
Size = UDim2.new(1, 0, 0, 40), BackgroundColor3 = T.white, BackgroundTransparency = 0.6,
BorderSizePixel = 0, LayoutOrder = nextOrder(),
}, page)
corner(row, 12)
local l = label(row, {
Text = text, Position = UDim2.fromOffset(12, 0), Size = UDim2.new(1, -24, 1, 0), TextSize = 11,
Font = Enum.Font.Gotham, TextColor3 = T.sub, TextWrapped = true, TextTruncate = Enum.TextTruncate.None,
})
logLabels[#logLabels + 1] = l
return l
end
local function Row(page, h)
local r = new("Frame", {
Size = UDim2.new(1, 0, 0, h), BackgroundColor3 = T.white, BackgroundTransparency = 0.26,
BorderSizePixel = 0, LayoutOrder = nextOrder(),
}, page)
corner(r, 16)
stroke(r, 0.3, 1.2)
return r
end
local function titles(row, title, desc, rightSpace)
label(row, {
Text = title, Position = UDim2.fromOffset(14, desc and 8 or 0),
Size = desc and UDim2.new(1, -rightSpace, 0, 18) or UDim2.new(1, -rightSpace, 1, 0),
Font = Enum.Font.GothamBold, TextSize = 13,
})
if desc then
label(row, {
Text = desc, Position = UDim2.fromOffset(14, 27), Size = UDim2.new(1, -rightSpace, 0, 16),
TextSize = 11, TextColor3 = T.sub, Font = Enum.Font.Gotham,
})
end
end
local function makeSwitch(row, cb)
local sw = new("TextButton", {
AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0), Size = UDim2.fromOffset(46, 28),
BackgroundColor3 = T.off, Text = "", AutoButtonColor = false, BorderSizePixel = 0,
}, row)
circle(sw)
local knob = new("Frame", {
Size = UDim2.fromOffset(22, 22), Position = UDim2.fromOffset(3, 3), BackgroundColor3 = T.white, BorderSizePixel = 0,
}, sw)
circle(knob)
local obj = { state = false }
function obj.Set(v, silent)
obj.state = v
tween(sw, 0.25, { BackgroundColor3 = v and T.green or T.off })
tween(knob, 0.3, { Position = v and UDim2.fromOffset(21, 3) or UDim2.fromOffset(3, 3) }, Enum.EasingStyle.Back)
if not silent and cb then task.spawn(safe, cb, v) end
end
track(sw.Activated:Connect(function() obj.Set(not obj.state) end))
return obj
end
local function Toggle(page, title, desc, default, cb)
local row = Row(page, desc and 54 or 46)
titles(row, title, desc, 84)
idxAdd(page, title, desc, row)
local obj = makeSwitch(row, cb)
if default then obj.Set(true, true) end
return obj
end
local function stepBtn(row, txt, x)
local b = new("TextButton", {
AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, x, 0.5, 0), Size = UDim2.fromOffset(28, 28),
BackgroundColor3 = T.white, BackgroundTransparency = 0.3, Text = txt, Font = Enum.Font.GothamBold,
TextSize = 17, TextColor3 = T.text, AutoButtonColor = false, BorderSizePixel = 0,
}, row)
circle(b)
stroke(b, 0.3, 1.2)
return b
end
local function ToggleStep(page, title, min, max, step, default, onValue, onToggle)
local row = Row(page, 46)
titles(row, title, nil, 200)
idxAdd(page, title, nil, row)
local obj = makeSwitch(row, onToggle)
local value = default
local plus = stepBtn(row, "+", -66)
local vl = label(row, {
AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -96, 0.5, 0), Size = UDim2.fromOffset(44, 24),
TextXAlignment = Enum.TextXAlignment.Center, Font = Enum.Font.GothamBold, TextSize = 13, Text = tostring(value),
})
local minus = stepBtn(row, "−", -142)
local function change(d)
value = math.clamp(math.floor((value + d) * 10000 + 0.5) / 10000, min, max)
vl.Text = tostring(value)
task.spawn(safe, onValue, value)
end
track(plus.Activated:Connect(function() change(step) end))
track(minus.Activated:Connect(function() change(-step) end))
return obj
end
local function Stepper(page, title, min, max, step, default, suffix, cb)
local row = Row(page, 46)
titles(row, title, nil, 190)
idxAdd(page, title, nil, row)
local value = default
local plus = stepBtn(row, "+", -12)
local vl = label(row, {
AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -44, 0.5, 0), Size = UDim2.fromOffset(60, 24),
TextXAlignment = Enum.TextXAlignment.Center, Font = Enum.Font.GothamBold, TextSize = 13,
Text = tostring(value) .. (suffix or ""),
})
local minus = stepBtn(row, "−", -106)
local function change(d)
value = math.clamp(math.floor((value + d) * 10000 + 0.5) / 10000, min, max)
vl.Text = tostring(value) .. (suffix or "")
task.spawn(safe, cb, value)
end
track(plus.Activated:Connect(function() change(step) end))
track(minus.Activated:Connect(function() change(-step) end))
return {
Set = function(v, silent)
value = math.clamp(v, min, max)
vl.Text = tostring(value) .. (suffix or "")
if not silent then task.spawn(safe, cb, value) end
end,
}
end
local function Button(page, text, color, cb)
local b = new("TextButton", {
Size = UDim2.new(1, 0, 0, 40), BackgroundColor3 = T.white, BackgroundTransparency = 0.26, Text = text,
Font = Enum.Font.GothamBold, TextSize = 13, TextColor3 = color or T.text, AutoButtonColor = false,
BorderSizePixel = 0, LayoutOrder = nextOrder(),
}, page)
corner(b, 16)
stroke(b, 0.3, 1.2)
idxAdd(page, text, nil, b, "btn")
if color == T.accent then accentReg(b, "TextColor3") end
track(b.Activated:Connect(function()
tween(b, 0.1, { BackgroundTransparency = 0.2 })
task.delay(0.12, function() tween(b, 0.3, { BackgroundTransparency = 0.26 }) end)
task.spawn(safe, cb)
end))
return b
end
local function ButtonRow(page, defs)
local f = new("Frame", { Size = UDim2.new(1, 0, 0, 40), BackgroundTransparency = 1, LayoutOrder = nextOrder() }, page)
local n = #defs
for i, d in ipairs(defs) do
local b = new("TextButton", {
Position = UDim2.new((i - 1) / n, 0, 0, 0), Size = UDim2.new(1 / n, -6, 1, 0), BackgroundColor3 = T.white,
BackgroundTransparency = 0.26, Text = d[1], Font = Enum.Font.GothamBold, TextSize = 12,
TextColor3 = d[2] or T.text, AutoButtonColor = false, BorderSizePixel = 0,
}, f)
corner(b, 16)
stroke(b, 0.3, 1.2)
idxAdd(page, d[1], nil, f, "btn")
if d[2] == T.accent then accentReg(b, "TextColor3") end
track(b.Activated:Connect(function()
tween(b, 0.1, { BackgroundTransparency = 0.2 })
task.delay(0.12, function() tween(b, 0.3, { BackgroundTransparency = 0.26 }) end)
task.spawn(safe, d[3])
end))
end
return f
end
local function InputRow(page, placeholder, btnText, cb)
local row = Row(page, 46)
idxAdd(page, placeholder, nil, row, "inp")
local box = new("TextBox", {
Position = UDim2.fromOffset(10, 8), Size = UDim2.new(1, -108, 0, 30), BackgroundColor3 = T.white,
BackgroundTransparency = 0.2, BorderSizePixel = 0, Text = "", PlaceholderText = placeholder,
PlaceholderColor3 = T.sub, TextColor3 = T.text, Font = Enum.Font.Gotham, TextSize = 13,
ClearTextOnFocus = false, TextXAlignment = Enum.TextXAlignment.Left,
}, row)
corner(box, 12)
new("UIPadding", { PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10) }, box)
local btn = new("TextButton", {
AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0), Size = UDim2.fromOffset(80, 30),
Text = btnText, Font = Enum.Font.GothamBold, TextSize = 13, TextColor3 = T.white,
AutoButtonColor = false, BorderSizePixel = 0,
}, row)
accentReg(btn, "BackgroundColor3")
circle(btn)
local function go() task.spawn(safe, cb, box.Text) end
track(btn.Activated:Connect(go))
track(box.FocusLost:Connect(function(enter) if enter then go() end end))
return box
end
local function Chips(page, names, w, cb, initial)
local bar = new("ScrollingFrame", {
Size = UDim2.new(1, 0, 0, 34), BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 0,
CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.X, ScrollingDirection = Enum.ScrollingDirection.X,
LayoutOrder = nextOrder(),
}, page)
new("UIListLayout", {
FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder,
VerticalAlignment = Enum.VerticalAlignment.Center,
}, bar)
local btns, cur = {}, initial or 1
local obj = { bar = bar }
local function paint()
for i, b in ipairs(btns) do
local on = (i == cur)
b.BackgroundColor3 = on and T.accent or T.white
b.BackgroundTransparency = on and 0.02 or 0.35
b.TextColor3 = on and T.white or T.text
end
end
repaintFns[#repaintFns + 1] = paint
function obj.Set(i, silent)
cur = i
paint()
if not silent and cb then task.spawn(safe, cb, i, names[i]) end
end
for i, n in ipairs(names) do
local b = new("TextButton", {
Size = UDim2.fromOffset(w, 28), BackgroundColor3 = T.white, BackgroundTransparency = 0.35, Text = n,
Font = Enum.Font.GothamBold, TextSize = 12, TextColor3 = T.text, AutoButtonColor = false,
BorderSizePixel = 0, LayoutOrder = i,
}, bar)
circle(b)
stroke(b, 0.3, 1.2)
btns[i] = b
idxAdd(page, n, "Opción", bar, "chip")
track(b.Activated:Connect(function() obj.Set(i) end))
end
paint()
return obj
end
local function listFrame(page)
local f = new("Frame", {
Size = UDim2.new(1, 0, 0, 0), BackgroundTransparency = 1, AutomaticSize = Enum.AutomaticSize.Y,
LayoutOrder = nextOrder(),
}, page)
new("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }, f)
return f
end
local function clearList(cont)
for _, ch in ipairs(cont:GetChildren()) do
if ch:IsA("GuiObject") then
updaters[ch] = nil
ch:Destroy()
end
end
end
updateAll = function()
for _, f in pairs(updaters) do pcall(f) end
pcall(viewerRefresh)
end
local function itemRow(parent, d)
local row = new("Frame", {
Size = UDim2.new(1, 0, 0, 56), BackgroundColor3 = T.white, BackgroundTransparency = 0.26,
BorderSizePixel = 0, LayoutOrder = nextOrder(),
}, parent)
corner(row, 16)
stroke(row, 0.3, 1.2)
local thumb = new("ImageLabel", {
Position = UDim2.fromOffset(8, 6), Size = UDim2.fromOffset(44, 44), BackgroundColor3 = d.swatch or T.white,
BackgroundTransparency = d.swatch and 0 or 0.3, BorderSizePixel = 0, ScaleType = Enum.ScaleType.Fit,
}, row)
corner(thumb, 12)
if d.id then thumb.Image = "rbxthumb://type=Asset&id=" .. tostring(d.id) .. "&w=150&h=150" end
local nameL = label(row, { Text = d.name or "Cargando…", Position = UDim2.fromOffset(60, 8), Size = UDim2.new(1, -200, 0, 18), TextSize = 13, Font = Enum.Font.GothamBold })
label(row, {
Text = d.sub or "", Position = UDim2.fromOffset(60, 28), Size = UDim2.new(1, -200, 0, 16), TextSize = 11,
TextColor3 = T.sub, Font = Enum.Font.Gotham,
})
if not d.name and d.id then
task.spawn(function()
local n = itemName(d.id)
d.name = n
if nameL.Parent then nameL.Text = n end
end)
end
local viewBtn = new("TextButton", {
AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -88, 0.5, 0), Size = UDim2.fromOffset(44, 28),
Text = "3D", Font = Enum.Font.GothamBold, TextSize = 12, TextColor3 = T.white,
AutoButtonColor = false, BorderSizePixel = 0, Visible = d.id ~= nil,
}, row)
accentReg(viewBtn, "BackgroundColor3")
circle(viewBtn)
local actBtn = new("TextButton", {
AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0), Size = UDim2.fromOffset(70, 28),
BackgroundColor3 = T.green, Text = "Poner", Font = Enum.Font.GothamBold, TextSize = 12, TextColor3 = T.white,
AutoButtonColor = false, BorderSizePixel = 0,
}, row)
circle(actBtn)
local busy = false
local function upd()
if busy then return end
local on = applied[d.key] ~= nil
actBtn.Text = on and "Quitar" or "Poner"
actBtn.BackgroundColor3 = on and T.red or T.green
end
updaters[row] = upd
upd()
local function toggle(done)
if busy then return end
busy = true
actBtn.Text = "…"
task.spawn(function()
if applied[d.key] then
removeItem(d.key)
report("Quitado: " .. tostring(d.name or d.sub or "item"))
else
local ok, err = prepareItem(d)
if ok then ok, err = applyItem(d) end
if ok then
report("Puesto: " .. tostring(d.name or d.sub or "item"))
else
report("No se pudo poner: " .. tostring(err))
end
end
busy = false
updateAll()
if done then done() end
end)
end
actBtn.Activated:Connect(function() toggle() end)
viewBtn.Activated:Connect(function()
task.spawn(function()
local obj = d.id and resolveItem(fetchObject(d.id)) or nil
openViewer(d.name or ("Item " .. tostring(d.id)), obj, d.id, function() return applied[d.key] ~= nil end, toggle)
end)
end)
return row
end
local function actionRow(d)
local row = new("Frame", {
Size = UDim2.new(1, 0, 0, 56), BackgroundColor3 = T.white, BackgroundTransparency = 0.26,
BorderSizePixel = 0, LayoutOrder = nextOrder(),
}, d.parent)
corner(row, 16)
stroke(row, 0.3, 1.2)
local thumb = new("ImageLabel", {
Position = UDim2.fromOffset(8, 6), Size = UDim2.fromOffset(44, 44), BackgroundColor3 = T.white,
BackgroundTransparency = 0.3, BorderSizePixel = 0, ScaleType = Enum.ScaleType.Fit,
Image = d.thumb or ("rbxthumb://type=Asset&id=" .. tostring(d.id) .. "&w=150&h=150"),
}, row)
corner(thumb, 12)
if d.icon then
label(thumb, {
Size = UDim2.fromScale(1, 1), Text = d.icon, TextSize = 22, Font = Enum.Font.GothamBold,
TextXAlignment = Enum.TextXAlignment.Center, TextTruncate = Enum.TextTruncate.None,
})
end
local wName = d.btn2 and -226 or -150
label(row, { Text = d.name or "Item", Position = UDim2.fromOffset(60, 8), Size = UDim2.new(1, wName, 0, 18), TextSize = 13, Font = Enum.Font.GothamBold })
label(row, {
Text = d.sub or "", Position = UDim2.fromOffset(60, 28), Size = UDim2.new(1, wName, 0, 16), TextSize = 11,
TextColor3 = T.sub, Font = Enum.Font.Gotham,
})
local function btnText() return d.label and d.label() or d.btn or "Usar" end
local btn = new("TextButton", {
AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0), Size = UDim2.fromOffset(70, 28),
Text = btnText(), Font = Enum.Font.GothamBold, TextSize = 12, TextColor3 = T.white,
AutoButtonColor = false, BorderSizePixel = 0,
}, row)
accentReg(btn, "BackgroundColor3")
circle(btn)
if d.btn2 then
local b2 = new("TextButton", {
AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -86, 0.5, 0), Size = UDim2.fromOffset(66, 28),
BackgroundColor3 = T.white, BackgroundTransparency = 0.2, Text = d.btn2, Font = Enum.Font.GothamBold,
TextSize = 12, TextColor3 = T.text, AutoButtonColor = false, BorderSizePixel = 0,
}, row)
circle(b2)
stroke(b2, 0.3, 1.2)
track(b2.Activated:Connect(function()
task.spawn(function() pcall(d.cb2, d) end)
end))
end
local busy = false
track(btn.Activated:Connect(function()
if busy then return end
busy = true
btn.Text = "…"
task.spawn(function()
pcall(d.cb, d)
busy = false
btn.Text = btnText()
end)
end))
return row, btn
end
do
local okP, eP = pcall(function()
local P1 = pages[1]
Section(P1, "Movimiento")
ToggleStep(P1, "Volar", 10, 300, 10, vals.flySpeed, function(v) vals.flySpeed = v end, function(v)
state.fly = v
if not v then flyStop() end
end)
ToggleStep(P1, "Velocidad", 16, 300, 8, vals.walkSpeed, function(v) vals.walkSpeed = v end, function(v)
state.speed = v
if not v then local h = getHum() if h then h.WalkSpeed = 16 end end
end)
ToggleStep(P1, "Super salto", 50, 400, 25, vals.jumpPower, function(v) vals.jumpPower = v end, function(v)
state.jump = v
if not v then local h = getHum() if h then h.UseJumpPower = true h.JumpPower = 50 end end
end)
Toggle(P1, "Noclip", nil, false, function(v) state.noclip = v end)
Toggle(P1, "Salto infinito", nil, false, function(v) state.infjump = v end)
Section(P1, "Mundo")
Toggle(P1, "Fullbright", nil, false, function(v) setFullbright(v) end)
Stepper(P1, "Campo de visión", 30, 120, 5, vals.fov, "°", function(v)
vals.fov = v
local cam = Workspace.CurrentCamera
if cam then cam.FieldOfView = v end
end)
Section(P1, "Utilidades")
Toggle(P1, "Anti-AFK", nil, true, function(v) state.antiafk = v end)
Button(P1, "Reentrar al servidor", T.text, function()
TeleportService:Teleport(game.PlaceId, lp)
end)
end)
if not okP then DG_Fail("Pestaña 1", eP) end
end
do
local okP, eP = pcall(function()
local P2 = pages[2]
Section(P2, "Mi avatar (solo tú lo ves)")
local rigRow = Row(P2, 44)
titles(rigRow, "Rig detectado", nil, 100)
rigLabel = label(rigRow, {
AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -16, 0.5, 0), Size = UDim2.fromOffset(60, 24),
TextXAlignment = Enum.TextXAlignment.Right, Font = Enum.Font.GothamBold, TextSize = 14, TextColor3 = T.accent, Text = "--",
})
accentReg(rigLabel, "TextColor3")
Toggle(P2, "Korblox", nil, false, function(v)
state.korblox = v
local c = getChar()
if c then pcall(applyKorblox, c, v) end
end)
Toggle(P2, "Headless", nil, false, function(v)
state.headless = v
local c = getChar()
if c then pcall(applyHeadless, c, v) end
end)
Button(P2, "Ver mi skin en 3D", T.accent, viewMySkin)
Button(P2, "Volver a mi avatar de Roblox", T.green, function() if env.XC_ORIGINAL then env.XC_ORIGINAL() end end)
Section(P2, "Mis accesorios")
local accContainer = new("Frame", {
Size = UDim2.new(1, 0, 0, 0), BackgroundTransparency = 1, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = nextOrder(),
}, P2)
new("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }, accContainer)
refreshAccessoriesFunc = function()
for _, child in ipairs(accContainer:GetChildren()) do
if child:IsA("Frame") then child:Destroy() end
end
local c = getChar()
if not c then return end
local list, seen = {}, {}
for _, it in ipairs(c:GetChildren()) do
if it:IsA("Accessory") then list[#list + 1] = it seen[it] = true end
end
for it in pairs(accessoryStorage) do
if not seen[it] and it.Parent == nil then list[#list + 1] = it end
end
for _, item in ipairs(list) do
local row = new("Frame", {
Size = UDim2.new(1, 0, 0, 42), BackgroundColor3 = T.white, BackgroundTransparency = 0.26,
BorderSizePixel = 0,
}, accContainer)
corner(row, 16)
stroke(row, 0.3, 1.2)
label(row, {
Text = item.Name, Position = UDim2.fromOffset(14, 0), Size = UDim2.new(1, -160, 1, 0),
Font = Enum.Font.GothamBold, TextSize = 13,
})
local viewBtn = new("TextButton", {
AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -88, 0.5, 0), Size = UDim2.fromOffset(44, 26),
Text = "3D", Font = Enum.Font.GothamBold, TextSize = 12,
TextColor3 = T.white, AutoButtonColor = false, BorderSizePixel = 0,
}, row)
accentReg(viewBtn, "BackgroundColor3")
circle(viewBtn)
local btn = new("TextButton", {
AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0), Size = UDim2.fromOffset(70, 26),
BackgroundColor3 = T.red, Text = "Quitar", Font = Enum.Font.GothamBold, TextSize = 12,
TextColor3 = T.white, AutoButtonColor = false, BorderSizePixel = 0,
}, row)
circle(btn)
local equipped = item.Parent ~= nil
local function paint()
btn.Text = equipped and "Quitar" or "Poner"
btn.BackgroundColor3 = equipped and T.red or T.green
end
paint()
local function setEq(v)
local ch = getChar()
if not ch then return end
equipped = v
if v then
accessoryStorage[item] = nil
local h = getHum()
if h then pcall(function() h:AddAccessory(item) end) end
if item.Parent ~= ch then item.Parent = ch end
else
accessoryStorage[item] = true
item.Parent = nil
end
paint()
end
btn.Activated:Connect(function() setEq(not equipped) end)
viewBtn.Activated:Connect(function()
openViewer(item.Name, item, nil, function() return equipped end, function(done)
setEq(not equipped)
if done then done() end
end)
end)
end
if #list == 0 then
local emptyRow = new("Frame", {
Size = UDim2.new(1, 0, 0, 36), BackgroundColor3 = T.white, BackgroundTransparency = 0.7,
BorderSizePixel = 0,
}, accContainer)
corner(emptyRow, 14)
label(emptyRow, {
Text = "No tienes accesorios equipados.",
Position = UDim2.fromOffset(12, 0), Size = UDim2.new(1, -24, 1, 0),
Font = Enum.Font.Gotham, TextSize = 12, TextColor3 = T.sub,
TextXAlignment = Enum.TextXAlignment.Center,
})
end
end
end)
if not okP then DG_Fail("Pestaña 2", eP) end
end
do
local okP, eP = pcall(function()
local P3 = pages[3]
Section(P3, "Copiar avatar de un usuario")
local copyItems, copyData = {}, nil
local copyToken = 0
local copyStatus, copyList
local BODY_PARTS = {
{ "Head", "Cabeza" }, { "Torso", "Torso" }, { "LeftArm", "Brazo izquierdo" }, { "RightArm", "Brazo derecho" },
{ "LeftLeg", "Pierna izquierda" }, { "RightLeg", "Pierna derecha" },
}
local CLOTHES = { { "Shirt", "Camisa" }, { "Pants", "Pantalón" }, { "GraphicTShirt", "Camiseta gráfica" }, { "Face", "Cara" } }
local function buildCopy(data)
clearList(copyList)
copyItems = {}
local desc, pre = data.desc, "u" .. data.userId .. "_"
local function add(d)
copyItems[#copyItems + 1] = d
itemRow(copyList, d)
end
local okA, accs = pcall(function() return desc:GetAccessories(true) end)
if okA and accs then
for _, a in ipairs(accs) do
if a.AssetId and a.AssetId > 0 then
local tname = "Accesorio"
pcall(function() tname = a.AccessoryType.Name end)
add({ key = pre .. "a" .. a.AssetId, kind = "acc", id = a.AssetId, entry = a, sub = "Accesorio · " .. tname })
end
end
end
for _, cl in ipairs(CLOTHES) do
local id = desc[cl[1]]
if id and id > 0 then
add({ key = pre .. cl[1], kind = "prop", prop = cl[1], id = id, sub = cl[2] })
end
end
for _, bp in ipairs(BODY_PARTS) do
local id = desc[bp[1]]
if id and id > 0 then
add({ key = pre .. bp[1], kind = "prop", prop = bp[1], id = id, name = bp[2], sub = "Cuerpo" })
end
end
local okC, cvals = pcall(function()
return {
HeadColor = desc.HeadColor, TorsoColor = desc.TorsoColor, LeftArmColor = desc.LeftArmColor,
RightArmColor = desc.RightArmColor, LeftLegColor = desc.LeftLegColor, RightLegColor = desc.RightLegColor,
}
end)
if okC then
add({ key = pre .. "colors", kind = "colors", name = "Colores de piel", sub = "Cuerpo", swatch = desc.HeadColor, vals = cvals })
end
local okS, svals = pcall(function()
return {
HeightScale = desc.HeightScale, WidthScale = desc.WidthScale, DepthScale = desc.DepthScale,
HeadScale = desc.HeadScale, BodyTypeScale = desc.BodyTypeScale, ProportionScale = desc.ProportionScale,
}
end)
if okS then
add({ key = pre .. "scale", kind = "scale", name = "Tamaño del cuerpo", sub = "Cuerpo", vals = svals })
end
end
local function searchUser(text)
text = tostring(text or ""):gsub("%s+", "")
if text == "" then copyStatus.Text = "Escribe un usuario o ID" return end
copyToken = copyToken + 1
local tk = copyToken
copyStatus.Text = "Buscando…"
local userId = tonumber(text)
local uname = text
if userId then
local ok, n = pcall(function() return Players:GetNameFromUserIdAsync(userId) end)
if ok and n then uname = n end
else
local ok, id = pcall(function() return Players:GetUserIdFromNameAsync(text) end)
if not ok or not id then
if tk == copyToken then copyStatus.Text = "Usuario no encontrado" end
return
end
userId = id
end
local ok, desc = pcall(function() return Players:GetHumanoidDescriptionFromUserId(userId) end)
if tk ~= copyToken then return end
if not ok or not desc then copyStatus.Text = "No se pudo leer el avatar" return end
copyData = { userId = userId, name = uname, desc = desc }
buildCopy(copyData)
copyStatus.Text = uname .. " (" .. userId .. ") · " .. #copyItems .. " piezas"
end
InputRow(P3, "Nombre de usuario o ID", "Buscar", searchUser)
copyStatus = Note(P3, "Escribe un usuario y toca Buscar")
local function putAllPieces()
if #copyItems == 0 then toast("Busca un usuario primero") return end
stashOwnAccessories()
local okN, failN, lastErr = 0, 0, nil
for i, d in ipairs(copyItems) do
report("Aplicando " .. i .. "/" .. #copyItems .. "…")
if not applied[d.key] then
local ok, err = applyItem(d)
if ok then okN = okN + 1 else failN = failN + 1 lastErr = err end
end
updateAll()
end
if failN == 0 then
report("Listo: " .. okN .. " piezas puestas")
else
report(okN .. " puestas, " .. failN .. " fallaron: " .. tostring(lastErr))
end
postApply()
end
ButtonRow(P3, {
{ "Copiar skin completa", T.accent, function()
if not copyData then toast("Busca un usuario primero") return end
report("Copiando la skin de " .. tostring(copyData.name) .. "…")
local ok, how = fullCopy(copyData.desc)
if ok then
Sess.copy = { userId = copyData.userId, name = copyData.name }
SessSave()
report("Skin copiada · " .. tostring(how))
else
report("Falló (" .. tostring(how) .. "). Probando pieza por pieza…")
putAllPieces()
end
updateAll()
end },
{ "Ver skin 3D", T.accent, function()
if not copyData then toast("Busca un usuario primero") return end
toast("Cargando skin…")
local rig, err = buildRig(copyData.desc, Enum.HumanoidRigType.R15)
if rig then
openViewer(copyData.name, rig, nil, nil, nil)
else
report("Sin 3D (" .. tostring(err) .. "), muestro la foto")
openViewer(copyData.name, nil, nil, nil, nil, "rbxthumb://type=Avatar&id=" .. tostring(copyData.userId) .. "&w=420&h=420")
end
end },
{ "Quitar todo", T.red, function()
removeAllApplied()
updateAll()
report("Tu avatar fue restaurado")
end },
{ "Mi avatar original", T.green, function() if env.XC_ORIGINAL then env.XC_ORIGINAL() end end },
})
ButtonRow(P3, {
{ "Poner todo (pieza por pieza)", T.green, putAllPieces },
{ "Diagnóstico", T.text, runDiagnostics },
})
LogBox(P3, "Registro")
copyList = listFrame(P3)
end)
if not okP then DG_Fail("Pestaña 3", eP) end
end
do
local okP, eP = pcall(function()
local P4 = pages[4]
Section(P4, "Catálogo de Roblox")
local function enumList(names, et)
local out = {}
for _, n in ipairs(names) do
local ok, e = pcall(function() return et[n] end)
if ok and e then out[#out + 1] = e end
end
return out
end
local function httpGet(url)
local ok, res = pcall(function() return game:HttpGet(url) end)
if ok and res then return res end
local req = (syn and syn.request) or (http and http.request) or http_request or request
if req then
local ok2, r = pcall(req, { Url = url, Method = "GET" })
if ok2 and r and r.Body then return r.Body end
end
return nil
end
local ACCS = { "Hat", "HairAccessory", "FaceAccessory", "NeckAccessory", "ShoulderAccessory", "FrontAccessory", "BackAccessory", "WaistAccessory" }
local CATS = {
{ "Accesorios", {
{ "Todo", ACCS, nil, "item" }, { "Sombreros", { "Hat" }, nil, "item" }, { "Pelo", { "HairAccessory" }, nil, "item" },
{ "Cara", { "FaceAccessory" }, nil, "item" }, { "Cuello", { "NeckAccessory" }, nil, "item" },
{ "Espalda", { "BackAccessory" }, nil, "item" }, { "Hombros", { "ShoulderAccessory" }, nil, "item" },
