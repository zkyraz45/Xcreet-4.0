BorderSizePixel = 0, LayoutOrder = i,
}, swBar)
circle(b)
stroke(b, 0, 2, Color3.fromRGB(255, 255, 255))
track(b.Activated:Connect(function()
Style.accent = s
applyStyle()
end))
end
local function hexToArr(txt)
local hex = tostring(txt or ""):gsub("%s+", "")
local ok, col = pcall(Color3.fromHex, hex)
if not ok or not col then return nil end
return { math.floor(col.R * 255 + 0.5), math.floor(col.G * 255 + 0.5), math.floor(col.B * 255 + 0.5) }
end
InputRow(P7, "Color hex (ej: #FF8FB8)", "Aplicar", function(txt)
local a = hexToArr(txt)
if not a then toast("Color inválido") return end
Style.accent = a
applyStyle()
end)
do
local row = Row(P7, 46)
local function hexBox(x, ph)
local b = new("TextBox", {
Position = UDim2.fromOffset(x, 8), Size = UDim2.new(0.5, -62, 0, 30), BackgroundColor3 = T.white,
BackgroundTransparency = 0.2, BorderSizePixel = 0, Text = "", PlaceholderText = ph,
PlaceholderColor3 = T.sub, TextColor3 = T.text, Font = Enum.Font.Gotham, TextSize = 12,
ClearTextOnFocus = false,
}, row)
corner(b, 12)
new("UIPadding", { PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8) }, b)
return b
end
local b1 = hexBox(10, "Fondo 1 #FFF4F9")
local b2 = new("TextBox", {
Position = UDim2.new(0.5, -46, 0, 8), Size = UDim2.new(0.5, -62, 0, 30), BackgroundColor3 = T.white,
BackgroundTransparency = 0.2, BorderSizePixel = 0, Text = "", PlaceholderText = "Fondo 2 #FFD0E4",
PlaceholderColor3 = T.sub, TextColor3 = T.text, Font = Enum.Font.Gotham, TextSize = 12, ClearTextOnFocus = false,
}, row)
corner(b2, 12)
new("UIPadding", { PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8) }, b2)
local go = new("TextButton", {
