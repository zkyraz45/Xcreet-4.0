do
local okP, eP = pcall(function()
local P10 = pages[10]
local pid = tostring(game.PlaceId)
local origGrav = tonumber(Workspace.Gravity) or 196.2
local orig = { clock = Lighting.ClockTime, fog = Lighting.FogEnd, shadows = Lighting.GlobalShadows }
local cleanup = {}
local function getUrl(url)
local ok, res = pcall(function() return game:HttpGet(url) end)
if ok and res then return res end
local req = (syn and syn.request) or (http and http.request) or http_request or request
if req then
local ok2, r = pcall(req, { Url = url, Method = "GET" })
if ok2 and r and r.Body then return r.Body end
end
return nil
end
Section(P10, "Jugadores")
local specTarget
local function spectate(pl)
local cam = Workspace.CurrentCamera
local ch = pl and pl.Character
local hum = ch and ch:FindFirstChildOfClass("Humanoid")
if not (cam and hum) then toast("No se puede ver a ese jugador") return end
cam.CameraSubject = hum
specTarget = pl
toast("Viendo a " .. pl.DisplayName)
end
local function stopSpectate()
local cam, hum = Workspace.CurrentCamera, getHum()
if cam and hum then cam.CameraSubject = hum end
specTarget = nil
end
local function tpToPlayer(pl)
local root = getRoot()
local tr = pl.Character and pl.Character:FindFirstChild("HumanoidRootPart")
if not (root and tr) then toast("No se puede ir con ese jugador") return end
root.CFrame = tr.CFrame * CFrame.new(0, 0, 3)
end
local espOn, espDist = false, true
local marks = {}
local function unmark(ch)
local m = marks[ch]
if m then
pcall(function() m.hl:Destroy() end)
pcall(function() m.bb:Destroy() end)
marks[ch] = nil
end
end
local function clearMarks()
local list = {}
for ch in pairs(marks) do list[#list + 1] = ch end
for _, ch in ipairs(list) do unmark(ch) end
end
local function markPlayer(pl)
local ch = pl.Character
if not ch then return nil end
local m = marks[ch]
if m then return m end
local part = ch:FindFirstChild("HumanoidRootPart") or ch:FindFirstChildWhichIsA("BasePart")
if not part then return nil end
local col = pl.TeamColor and pl.TeamColor.Color or T.accent
local hl = new("Highlight", {
Adornee = ch, FillColor = col, OutlineColor = Color3.fromRGB(255, 255, 255), FillTransparency = 0.65,
OutlineTransparency = 0.1, DepthMode = Enum.HighlightDepthMode.AlwaysOnTop,
}, gui)
local bb = new("BillboardGui", {
Adornee = part, AlwaysOnTop = true, Size = UDim2.fromOffset(150, 26), StudsOffset = Vector3.new(0, 3.5, 0),
}, gui)
local lbl = label(bb, {
Size = UDim2.fromScale(1, 1), TextSize = 13, Font = Enum.Font.GothamBold, TextColor3 = Color3.fromRGB(255, 255, 255),
TextXAlignment = Enum.TextXAlignment.Center, TextStrokeTransparency = 0.3,
})
m = { hl = hl, bb = bb, lbl = lbl, part = part }
marks[ch] = m
return m
end
Toggle(P10, "ESP de jugadores", "Contorno y nombre a través de paredes", false, function(v)
espOn = v
if not v then clearMarks() end
end)
Toggle(P10, "Mostrar distancia", nil, true, function(v) espDist = v end)
local plList = listFrame(P10)
local function refreshPlayers()
clearList(plList)
for _, pl in ipairs(Players:GetPlayers()) do
if pl ~= lp then
actionRow({
parent = plList, name = pl.DisplayName, sub = "@" .. pl.Name, btn = "TP", btn2 = "Ver",
thumb = "rbxthumb://type=AvatarHeadShot&id=" .. tostring(pl.UserId) .. "&w=150&h=150",
cb = function() tpToPlayer(pl) end, cb2 = function() spectate(pl) end,
})
end
end
end
ButtonRow(P10, {
{ "Actualizar lista", T.accent, function() refreshPlayers() end },
{ "Dejar de ver", T.text, function() stopSpectate() end },
})
local acc = 0
track(RunService.Heartbeat:Connect(function(dt)
acc = acc + dt
if acc < 0.25 then return end
acc = 0
if not espOn then return end
local root = getRoot()
for _, pl in ipairs(Players:GetPlayers()) do
if pl ~= lp then
local m = markPlayer(pl)
if m and m.part.Parent then
local txt = pl.DisplayName
if espDist and root then txt = txt .. " · " .. math.floor((m.part.Position - root.Position).Magnitude) end
m.lbl.Text = txt
end
end
end
for ch in pairs(marks) do
if not ch.Parent or not Players:GetPlayerFromCharacter(ch) then unmark(ch) end
end
end))
Section(P10, "Teletransporte")
local clickTp = false
Toggle(P10, "Toca para teletransportarte", "Toca o haz clic en el suelo", false, function(v) clickTp = v end)
track(UIS.InputBegan:Connect(function(input, gp)
if gp or not clickTp then return end
local ut = input.UserInputType
if ut ~= Enum.UserInputType.MouseButton1 and ut ~= Enum.UserInputType.Touch then return end
local cam, root, ch = Workspace.CurrentCamera, getRoot(), getChar()
if not (cam and root and ch) then return end
local ray = cam:ScreenPointToRay(input.Position.X, input.Position.Y)
local params = RaycastParams.new()
params.FilterDescendantsInstances = { ch }
if not pcall(function() params.FilterType = Enum.RaycastFilterType.Exclude end) then
pcall(function() params.FilterType = Enum.RaycastFilterType.Blacklist end)
end
local res = Workspace:Raycast(ray.Origin, ray.Direction * 2000, params)
if res then root.CFrame = CFrame.new(res.Position + Vector3.new(0, 3.5, 0)) end
end))
local POINTS_FILE = "DeltaGlass_points.json"
local points = {}
if isfile and readfile then
pcall(function()
if isfile(POINTS_FILE) then
local d = HttpService:JSONDecode(readfile(POINTS_FILE))
if type(d) == "table" then points = d end
end
end)
end
points[pid] = points[pid] or {}
local function savePoints()
if writefile then pcall(function() writefile(POINTS_FILE, HttpService:JSONEncode(points)) end) end
end
local ptList = listFrame(P10)
local refreshPoints
refreshPoints = function()
clearList(ptList)
local list = points[pid]
for i, pt in ipairs(list) do
actionRow({
parent = ptList, name = tostring(pt.n), sub = math.floor(pt.x) .. ", " .. math.floor(pt.y) .. ", " .. math.floor(pt.z),
icon = "+", thumb = "", btn = "Ir", btn2 = "Borrar",
cb = function()
local r = getRoot()
if r then r.CFrame = CFrame.new(pt.x, pt.y + 3, pt.z) end
end,
cb2 = function()
table.remove(list, i)
savePoints()
refreshPoints()
end,
})
end
end
InputRow(P10, "Nombre del punto guardado", "Guardar aquí", function(txt)
local r = getRoot()
if not r then toast("No hay personaje") return end
local n = tostring(txt or "")
if n == "" then n = "Punto " .. (#points[pid] + 1) end
local p = r.Position
points[pid][#points[pid] + 1] = { n = n, x = p.X, y = p.Y, z = p.Z }
savePoints()
refreshPoints()
toast("Guardado: " .. n)
end)
ButtonRow(P10, {
{ "Ir al spawn", T.text, function()
local root = getRoot()
local sp = Workspace:FindFirstChildWhichIsA("SpawnLocation", true)
if root and sp then root.CFrame = sp.CFrame * CFrame.new(0, 4, 0) else toast("No encontré el spawn") end
end },
