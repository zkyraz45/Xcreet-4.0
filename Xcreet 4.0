decorChips = Chips(P7, { "Ninguna", "Cute", "Ángel" }, 112, function(i)
Style.decor = decorKeys[i]
applyStyle()
end, decorIdx)
Section(P7, "Color principal")
local swBar = new("ScrollingFrame", {
Size = UDim2.new(1, 0, 0, 40), BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 0,
CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.X, ScrollingDirection = Enum.ScrollingDirection.X,
LayoutOrder = nextOrder(),
}, P7)
new("UIListLayout", {
FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder,
