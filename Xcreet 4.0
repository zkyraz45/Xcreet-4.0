local function skinThumb(rec)
if rec.thumb then return rec.thumb end
if rec.copy and rec.copy.outfitId then return "rbxthumb://type=Outfit&id=" .. tostring(rec.copy.outfitId) .. "&w=420&h=420" end
local uid = (rec.copy and rec.copy.userId) or lp.UserId
return "rbxthumb://type=Avatar&id=" .. tostring(uid) .. "&w=420&h=420"
end
local function captureSkin(name)
local desc
if Sess.copy then desc = descFromCopy(Sess.copy) end
if not desc then
local hum = getHum()
if baseDesc then
desc = baseDesc
elseif hum then
local ok, d = pcall(function() return hum:GetAppliedDescription() end)
if ok then desc = d end
end
end
return {
id = tostring(os.time()) .. tostring(math.random(100, 999)), name = name, t = os.time(),
desc = desc and serDesc(desc) or nil, copy = deep(Sess.copy), items = deep(Sess.items), anim = deep(Sess.anim),
}
end
local function skinDesc(rec)
if rec.desc then return deserDesc(rec.desc) end
return descFromCopy(rec.copy)
end
local function applySkin(rec)
	report("Poniendo \"" .. tostring(rec.name) .. "\"…")
local desc = skinDesc(rec)
if desc then
local ok, how = fullCopy(desc)
if not ok then report("Falló: " .. tostring(how)) return end
else
removeAllApplied()
end
if rec.copy then Sess.copy = deep(rec.copy) end
local list = {}
for k, it in pairs(rec.items or {}) do list[#list + 1] = { key = k, it = it } end
table.sort(list, function(a, b) return a.key < b.key end)
for _, e in ipairs(list) do
local d = { key = e.key, kind = "catalog", id = e.it.id, name = e.it.name }
pcall(function()
local okP = prepareItem(d)
if okP then applyItem(d) end
end)
end
if rec.anim and next(rec.anim) ~= nil and env.XC_H.animApply then env.XC_H.animApply(rec.anim) end
Sess.skinId = rec.id
SessSave()
updateAll()
report("Skin puesta: " .. tostring(rec.name))
end
local function unapplySkin()
removeAllApplied()
if env.XC_H.animClear then env.XC_H.animClear() end
updateAll()
report("Tu avatar fue restaurado")
end
