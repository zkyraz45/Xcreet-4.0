}, vAnimBar)
local function vPaintChips()
for i, c in ipairs(vChips) do
local on = (i == vAnimIdx)
c.BackgroundColor3 = on and T.accent or T.white
c.BackgroundTransparency = on and 0.02 or 0.35
c.TextColor3 = on and T.white or T.text
end
end
local function vPlay(i)
vAnimTok = vAnimTok + 1
local tk = vAnimTok
vAnimIdx = i
vPaintChips()
vStopAnim()
local a = vAnimExtra and vAnimExtra.anims[i]
if not a or not vAnimRig then return end
vName.Text = tostring(a.name)
task.spawn(function()
local hum = vAnimRig:FindFirstChildOfClass("Humanoid")
if not hum then return end
local animator = hum:FindFirstChildOfClass("Animator")
if not animator then
animator = Instance.new("Animator")
animator.Parent = hum
end
for _, raw in ipairs(a.ids) do
local n = tostring(raw):match("%d+")
if n and tk == vAnimTok then
local anim = Instance.new("Animation")
anim.AnimationId = "rbxassetid://" .. n
local ok, tr = pcall(function() return animator:LoadAnimation(anim) end)
if ok and tr then
local t0 = os.clock()
while tr.Length == 0 and os.clock() - t0 < 2.5 do task.wait(0.1) end
if tk ~= vAnimTok then
pcall(function() tr:Destroy() end)
return
end
if tr.Length > 0 then
pcall(function() tr.Looped = true end)
pcall(function() tr.Priority = Enum.AnimationPriority.Action end)
tr:Play(0.1)
vAnimTrack = tr
return
end
pcall(function() tr:Destroy() end)
end
end
end
if tk == vAnimTok then toast("No pude mostrar esa animación en 3D · usa «Probar en mí»") end
end)
end
function viewerRefresh()
if vAnimExtra then return end
vAct2.Visible = false
if not vIsOn then vAct.Visible = false return end
vAct.Visible = true
local on = vIsOn()
vAct.Text = on and "Quitar" or "Poner"
vAct.BackgroundColor3 = on and T.red or T.green
end
track(vAct.Activated:Connect(function()
if vAnimExtra then
local e = vAnimExtra.act
if e and e.cb then task.spawn(safe, e.cb, vAnimExtra.anims[vAnimIdx], vAnimIdx) end
return
end
if not vToggle then return end
vAct.Text = "…"
vToggle(viewerRefresh)
end))
track(vAct2.Activated:Connect(function()
local e = vAnimExtra and vAnimExtra.act2
if e and e.cb then task.spawn(safe, e.cb, vAnimExtra.anims[vAnimIdx], vAnimIdx) end
end))
track(vOverlay.InputBegan:Connect(function(input)
if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
vdrag = true
local ch
ch = input.Changed:Connect(function()
if input.UserInputState == Enum.UserInputState.End then
vdrag = false
if ch then ch:Disconnect() end
end
end)
end
end))
track(UIS.InputChanged:Connect(function(input)
if vdrag and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
vyaw = vyaw - input.Delta.X * 0.012
vpitch = math.clamp(vpitch + input.Delta.Y * 0.01, -1.3, 1.3)
elseif viewer.open and input.UserInputType == Enum.UserInputType.MouseWheel then
vdist = math.clamp(vdist * (1 - input.Position.Z * 0.08), 0.4, 300)
end
end))
track(RunService.RenderStepped:Connect(function(dt)
if not viewer.open then return end
if not vdrag then vyaw = vyaw + dt * 0.9 end
vcam.CFrame = CFrame.new(vcenter) * CFrame.Angles(0, vyaw, 0) * CFrame.Angles(vpitch, 0, 0) * CFrame.new(0, 0, vdist)
end))
function openViewer(title, inst, assetId, isOn, toggle, thumbUrl, extra)
vStopAnim()
vAnimTok = vAnimTok + 1
vAnimExtra = (extra and extra.anims and #extra.anims > 0) and extra or nil
vAnimRig = nil
local animMode = vAnimExtra ~= nil
local dy = animMode and 44 or 0
viewer.root.Size = UDim2.fromOffset(300, 350 + dy)
vAnimBar.Visible = animMode
for _, z in ipairs(vZoom) do z[1].Position = UDim2.fromOffset(z[2], 310 + dy) end
vAct.Position = UDim2.fromOffset(94, 310 + dy)
vAct2.Position = UDim2.fromOffset(190, 310 + dy)
for _, c in ipairs(vChips) do pcall(function() c:Destroy() end) end
vChips = {}
if animMode then
vAct.Size = UDim2.fromOffset(92, 32)
vAct.Text = tostring(extra.act and extra.act.text or "Poner")
vAct.BackgroundColor3 = T.green
vAct.Visible = true
vAct2.Visible = extra.act2 ~= nil
vAct2.Text = tostring(extra.act2 and extra.act2.text or "")
vAnimIdx = 1
for i, a in ipairs(vAnimExtra.anims) do
local txt = tostring(a.label or a.name)
local chip = new("TextButton", {
Size = UDim2.fromOffset(math.max(56, #txt * 7 + 18), 26), BackgroundColor3 = T.white,
BackgroundTransparency = 0.35, Text = txt, Font = Enum.Font.GothamBold, TextSize = 11,
TextColor3 = T.text, AutoButtonColor = false, BorderSizePixel = 0, LayoutOrder = i,
}, vAnimBar)
circle(chip)
stroke(chip, 0.3, 1.2)
track(chip.Activated:Connect(function() vPlay(i) end))
vChips[i] = chip
end
vPaintChips()
else
vAct.Size = UDim2.new(1, -108, 0, 32)
vAct2.Visible = false
end
vTitle.Text = "Vista 3D"
vName.Text = tostring(title)
vIsOn, vToggle = isOn, toggle
vwm:ClearAllChildren()
vthumb.Visible = false
local part
if inst and (inst:IsA("Accessory") or inst:IsA("BasePart")) then
part = inst:IsA("Accessory") and inst:FindFirstChild("Handle") or inst
end
if part then
local c = part:Clone()
for _, d in ipairs(c:GetDescendants()) do
if d:IsA("Weld") or d:IsA("WeldConstraint") or d:IsA("Motor6D") or d:IsA("LuaSourceContainer") or d:IsA("TouchTransmitter") then
d:Destroy()
end
end
c.Anchored = true
c.CanCollide = false
c.CFrame = CFrame.new()
c.Parent = vwm
local s = c.Size
local m = math.max(s.X, s.Y, s.Z)
local center = Vector3.new()
local sm = c:FindFirstChildOfClass("SpecialMesh")
if sm then
m = m * math.max(1, sm.Scale.X, sm.Scale.Y, sm.Scale.Z)
center = sm.Offset
end
vcenter = center
vdist = math.clamp(m * 2.6, 3, 60)
elseif inst and inst:IsA("Model") then
for _, d in ipairs(inst:GetDescendants()) do
if d:IsA("LuaSourceContainer") or d:IsA("Sound") or d:IsA("ForceField") then
d:Destroy()
elseif d:IsA("BasePart") then
d.Anchored = true
d.CanCollide = false
elseif d:IsA("Humanoid") then
pcall(function() d.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None end)
end
end
if animMode then
for _, d in ipairs(inst:GetDescendants()) do
if d:IsA("BasePart") then d.Anchored = (d.Name == "HumanoidRootPart") end
end
vAnimRig = inst
end
pcall(function() inst:PivotTo(CFrame.new()) end)
inst.Parent = vwm
local okB, cf, size = pcall(function() return inst:GetBoundingBox() end)
if okB then
vcenter = cf.Position
vdist = math.clamp(math.max(size.X, size.Y, size.Z) * 1.9, 3, 150)
else
vcenter = Vector3.new(0, 2.5, 0)
vdist = 9
end
elseif assetId or thumbUrl then
vthumb.Image = thumbUrl or ("rbxthumb://type=Asset&id=" .. tostring(assetId) .. "&w=420&h=420")
vthumb.Visible = true
end
vyaw, vpitch = 0.6, 0.15
viewerRefresh()
if not viewer.open then
viewer.root.Position = win.root.Position
panelShow(viewer)
end
if animMode then vPlay(1) end
end
function viewMySkin()
local c = getChar()
if not c then toast("No hay personaje") return end
pcall(function() c.Archivable = true end)
local ok, clone = pcall(function() return c:Clone() end)
if not ok or not clone then
openViewer("Mi skin", nil, nil, nil, nil, "rbxthumb://type=Avatar&id=" .. tostring(lp.UserId) .. "&w=420&h=420")
return
end
openViewer("Mi skin", clone, nil, nil, nil)
end
end
local applyStyle, applyPreset
local Stk, Wheel, AnimAPI = {}, {}, {}
local decorChips -- se asigna en la pestaña Estilo
do
local function decorLayer(z)
return new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ZIndex = z, Visible = false }, win.holder)
end
local cuteBack, cuteFront = decorLayer(0), decorLayer(6)
local angelBack, angelFront = decorLayer(0), decorLayer(6)
local function floaty(parent, txt, x, y, size, delay)
local l = new("TextLabel", {
AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(x, y), Size = UDim2.fromOffset(size + 6, size + 6),
BackgroundTransparency = 1, Text = txt, TextSize = size, Font = Enum.Font.GothamBold, ZIndex = 3,
}, parent)
TweenService:Create(l, TweenInfo.new(1.8 + delay, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), {
Position = UDim2.fromOffset(x, y - 8),
}):Play()
end
do
local function ear(cx)
local o = new("Frame", {
AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(cx, 8), Size = UDim2.fromOffset(64, 64),
Rotation = 45, BackgroundColor3 = Color3.fromRGB(255, 170, 205), BorderSizePixel = 0, ZIndex = 1,
}, cuteBack)
corner(o, 18)
stroke(o, 0.1, 2, Color3.fromRGB(255, 255, 255))
local i = new("Frame", {
AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(0.55, 0.55),
BackgroundColor3 = Color3.fromRGB(255, 226, 240), BorderSizePixel = 0, ZIndex = 2,
}, o)
corner(i, 10)
end
ear(80)
ear(WIN_W - 80)
local function bowWing(rot, dx)
local w = new("Frame", {
AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, dx, 0, 5), Size = UDim2.fromOffset(32, 20),
Rotation = rot, BackgroundColor3 = Color3.fromRGB(255, 120, 170), BorderSizePixel = 0, ZIndex = 1,
}, cuteFront)
corner(w, 10)
stroke(w, 0.1, 1.5, Color3.fromRGB(255, 255, 255))
end
bowWing(-22, -17)
bowWing(22, 17)
local knot = new("Frame", {
AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0, 5), Size = UDim2.fromOffset(14, 14),
BackgroundColor3 = Color3.fromRGB(255, 80, 145), BorderSizePixel = 0, ZIndex = 3,
}, cuteFront)
circle(knot)
floaty(cuteFront, "✦", -14, 120, 22, 0.0)
floaty(cuteFront, "✧", WIN_W + 6, 110, 20, 0.4)
floaty(cuteFront, "◇", -12, 250, 22, 0.8)
floaty(cuteFront, "○", WIN_W + 8, 270, 22, 0.2)
floaty(cuteFront, "+", WIN_W - 40, WIN_H + 6, 18, 0.6)
floaty(cuteFront, "·", 50, WIN_H + 6, 18, 1.0)
end
do
local z = 0
local function wing(side)
local px = side < 0 and 6 or (WIN_W - 6)
local py = 150
local feathers = { { -28, 118 }, { -6, 134 }, { 16, 128 }, { 38, 112 }, { 60, 92 } }
for idx, f in ipairs(feathers) do
local a, len = math.rad(f[1]), f[2]
local dx, dy = side * math.cos(a), -math.sin(a)
z = z + 1
local fe = new("Frame", {
AnchorPoint = Vector2.new(0.5, 0.5),
Position = UDim2.fromOffset(px + dx * len / 2, py + dy * len / 2),
Size = UDim2.fromOffset(len, 28 - idx * 2),
Rotation = math.deg(math.atan2(dy, dx)),
BackgroundColor3 = Color3.fromRGB(255, 255, 255), BackgroundTransparency = 0.03,
BorderSizePixel = 0, ZIndex = z,
}, angelBack)
corner(fe, 14)
stroke(fe, 0.25, 1.2, Color3.fromRGB(240, 220, 160))
end
end
wing(-1)
wing(1)
local function cloud(cx, s)
local cy = WIN_H + 4
for _, c in ipairs({ { -20, 0, 36 }, { 0, -9, 48 }, { 20, 0, 36 } }) do
z = z + 1
local f = new("Frame", {
AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(cx + c[1] * s, cy + c[2] * s),
Size = UDim2.fromOffset(c[3] * s, c[3] * s), BackgroundColor3 = Color3.fromRGB(255, 255, 255),
BackgroundTransparency = 0.03, BorderSizePixel = 0, ZIndex = z,
}, angelBack)
circle(f)
end
end
cloud(70, 1)
cloud(WIN_W / 2 + 20, 0.8)
cloud(WIN_W - 70, 1.1)
local glow = new("Frame", {
AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 0, 6), Size = UDim2.fromOffset(132, 34),
BackgroundTransparency = 1, ZIndex = 1,
}, angelFront)
corner(glow, 17)
stroke(glow, 0.75, 10, Color3.fromRGB(255, 225, 120))
local halo = new("Frame", {
AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 0, 4), Size = UDim2.fromOffset(116, 26),
BackgroundTransparency = 1, ZIndex = 2,
}, angelFront)
corner(halo, 13)
stroke(halo, 0, 4, Color3.fromRGB(255, 205, 70))
for _, f in ipairs({ glow, halo }) do
local y0 = f.Position.Y.Offset
TweenService:Create(f, TweenInfo.new(2.2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), {
Position = UDim2.new(0.5, 0, 0, y0 - 5),
}):Play()
end
floaty(angelFront, "✧", -14, 90, 20, 0.0)
floaty(angelFront, "◇", WIN_W + 10, 80, 22, 0.5)
floaty(angelFront, "+", -12, 300, 18, 0.9)
floaty(angelFront, "✦", WIN_W + 6, 300, 20, 0.3)
floaty(angelFront, "○", WIN_W / 2 + 90, -22, 20, 0.7)
end
local function buildPattern(kind)
local pat = win.pattern
pat:ClearAllChildren()
if not kind or kind == "Ninguno" then return end
local rng = Random.new(11)
local white = Color3.fromRGB(255, 255, 255)
for i = 1, 30 do
local x, y = rng:NextNumber(0.02, 0.98), rng:NextNumber(0.02, 0.98)
if kind == "Puntitos" then
local s = rng:NextInteger(4, 10)
local f = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(x, y), Size = UDim2.fromOffset(s, s), BackgroundColor3 = white, BorderSizePixel = 0 }, pat)
circle(f)
elseif kind == "Brillitos" then
local s = rng:NextInteger(6, 13)
new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(x, y), Size = UDim2.fromOffset(s, s), Rotation = 45, BackgroundColor3 = white, BorderSizePixel = 0 }, pat)
elseif kind == "Burbujas" then
local s = rng:NextInteger(14, 42)
local f = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(x, y), Size = UDim2.fromOffset(s, s), BackgroundTransparency = 0.7, BackgroundColor3 = white, BorderSizePixel = 0 }, pat)
circle(f)
stroke(f, 0, 2, white)
elseif kind == "Corazones" then
local s = rng:NextInteger(7, 13)
local box = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(x, y), Size = UDim2.fromOffset(s * 3, s * 3), BackgroundTransparency = 1 }, pat)
local sq = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(s * 1.5, s * 1.5), Size = UDim2.fromOffset(s, s), Rotation = 45, BackgroundColor3 = white, BorderSizePixel = 0 }, box)
for _, dx in ipairs({ -0.354, 0.354 }) do
local c = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(s * 1.5 + dx * s, s * 1.5 - 0.354 * s), Size = UDim2.fromOffset(s, s), BackgroundColor3 = white, BorderSizePixel = 0 }, box)
circle(c)
end
end
end
end
local wallTok = 0
local function setWallpaper(id, alpha)
wallTok = wallTok + 1
local tk = wallTok
local w = win.wall
if id and id ~= "" then
w.ImageTransparency = 1 - math.clamp((alpha or 6) / 10, 0.05, 1)
w.Image = "rbxassetid://" .. id
w.Visible = true
task.spawn(function()
local t0 = os.clock()
while os.clock() - t0 < 4 and not w.IsLoaded do task.wait(0.2) end
if tk == wallTok and not w.IsLoaded then
w.Image = "rbxthumb://type=Asset&id=" .. id .. "&w=420&h=420"
end
end)
else
w.Visible = false
w.Image = ""
end
end
do
local stkBack = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ZIndex = 0 }, win.holder)
local stkFront = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ZIndex = 8 }, win.holder)
local nodes, sel, editMode = {}, 0, false
local stkOn = not Style.stkOff
local function loadImg(lbl, id)
local clean = tostring(id):gsub("%D", "")
if clean == "" then return end
lbl.Image = "rbxassetid://" .. clean
task.spawn(function()
local t0 = os.clock()
while os.clock() - t0 < 4 and lbl.Parent and not lbl.IsLoaded do task.wait(0.25) end
if lbl.Parent and not lbl.IsLoaded then
lbl.Image = "rbxthumb://type=Asset&id=" .. clean .. "&w=420&h=420"
end
end)
end
local function pick(i)
sel = i
for k, n in pairs(nodes) do
local on = (k == sel) and editMode
n.stroke.Enabled = editMode
n.stroke.Transparency = on and 0 or 0.7
n.stroke.Color = on and T.accent or Color3.fromRGB(255, 255, 255)
end
if Stk.onSelect then pcall(Stk.onSelect, sel, Style.stickers[sel]) end
end
local render
render = function()
for _, n in pairs(nodes) do pcall(function() n.f:Destroy() end) end
nodes = {}
local list = Style.stickers
if type(list) ~= "table" then Style.stickers = {} list = Style.stickers end
stkBack.Visible, stkFront.Visible = stkOn, stkOn
if sel > #list then sel = #list end
for i, st in ipairs(list) do
local size = st.s or 48
local hit = math.max(size, 30)
local f = new("Frame", {
AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(st.x or 0, st.y or 0),
Size = UDim2.fromOffset(hit, hit), BackgroundTransparency = 1, Rotation = st.r or 0,
Active = editMode, ZIndex = 10 + i,
}, st.back and stkBack or stkFront)
local sk = new("UIStroke", {
Thickness = 1.5, Color = Color3.fromRGB(255, 255, 255), Transparency = 0.7,
ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Enabled = editMode,
}, f)
if st.k == "img" then
local im = new("ImageLabel", {
AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
Size = UDim2.fromOffset(size, size), BackgroundTransparency = 1,
ScaleType = Enum.ScaleType.Fit, ImageTransparency = st.a or 0, ZIndex = 11 + i,
}, f)
if st.url then im.Image = st.url else loadImg(im, st.v) end
else
new("TextLabel", {
AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
Size = UDim2.fromOffset(size, size), BackgroundTransparency = 1, Text = tostring(st.v or "✦"),
TextScaled = true, Font = Enum.Font.GothamBold, TextTransparency = st.a or 0, ZIndex = 11 + i,
}, f)
end
nodes[i] = { f = f, stroke = sk }
track(f.InputBegan:Connect(function(input)
if not editMode then return end
local ut = input.UserInputType
if ut ~= Enum.UserInputType.MouseButton1 and ut ~= Enum.UserInputType.Touch then return end
pick(i)
local start, ox, oy = input.Position, st.x or 0, st.y or 0
local sc = math.max(win.holder.AbsoluteSize.X / WIN_W, 0.2)
local mv, en
mv = UIS.InputChanged:Connect(function(inp)
if inp == input or (ut == Enum.UserInputType.MouseButton1 and inp.UserInputType == Enum.UserInputType.MouseMovement) then
local d = inp.Position - start
st.x = math.clamp(ox + d.X / sc, -80, WIN_W + 80)
st.y = math.clamp(oy + d.Y / sc, -80, WIN_H + 80)
f.Position = UDim2.fromOffset(st.x, st.y)
end
end)
en = input.Changed:Connect(function()
if input.UserInputState == Enum.UserInputState.End then
mv:Disconnect()
en:Disconnect()
saveStyle()
end
end)
end))
end
pick(sel)
end
local function cur()
local st = Style.stickers[sel]
if not st then toast("Activa «Modo mover» y toca una pegatina") end
return st
end
local function addRaw(kind, v, x, y, s, extra)
local list = Style.stickers
local st = {
k = kind, v = v, s = s or 48, r = 0, a = 0, back = false,
x = x or (WIN_W / 2 + math.random(-150, 150)), y = y or (WIN_H / 2 + math.random(-90, 90)),
}
if extra then for k, vv in pairs(extra) do st[k] = vv end end
list[#list + 1] = st
if #list > 80 then table.remove(list, 1) end
sel = #list
end
function Stk.add(kind, v, extra)
addRaw(kind, v, nil, nil, nil, extra)
render()
saveStyle()
end
function Stk.render() render() end
function Stk.edit(on) editMode = on and true or false render() end
function Stk.show(on)
stkOn = on and true or false
Style.stkOff = not stkOn
render()
saveStyle()
end
function Stk.remove()
if not cur() then return end
table.remove(Style.stickers, sel)
render()
saveStyle()
end
function Stk.clear()
Style.stickers = {}
sel = 0
render()
saveStyle()
end
function Stk.dup()
local st = cur()
if not st then return end
local c = {}
for k, v in pairs(st) do c[k] = v end
c.x, c.y = (c.x or 0) + 18, (c.y or 0) + 18
Style.stickers[#Style.stickers + 1] = c
sel = #Style.stickers
render()
saveStyle()
end
function Stk.size(d)
local st = cur()
if not st then return end
st.s = math.clamp((st.s or 48) + d, 12, 240)
render()
saveStyle()
end
function Stk.rot(d)
local st = cur()
if not st then return end
st.r = ((st.r or 0) + d) % 360
render()
saveStyle()
end
function Stk.alpha(d)
local st = cur()
if not st then return end
st.a = math.clamp((st.a or 0) + d, 0, 0.9)
render()
saveStyle()
end
function Stk.layer()
local st = cur()
if not st then return end
st.back = not st.back
render()
saveStyle()
toast(st.back and "Ahora está detrás del menú" or "Ahora está delante del menú")
end
function Stk.next()
local n = #Style.stickers
if n == 0 then toast("No hay pegatinas") return end
sel = sel % n + 1
pick(sel)
end
local W, H = WIN_W, WIN_H
local PACKS = {
{ "Constelación", { { "✦", 30, 16, 30, 0 }, { "✧", W - 24, 24, 22, 0 }, { "·", W + 8, 150, 26, 0 }, { "✦", 8, 190, 18, 0 }, { "✧", W - 40, H - 8, 24, 0 }, { "·", 44, H - 6, 26, 0 } } },
{ "Geométrico", { { "◇", 24, 18, 28, 0 }, { "○", W - 24, 18, 26, 0 }, { "△", 8, 170, 22, 0 }, { "□", W + 4, 210, 20, 15 }, { "◇", W - 36, H - 6, 24, 0 }, { "○", 36, H - 6, 20, 0 } } },
{ "Marco", { { "┌", 16, 14, 30, 0 }, { "┐", W - 16, 14, 30, 0 }, { "└", 16, H - 14, 30, 0 }, { "┘", W - 16, H - 14, 30, 0 } } },
{ "Líneas", { { "─", W / 2, -4, 56, 0 }, { "─", W / 2, H + 4, 56, 0 }, { "│", -2, H / 2, 44, 0 }, { "│", W + 2, H / 2, 44, 0 } } },
