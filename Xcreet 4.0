local DG_errs, DG_lbl = {}, nil
local function DG_Fail(where, err)
local msg = "[" .. tostring(where) .. "] " .. tostring(err)
DG_errs[#DG_errs + 1] = msg
warn("[Xcreet] ERROR " .. msg)
	pcall(function() ((getgenv and getgenv()) or _G).DG_LastError = table.concat(DG_errs, "\n") end)
pcall(function()
if not (DG_lbl and DG_lbl.Parent) then
local g = Instance.new("ScreenGui")
g.Name = "DG_Error"
g.ResetOnSpawn = false
g.DisplayOrder = 2000
local okp = pcall(function() g.Parent = (gethui and gethui()) or game:GetService("CoreGui") end)
if not okp or not g.Parent then
g.Parent = game:GetService("Players").LocalPlayer:WaitForChild("PlayerGui")
end
local f = Instance.new("Frame")
f.AnchorPoint = Vector2.new(0.5, 0)
f.Position = UDim2.new(0.5, 0, 0, 10)
f.Size = UDim2.new(0.92, 0, 0, 190)
f.BackgroundColor3 = Color3.fromRGB(70, 20, 40)
f.BackgroundTransparency = 0.05
f.BorderSizePixel = 0
f.Parent = g
local uc = Instance.new("UICorner")
uc.CornerRadius = UDim.new(0, 10)
uc.Parent = f
local t = Instance.new("TextLabel")
t.BackgroundTransparency = 1
t.Position = UDim2.fromOffset(10, 8)
t.Size = UDim2.new(1, -20, 1, -50)
t.TextWrapped = true
t.TextXAlignment = Enum.TextXAlignment.Left
t.TextYAlignment = Enum.TextYAlignment.Top
t.Font = Enum.Font.Code
t.TextSize = 12
t.TextColor3 = Color3.fromRGB(255, 225, 235)
t.Text = ""
t.Parent = f
local function btn(txt, x, cb)
local b = Instance.new("TextButton")
b.Size = UDim2.fromOffset(120, 30)
b.Position = UDim2.new(1, x, 1, -38)
b.BackgroundColor3 = Color3.fromRGB(255, 122, 175)
b.TextColor3 = Color3.new(1, 1, 1)
b.Font = Enum.Font.GothamBold
b.TextSize = 12
b.Text = txt
b.BorderSizePixel = 0
b.Parent = f
local c2 = Instance.new("UICorner")
c2.CornerRadius = UDim.new(0, 8)
c2.Parent = b
b.Activated:Connect(cb)
end
btn("Copiar error", -260, function()
local cp = setclipboard or toclipboard or set_clipboard
				if cp then pcall(cp, table.concat(DG_errs, "\n")) end
end)
btn("Cerrar", -130, function() g:Destroy() end)
DG_lbl = t
end
		local all = "Xcreet · error:\n" .. table.concat(DG_errs, "\n")
DG_lbl.Text = all:sub(1, 1100)
end)
end
