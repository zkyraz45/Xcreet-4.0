{ "Destellos", { { "✦", 18, 16, 44, 0 }, { "✦", W - 18, 16, 30, 0 }, { "✧", W + 6, 170, 26, 0 }, { "✧", 6, 210, 22, 0 }, { "✦", W - 30, H - 6, 26, 0 } } },
{ "Lunar", { { "☾", 26, 20, 34, 0 }, { "✦", W - 24, 22, 22, 0 }, { "·", 8, 160, 24, 0 }, { "✧", W + 4, 200, 20, 0 } } },
}
Stk.packNames = {}
for i, p in ipairs(PACKS) do Stk.packNames[i] = p[1] end
function Stk.pack(i)
local p = PACKS[i]
if not p then return end
for _, it in ipairs(p[2]) do
addRaw("emoji", it[1], it[2], it[3], it[4])
Style.stickers[#Style.stickers].r = it[5] or 0
end
render()
saveStyle()
toast("Paquete «" .. p[1] .. "» añadido")
end
end
function applyStyle()
for _, p in ipairs(panelsList) do
p.grad.Color = ColorSequence.new(c3(Style.g1), c3(Style.g2))
p.blobs[1].BackgroundColor3 = c3(Style.b1)
p.blobs[2].BackgroundColor3 = c3(Style.b2)
p.stroke.Color = c3(Style.stroke)
p.glass.BackgroundTransparency = 0.26 + (Style.glassT or 0) * 0.06
end
setAccent(c3(Style.accent))
for _, l in ipairs({ cuteBack, cuteFront, angelBack, angelFront }) do l.Visible = false end
if Style.decor == "cute" then
cuteBack.Visible, cuteFront.Visible = true, true
elseif Style.decor == "angel" then
angelBack.Visible, angelFront.Visible = true, true
end
buildPattern(Style.pattern)
setWallpaper(Style.wallId, Style.wallAlpha)
pcall(Stk.render)
pcall(Wheel.sync)
saveStyle()
end
function applyPreset(i)
local p = PRESETS[i]
if not p then return end
Style.preset = i
Style.g1, Style.g2 = p.g[1], p.g[2]
Style.b1, Style.b2 = p.b[1], p.b[2]
Style.stroke = p.stroke
Style.accent = p.accent
Style.decor = p.decor
if decorChips then decorChips.Set(({ none = 1, cute = 2, angel = 3 })[p.decor] or 1, true) end
applyStyle()
end
end
