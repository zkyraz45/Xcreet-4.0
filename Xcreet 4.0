Section(P10, "Mi personaje (solo tú lo ves)")
local fxIdx, fxObjs = 1, {}
local function fxClear()
for _, o in ipairs(fxObjs) do pcall(function() o:Destroy() end) end
fxObjs = {}
end
local function fxApply(i)
fxIdx = i
fxClear()
local root = getRoot()
if not root or i == 1 then return end
local function add(o)
o.Parent = root
fxObjs[#fxObjs + 1] = o
return o
end
if i == 2 then
local s = Instance.new("Sparkles")
s.SparkleColor = T.accent
add(s)
elseif i == 3 then
local f = Instance.new("Fire")
f.Size = 5
f.Heat = 6
f.Color = T.accent
f.SecondaryColor = T.purple
add(f)
elseif i == 4 then
local s = Instance.new("Smoke")
s.Size = 6
s.Opacity = 0.35
s.Color = T.white
add(s)
elseif i == 5 then
local l = Instance.new("PointLight")
l.Color = T.accent
l.Range = 20
l.Brightness = 2.5
add(l)
else
local a0 = Instance.new("Attachment")
a0.Position = Vector3.new(0, 1.2, 0)
add(a0)
local a1 = Instance.new("Attachment")
a1.Position = Vector3.new(0, -1.2, 0)
add(a1)
local tr = Instance.new("Trail")
tr.Attachment0, tr.Attachment1 = a0, a1
tr.Lifetime = 0.7
tr.LightEmission = 0.6
tr.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(1, 1) })
if i == 6 then
tr.Color = ColorSequence.new(T.accent, T.purple)
else
tr.Color = ColorSequence.new({
ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 90, 120)), ColorSequenceKeypoint.new(0.35, Color3.fromRGB(255, 220, 90)),
ColorSequenceKeypoint.new(0.7, Color3.fromRGB(110, 230, 160)), ColorSequenceKeypoint.new(1, Color3.fromRGB(130, 150, 255)),
})
end
add(tr)
end
end
Chips(P10, { "Ninguno", "Brillos", "Fuego", "Humo", "Luz", "Estela", "Arcoíris" }, 84, function(i) fxApply(i) end, 1)
local skinCols = {
false, Color3.fromRGB(255, 205, 220), Color3.fromRGB(205, 185, 255), Color3.fromRGB(190, 235, 215),
Color3.fromRGB(245, 215, 140), Color3.fromRGB(190, 190, 200), Color3.fromRGB(150, 205, 255),
}
local skinOrig, skinOrigBC, skinIdx = {}, {}, 1
local BC_PROPS = { "HeadColor3", "TorsoColor3", "LeftArmColor3", "RightArmColor3", "LeftLegColor3", "RightLegColor3" }
local function skinApply(i)
skinIdx = i
local ch = getChar()
if not ch then return end
local col = skinCols[i] or nil
local bc = ch:FindFirstChildOfClass("BodyColors")
for _, p in ipairs(ch:GetChildren()) do
if p:IsA("BasePart") and p.Name ~= "HumanoidRootPart" then
if skinOrig[p] == nil then skinOrig[p] = p.Color end
p.Color = col or skinOrig[p]
end
end
if bc then
for _, prop in ipairs(BC_PROPS) do
pcall(function()
if skinOrigBC[prop] == nil then skinOrigBC[prop] = bc[prop] end
bc[prop] = col or skinOrigBC[prop]
end)
end
end
end
Note(P10, "Color del cuerpo")
Chips(P10, { "Normal", "Rosa", "Lila", "Menta", "Dorado", "Gris", "Cielo" }, 76, function(i) skinApply(i) end, 1)
local scaleOrig = {}
local function setScale(vname, v)
local hum = getHum()
local nv = hum and hum:FindFirstChild(vname)
if nv and nv:IsA("NumberValue") then
if scaleOrig[vname] == nil then scaleOrig[vname] = nv.Value end
nv.Value = v / 10
else
toast("Tu personaje no tiene escalas (¿es R6?)")
end
end
Stepper(P10, "Altura (10 = normal)", 5, 20, 1, 10, "", function(v) setScale("BodyHeightScale", v) end)
Stepper(P10, "Anchura", 5, 20, 1, 10, "", function(v) setScale("BodyWidthScale", v) end)
Stepper(P10, "Cabeza", 3, 30, 1, 10, "", function(v) setScale("HeadScale", v) end)
local function restoreScale()
local hum = getHum()
if not hum then return end
for vname, v in pairs(scaleOrig) do
local nv = hum:FindFirstChild(vname)
if nv then pcall(function() nv.Value = v end) end
end
end
Button(P10, "Restaurar tamaño", T.text, function() restoreScale() toast("Tamaño restaurado") end)
track(lp.CharacterAdded:Connect(function()
skinOrig, skinOrigBC, scaleOrig = {}, {}, {}
task.wait(1.5)
if fxIdx > 1 then fxApply(fxIdx) end
if skinIdx > 1 then skinApply(skinIdx) end
end))
Section(P10, "Música (solo tú la oyes)")
local SoundService = game:GetService("SoundService")
local snd = Instance.new("Sound")
snd.Name = "XcreetMusic"
snd.Volume = 0.5
snd.Looped = true
snd.Parent = SoundService
InputRow(P10, "ID de audio", "Reproducir", function(txt)
local id = tostring(txt or ""):match("%d+")
if not id then toast("Escribe un ID de audio") return end
snd:Stop()
snd.SoundId = "rbxassetid://" .. id
snd:Play()
toast("Reproduciendo " .. id .. " (si no suena, ese audio no está permitido)")
end)
ButtonRow(P10, {
{ "Pausar", T.text, function() snd:Pause() end },
{ "Seguir", T.accent, function() snd:Resume() end },
{ "Parar", T.red, function() snd:Stop() end },
})
Stepper(P10, "Volumen", 0, 10, 1, 5, "", function(v) snd.Volume = v / 10 end)
Toggle(P10, "Repetir", nil, true, function(v) snd.Looped = v end)
Section(P10, "Interfaz")
Note(P10, "Juego: " .. (GAME.name ~= "" and GAME.name or "desconocido") .. (GAME.evade and " (modo Evade activo)" or " (modo universal)"))
Toggle(P10, "Forzar modo Evade", "Muestra la pestaña Evade en cualquier juego (al volver a ejecutar)", Style.evadeForce == true, function(v)
Style.evadeForce = v
saveStyle()
end)
Toggle(P10, "Animación de carga", "Se muestra al ejecutar", Style.loadAnim ~= false, function(v)
Style.loadAnim = v
saveStyle()
end)
Button(P10, "Ver animación de carga", T.accent, function() env.DG_Loader({}) end)
Toggle(P10, "Restaurar sesión al ejecutar", "Animaciones, ropa, accesorios y gráficos", Sess.auto ~= false, function(v)
Sess.auto = v
SessSave()
end)
Button(P10, "Olvidar sesión guardada", T.red, function()
Sess.anim, Sess.items, Sess.gfx, Sess.ev, Sess.copy = {}, {}, {}, {}, nil
SessSave()
toast("Sesión guardada borrada")
end)
Stepper(P10, "Tamaño del menú (10 = normal)", 6, 14, 1, math.floor((Style.uiScale or 1) * 10 + 0.5), "", function(v)
Style.uiScale = v / 10
updateFit()
saveStyle()
end)
Stepper(P10, "Desenfoque del fondo", 0, 40, 2, Style.blur or 14, "", function(v)
Style.blur = v
saveStyle()
if win.open then blurSet(true) end
end)
Stepper(P10, "Transparencia del cristal", 0, 8, 1, Style.glassT or 0, "", function(v)
Style.glassT = v
applyStyle()
end)
Toggle(P10, "Ocultar interfaz del juego", "Chat, lista y botones de Roblox", false, function(v)
pcall(function() game:GetService("StarterGui"):SetCoreGuiEnabled(Enum.CoreGuiType.All, not v) end)
end)
Button(P10, "Modo foto (oculta el menú 5 s)", T.accent, function()
gui.Enabled = false
task.delay(5, function() gui.Enabled = true end)
end)
tabHooks[10] = function()
refreshPlayers()
refreshPoints()
refreshInfo()
end
cleanup[#cleanup + 1] = function()
clicking, spinOn, autoJump, antiVoid, espOn, clickTp = false, false, false, false, false, false
clearMarks()
pcall(stopSpectate)
fxClear()
pcall(skinApply, 1)
pcall(restoreScale)
pcall(function() snd:Destroy() end)
pcall(function() game:GetService("StarterGui"):SetCoreGuiEnabled(Enum.CoreGuiType.All, true) end)
Workspace.Gravity = origGrav
Lighting.ClockTime, Lighting.FogEnd, Lighting.GlobalShadows = orig.clock, orig.fog, orig.shadows
lp.CameraMinZoomDistance, lp.CameraMaxZoomDistance = origZoom[1], origZoom[2]
end
env.DG_Cleanups = cleanup
end)
if not okP then DG_Fail("Pestaña Extra", eP) end
end
do
local okP, eP = pcall(function()
local P11 = pages[11]
local H = env.XC_H
H.restore = {}
H.PT = function(page, title, desc, key, cb)
local obj = Toggle(page, title, desc, false, function(v)
Sess.ev[key] = v
SessSave()
cb(v)
end)
H.restore[#H.restore + 1] = function() if Sess.ev[key] then obj.Set(true) end end
return obj
end
H.PS = function(page, title, mn, mx, step, key, def, suffix, cb)
local v0 = tonumber(Sess.ev[key]) or def
local obj = Stepper(page, title, mn, mx, step, v0, suffix or "", function(v)
Sess.ev[key] = v
SessSave()
cb(v)
end)
pcall(cb, v0)
return obj
end
H.ev = function()
if Sess.auto == false then return end
for _, f in ipairs(H.restore) do pcall(f) end
end
local VIM
pcall(function() VIM = game:GetService("VirtualInputManager") end)
local VK = { C = 0x43, LeftControl = 0xA2, X = 0x58, Q = 0x51, Space = 0x20, E = 0x45, LeftShift = 0xA0, F = 0x46 }
H.sim = {}
H.keyDown = function(kc, down)
H.sim[kc.Name] = down and (os.clock() + 60) or nil
local ok = VIM and pcall(function() VIM:SendKeyEvent(down, kc, false, game) end)
if not ok then
local f = down and keypress or keyrelease
if f then pcall(f, VK[kc.Name] or 0) end
end
end
H.keyTap = function(kc, hold)
task.spawn(function()
H.keyDown(kc, true)
task.wait(hold or 0.05)
H.keyDown(kc, false)
end)
end
H.devMode = tonumber(Sess.ev.devmode) or 0
H.dev = function()
if H.devMode == 1 then return "pc" end
if H.devMode == 2 then return "movil" end
if UIS.TouchEnabled and not UIS.KeyboardEnabled then return "movil" end
if UIS.GamepadEnabled and not UIS.KeyboardEnabled and not UIS.TouchEnabled then return "consola" end
return "pc"
end
H.devName = function()
local d = H.dev()
return (d == "movil" and "móvil") or (d == "consola" and "mando") or "PC"
end
H.drag = function(frame, key, locked, onTap, default)
Sess.ev.pos = Sess.ev.pos or {}
local sp = Sess.ev.pos[key]
if sp then frame.Position = UDim2.fromScale(sp[1], sp[2]) else frame.Position = default end
frame.InputBegan:Connect(function(input)
local t = input.UserInputType
if t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch then
H.dragActive = {
frame = frame, key = key, locked = locked, onTap = onTap, input = input, mouse = (t == Enum.UserInputType.MouseButton1),
start = Vector2.new(input.Position.X, input.Position.Y), origin = frame.AbsolutePosition, moved = false,
}
end
end)
end
track(UIS.InputChanged:Connect(function(input)
local a = H.dragActive
if not a then return end
local t = input.UserInputType
if not ((a.mouse and t == Enum.UserInputType.MouseMovement) or (not a.mouse and input == a.input)) then return end
local d = Vector2.new(input.Position.X, input.Position.Y) - a.start
if d.Magnitude > 7 then a.moved = true end
if a.moved and not a.locked() then
local sg = a.frame:FindFirstAncestorOfClass("ScreenGui") or gui
local sz, fs = sg.AbsoluteSize, a.frame.AbsoluteSize
local np = a.origin + d
np = Vector2.new(math.clamp(np.X, 0, math.max(0, sz.X - fs.X)), math.clamp(np.Y, 0, math.max(0, sz.Y - fs.Y)))
a.frame.Position = UDim2.fromOffset(np.X, np.Y)
end
end))
track(UIS.InputEnded:Connect(function(input)
local a = H.dragActive
if not a then return end
if input == a.input or (a.mouse and input.UserInputType == Enum.UserInputType.MouseButton1) then
H.dragActive = nil
if a.moved then
if not a.locked() then
local sg = a.frame:FindFirstAncestorOfClass("ScreenGui") or gui
local sz, ap = sg.AbsoluteSize, a.frame.AbsolutePosition
Sess.ev.pos[a.key] = { ap.X / math.max(1, sz.X), ap.Y / math.max(1, sz.Y) }
SessSave()
end
elseif a.onTap then
task.spawn(safe, a.onTap)
end
end
end))
H.resetPos = function(prefix)
for k in pairs(Sess.ev.pos or {}) do
if k:sub(1, #prefix) == prefix then Sess.ev.pos[k] = nil end
end
SessSave()
end
H.mobMethod = tonumber(Sess.ev.mobmethod) or 1
local function resolvePath(path)
local pg = lp:FindFirstChildOfClass("PlayerGui")
if not (pg and path) then return nil end
local rest = tostring(path):match("PlayerGui%.(.+)$")
if not rest then return nil end
local node = pg
for seg in rest:gmatch("[^%.]+") do
node = node and node:FindFirstChild(seg)
end
return node
end
local function findMobBtn()
if H.mobBtn and H.mobBtn.Parent then return H.mobBtn end
local b = resolvePath(Sess.ev.mobBtn)
if b and b:IsA("GuiButton") then H.mobBtn = b return b end
local pg = lp:FindFirstChildOfClass("PlayerGui")
if not pg then return nil end
for _, d in ipairs(pg:GetDescendants()) do
if d:IsA("GuiButton") then
local nm = (d.Name .. " " .. ((d:IsA("TextButton") and d.Text) or "") .. " " .. (d.Parent and d.Parent.Name or "")):lower()
if nm:find("crouch", 1, true) or nm:find("agach", 1, true) or nm:find("slide", 1, true) or nm:find("duck", 1, true) then
H.mobBtn = d
return d
end
end
end
return nil
end
local function guiPress(btn, down)
local ok = false
if H.mobMethod == 1 and firesignal then
ok = pcall(firesignal, down and btn.MouseButton1Down or btn.MouseButton1Up)
if not down then
pcall(firesignal, btn.MouseButton1Click)
pcall(firesignal, btn.Activated)
end
end
if not ok and VIM then
local p = btn.AbsolutePosition + btn.AbsoluteSize / 2
ok = pcall(function() VIM:SendTouchEvent(913, down and 0 or 2, p.X, p.Y + 36) end)
end
return ok
end
H.crouchDown = function(keyName, on)
if H.dev() == "movil" then
local b = findMobBtn()
if b and guiPress(b, on) then return end
end
H.keyDown(Enum.KeyCode[keyName] or Enum.KeyCode.C, on)
end
H.crouchTap = function(keyName, hold)
if H.dev() == "movil" then
local b = findMobBtn()
if b then
task.spawn(function()
guiPress(b, true)
task.wait(hold or 0.03)
guiPress(b, false)
end)
return
end
end
H.keyTap(Enum.KeyCode[keyName] or Enum.KeyCode.C, hold)
end
Section(P11, "Datos en pantalla")
local hudF = new("Frame", {
AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -12, 0, 12), Size = UDim2.fromOffset(150, 0),
AutomaticSize = Enum.AutomaticSize.Y, BackgroundColor3 = Color3.fromRGB(12, 12, 14), BackgroundTransparency = 0.4,
BorderSizePixel = 0, Visible = false,
}, gui)
corner(hudF, 8)
new("UIPadding", { PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8), PaddingTop = UDim.new(0, 6), PaddingBottom = UDim.new(0, 6) }, hudF)
local hudT = label(hudF, {
Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Font = Enum.Font.Code, TextSize = 11,
TextColor3 = Color3.fromRGB(240, 240, 244), TextWrapped = true, TextTruncate = Enum.TextTruncate.None,
})
local hudOpt = { fps = false, ping = false, speed = false, pos = false }
local hudAcc, fpsEma, topSpeed = 0, 60, 0
H.speedNow = 0
track(RunService.Heartbeat:Connect(function(dt)
dt = tonumber(dt) or 0.016
if dt > 0 then fpsEma = fpsEma + ((1 / dt) - fpsEma) * math.min(1, dt * 3) end
local root = getRoot()
if root then
local v = root.AssemblyLinearVelocity
H.speedNow = Vector3.new(v.X, 0, v.Z).Magnitude
if H.speedNow > topSpeed then topSpeed = H.speedNow end
end
hudAcc = hudAcc + dt
if hudAcc < 0.15 then return end
hudAcc = 0
if not (hudOpt.fps or hudOpt.ping or hudOpt.speed or hudOpt.pos) then hudF.Visible = false return end
local lines = {}
if hudOpt.fps then lines[#lines + 1] = "FPS    " .. math.floor(fpsEma + 0.5) end
if hudOpt.ping then
local ok, p = pcall(function() return game:GetService("Stats").Network.ServerStatsItem["Data Ping"]:GetValue() end)
lines[#lines + 1] = "PING   " .. ((ok and type(p) == "number") and (math.floor(p + 0.5) .. " ms") or "--")
end
if hudOpt.speed then
lines[#lines + 1] = string.format("VEL    %.1f", H.speedNow)
lines[#lines + 1] = string.format("MAX    %.1f", topSpeed)
end
if hudOpt.pos and root then
local p = root.Position
lines[#lines + 1] = string.format("POS    %d %d %d", p.X, p.Y, p.Z)
end
	hudT.Text = table.concat(lines, "\n")
hudF.Visible = true
end))
H.hudOpt = hudOpt
H.PT(P11, "FPS", nil, "hud_fps", function(v) hudOpt.fps = v end)
H.PT(P11, "Ping", nil, "hud_ping", function(v) hudOpt.ping = v end)
H.PT(P11, "Velocidad", "Horizontal, con el máximo alcanzado", "hud_speed", function(v) hudOpt.speed = v if v then topSpeed = 0 end end)
H.PT(P11, "Posición", nil, "hud_pos", function(v) hudOpt.pos = v end)
Button(P11, "Reiniciar máximo", T.text, function() topSpeed = 0 end)
Section(P11, "Visión")
local xrayOn, xrayLvl, xrayParts, xrayTk = false, 6, {}, 0
local function xrayOne(p)
if p:IsA("BasePart") and not p:IsA("Terrain") and p.Anchored and p.Transparency < 0.6 then
local m = p.Parent
if m and m:FindFirstChildOfClass("Humanoid") then return end
xrayParts[p] = true
p.LocalTransparencyModifier = xrayLvl / 10
end
end
local function xrayApply()
xrayTk = xrayTk + 1
local tk = xrayTk
if not xrayOn then
for p in pairs(xrayParts) do pcall(function() p.LocalTransparencyModifier = 0 end) end
xrayParts = {}
return
end
task.spawn(function()
local n = 0
for _, p in ipairs(Workspace:GetDescendants()) do
if tk ~= xrayTk then return end
pcall(xrayOne, p)
n = n + 1
if n % 500 == 0 then task.wait() end
end
end)
end
track(Workspace.DescendantAdded:Connect(function(p) if xrayOn then pcall(xrayOne, p) end end))
H.PT(P11, "Rayos X", "Vuelve semitransparentes las paredes", "xray", function(v) xrayOn = v xrayApply() end)
H.PS(P11, "Transparencia (Rayos X)", 2, 9, 1, "xray_lvl", 6, "", function(v) xrayLvl = v if xrayOn then xrayApply() end end)
local objKw, objOn, objMarks = "", false, {}
local function objClear()
for _, m in pairs(objMarks) do pcall(function() m:Destroy() end) end
objMarks = {}
end
local function objScan()
objClear()
if not objOn or objKw == "" then return end
local n = 0
for _, d in ipairs(Workspace:GetDescendants()) do
if (d:IsA("Model") or d:IsA("BasePart")) and d.Name:lower():find(objKw, 1, true) then
local par = d.Parent
if not (par and par:IsA("Model") and par.Name:lower():find(objKw, 1, true)) and not Players:GetPlayerFromCharacter(d) then
n = n + 1
if n > 80 then break end
objMarks[d] = new("Highlight", {
Adornee = d, FillColor = T.accent, OutlineColor = Color3.new(1, 1, 1), FillTransparency = 0.6,
DepthMode = Enum.HighlightDepthMode.AlwaysOnTop,
}, gui)
end
end
end
toast(n .. " objetos marcados")
end
InputRow(P11, "Palabra del objeto (ej: ticket, coin, chest)", "Buscar", function(txt)
objKw = tostring(txt or ""):lower():gsub("^%s+", ""):gsub("%s+$", "")
objOn = objKw ~= ""
objScan()
end)
Button(P11, "Quitar marcas", T.text, function() objOn = false objClear() end)
Button(P11, "Ir al objeto marcado más cercano", T.accent, function()
local root = getRoot()
if not root then return end
local best, bd
for d in pairs(objMarks) do
local p = d:IsA("Model") and (d.PrimaryPart or d:FindFirstChildWhichIsA("BasePart")) or d
if p and p:IsA("BasePart") then
local dist = (p.Position - root.Position).Magnitude
if not bd or dist < bd then best, bd = p, dist end
end
end
if best then root.CFrame = best.CFrame * CFrame.new(0, 3, 0) else toast("No hay objetos marcados") end
end)
Section(P11, "Interacción")
local promptOrig = setmetatable({}, { __mode = "k" })
local noWait, reach, noLos = false, 10, false
local function promptApply(pr)
if not pr:IsA("ProximityPrompt") then return end
if not promptOrig[pr] then promptOrig[pr] = { pr.HoldDuration, pr.MaxActivationDistance, pr.RequiresLineOfSight } end
local o = promptOrig[pr]
pr.HoldDuration = noWait and 0 or o[1]
pr.MaxActivationDistance = o[2] * (reach / 10)
pr.RequiresLineOfSight = noLos and false or o[3]
end
local function promptsAll()
task.spawn(function()
local n = 0
for _, d in ipairs(Workspace:GetDescendants()) do
if d:IsA("ProximityPrompt") then pcall(promptApply, d) end
n = n + 1
if n % 600 == 0 then task.wait() end
end
end)
end
track(Workspace.DescendantAdded:Connect(function(d)
if d:IsA("ProximityPrompt") and (noWait or reach ~= 10 or noLos) then task.defer(pcall, promptApply, d) end
end))
H.PT(P11, "Interacción instantánea", "Quita el tiempo de mantener pulsado", "pr_nowait", function(v) noWait = v promptsAll() end)
H.PT(P11, "Interactuar sin línea de visión", nil, "pr_nolos", function(v) noLos = v promptsAll() end)
H.PS(P11, "Alcance de interacción (10 = normal)", 10, 60, 5, "pr_reach", 10, "", function(v) local ch = (v ~= reach) reach = v if ch then promptsAll() end end)
local autoPr, autoR, autoKw = false, 12, ""
local fireP = fireproximityprompt
InputRow(P11, "Auto interactuar: acción que contiene (vacío = todas)", "Aplicar", function(txt)
autoKw = tostring(txt or ""):lower()
toast(autoKw == "" and "Todas las acciones" or ("Filtro: " .. autoKw))
end)
H.PS(P11, "Radio de auto interacción", 5, 60, 5, "pr_autor", 12, "", function(v) autoR = v end)
local autoAcc = 0
track(RunService.Heartbeat:Connect(function(dt)
if not autoPr then return end
autoAcc = autoAcc + (tonumber(dt) or 0)
if autoAcc < 0.3 then return end
autoAcc = 0
local root = getRoot()
if not root or not fireP then return end
for _, d in ipairs(Workspace:GetDescendants()) do
if d:IsA("ProximityPrompt") and d.Enabled then
local part = d.Parent
local pos = part and ((part:IsA("BasePart") and part.Position) or (part:IsA("Attachment") and part.WorldPosition))
if pos and (pos - root.Position).Magnitude <= autoR then
local act = (tostring(d.ActionText) .. " " .. tostring(d.ObjectText)):lower()
if autoKw == "" or act:find(autoKw, 1, true) then pcall(fireP, d) end
end
end
end
end))
H.PT(P11, "Auto interactuar", "Pulsa solo los botones de interacción cercanos", "pr_auto", function(v)
autoPr = v
if v and not fireP then toast("Tu executor no tiene fireproximityprompt") end
end)
local delOn, delStack = false, {}
local function pickTarget(pos)
local cam = Workspace.CurrentCamera
if not cam then return nil end
local ray = cam:ScreenPointToRay(pos.X, pos.Y)
local rp = RaycastParams.new()
pcall(function() rp.FilterType = Enum.RaycastFilterType.Exclude end)
rp.FilterDescendantsInstances = { lp.Character }
local res = Workspace:Raycast(ray.Origin, ray.Direction * 1000, rp)
return res and res.Instance
end
track(UIS.InputBegan:Connect(function(input, gp)
if not delOn or gp then return end
if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
local t = pickTarget(Vector2.new(input.Position.X, input.Position.Y))
if t and not t:IsA("Terrain") then
delStack[#delStack + 1] = { t, t.Parent }
t.Parent = nil
toast("Eliminado (solo para ti)")
end
end
end))
Toggle(P11, "Tocar para eliminar objetos", "Solo en tu pantalla, se puede deshacer", false, function(v) delOn = v end)
Button(P11, "Deshacer última eliminación", T.text, function()
local r = table.remove(delStack)
if r and r[2] then pcall(function() r[1].Parent = r[2] end) else toast("Nada que deshacer") end
end)
Section(P11, "Personaje")
local followName, followOn = "", false
local followAcc = 0
track(RunService.Heartbeat:Connect(function(dt)
if not followOn then return end
followAcc = followAcc + (tonumber(dt) or 0)
if followAcc < 0.2 then return end
followAcc = 0
local hum = getHum()
if not hum then return end
for _, pl in ipairs(Players:GetPlayers()) do
if pl ~= lp and (pl.Name:lower():find(followName, 1, true) or pl.DisplayName:lower():find(followName, 1, true)) then
local r = pl.Character and pl.Character:FindFirstChild("HumanoidRootPart")
local mine = getRoot()
if r and mine and (r.Position - mine.Position).Magnitude > 6 then hum:MoveTo(r.Position) end
return
end
end
end))
InputRow(P11, "Seguir a un jugador (nombre)", "Seguir", function(txt)
followName = tostring(txt or ""):lower()
followOn = followName ~= ""
toast(followOn and "Siguiendo" or "Escribe un nombre")
end)
Button(P11, "Dejar de seguir", T.text, function() followOn = false end)
Toggle(P11, "Congelar personaje", "Te deja en el sitio", false, function(v)
local r = getRoot()
if r then r.Anchored = v end
end)
Toggle(P11, "Sin tropiezos", "Desactiva caída y ragdoll", false, function(v)
local hum = getHum()
if not hum then return end
for _, st in ipairs({ Enum.HumanoidStateType.FallingDown, Enum.HumanoidStateType.Ragdoll }) do
pcall(function() hum:SetStateEnabled(st, not v) end)
end
end)
local lockClock, clockVal = false, 14
track(RunService.Heartbeat:Connect(function() if lockClock then pcall(function() Lighting.ClockTime = clockVal end) end end))
H.PS(P11, "Hora bloqueada", 0, 24, 1, "clock_val", 14, "h", function(v) clockVal = v end)
H.PT(P11, "Bloquear hora del día", nil, "clock_lock", function(v) lockClock = v end)
Button(P11, "Reiniciar personaje", T.red, function()
local hum = getHum()
if hum then hum.Health = 0 end
end)
Section(P11, "Dispositivo y controles")
local devNote = Note(P11, "Dispositivo detectado: " .. H.devName())
Chips(P11, { "Automático", "PC", "Móvil" }, 96, function(i)
H.devMode = i - 1
Sess.ev.devmode = H.devMode
SessSave()
devNote.Text = "Dispositivo en uso: " .. H.devName()
end, H.devMode + 1)
Note(P11, "Método del botón móvil")
Chips(P11, { "Señales", "Toque virtual" }, 100, function(i)
H.mobMethod = i
Sess.ev.mobmethod = i
SessSave()
end, H.mobMethod)
local capturing = false
Button(P11, "Elegir el botón de agacharse del juego", T.accent, function()
capturing = true
toast("Toca ahora el botón de agacharse del juego")
end)
track(UIS.InputBegan:Connect(function(input)
if not capturing then return end
local t = input.UserInputType
if t ~= Enum.UserInputType.Touch and t ~= Enum.UserInputType.MouseButton1 then return end
capturing = false
local pg = lp:FindFirstChildOfClass("PlayerGui")
local list = pg and pg:GetGuiObjectsAtPosition(input.Position.X, input.Position.Y) or {}
for _, o in ipairs(list) do
if o:IsA("GuiButton") then
H.mobBtn = o
Sess.ev.mobBtn = o:GetFullName()
SessSave()
toast("Botón elegido: " .. o.Name)
return
end
end
toast("No había ningún botón ahí")
end))
Button(P11, "Probar agacharse", T.text, function() H.crouchTap("C", 0.25) end)
Section(P11, "Teclado en pantalla")
Note(P11, "Solo lo ves tú. Se ilumina con lo que haces; en móvil se deduce de tu movimiento.")
local KBL = {
{ "WASD", { { "W", "W", 1, 0, 1 }, { "A", "A", 0, 1, 1 }, { "S", "S", 1, 1, 1 }, { "D", "D", 2, 1, 1 } } },
{ "Acciones", { { "W", "W", 1, 0, 1 }, { "A", "A", 0, 1, 1 }, { "S", "S", 1, 1, 1 }, { "D", "D", 2, 1, 1 },
{ "Shift", "LeftShift", 0, 2, 1.5 }, { "C", "C", 1.5, 2, 1.5 }, { "Espacio", "Space", 0, 3, 3 } } },
{ "Completo", { { "Q", "Q", 0, 0, 1 }, { "W", "W", 1, 0, 1 }, { "E", "E", 2, 0, 1 }, { "R", "R", 3, 0, 1 },
{ "A", "A", 0, 1, 1 }, { "S", "S", 1, 1, 1 }, { "D", "D", 2, 1, 1 }, { "F", "F", 3, 1, 1 },
{ "Shift", "LeftShift", 0, 2, 1.5 }, { "C", "C", 1.5, 2, 1 }, { "V", "V", 2.5, 2, 1.5 }, { "Espacio", "Space", 0, 3, 4 } } },
}
local KB = { on = false, layout = tonumber(Sess.ev.kb_layout) or 2, scale = tonumber(Sess.ev.kb_scale) or 10, alpha = tonumber(Sess.ev.kb_alpha) or 4, lock = false, labels = true }
local UNIT, GAP = 40, 5
local guiKeys = new("ScreenGui", {
Name = "XC_K" .. tostring(math.random(100000, 999999)), ResetOnSpawn = false, IgnoreGuiInset = true,
ZIndexBehavior = Enum.ZIndexBehavior.Sibling, DisplayOrder = 998,
})
if not pcall(function() guiKeys.Parent = gui.Parent end) or not guiKeys.Parent then guiKeys.Parent = lp:WaitForChild("PlayerGui") end
local kbF = new("Frame", { Name = "XC_Keys", BackgroundTransparency = 1, Visible = false, Size = UDim2.fromOffset(160, 160) }, guiKeys)
local kbScale = new("UIScale", { Scale = 1 }, kbF)
local kbKeys = {}
local function kbBuild()
for _, k in ipairs(kbKeys) do pcall(function() k.f:Destroy() end) end
kbKeys = {}
local def = KBL[KB.layout] or KBL[2]
local list = {}
for _, k in ipairs(def[2]) do list[#list + 1] = k end
for _, k in ipairs(Sess.ev.kb_extra or {}) do list[#list + 1] = k end
local maxX, maxY = 0, 0
for _, k in ipairs(list) do
local w = k[5] * UNIT - GAP
local f = new("Frame", {
Position = UDim2.fromOffset(k[3] * UNIT, k[4] * UNIT), Size = UDim2.fromOffset(w, UNIT - GAP),
BackgroundColor3 = Color3.fromRGB(16, 16, 20), BackgroundTransparency = 0.25 + KB.alpha * 0.05, BorderSizePixel = 0,
}, kbF)
corner(f, 9)
local st = new("UIStroke", { Thickness = 1, Color = Color3.new(1, 1, 1), Transparency = 0.7 }, f)
local l = label(f, {
Size = UDim2.fromScale(1, 1), Text = KB.labels and k[1] or "", TextSize = 13, Font = Enum.Font.GothamBold,
TextXAlignment = Enum.TextXAlignment.Center, TextColor3 = Color3.fromRGB(235, 235, 240), TextTruncate = Enum.TextTruncate.None,
})
kbKeys[#kbKeys + 1] = { f = f, st = st, l = l, code = Enum.KeyCode[k[2]], name = k[2], lit = false }
maxX = math.max(maxX, k[3] * UNIT + w)
maxY = math.max(maxY, k[4] * UNIT + UNIT - GAP)
end
kbF.Size = UDim2.fromOffset(maxX, maxY)
kbScale.Scale = KB.scale / 10
end
H.drag(kbF, "kb", function() return KB.lock end, function() if H.stream and H.stream.tap then H.stream.tap() end end, UDim2.new(0, 24, 1, -220))
kbBuild()
local kbAcc = 0
track(RunService.RenderStepped:Connect(function(dt)
if not KB.on then return end
kbAcc = kbAcc + (tonumber(dt) or 0)
if kbAcc < 0.03 then return end
kbAcc = 0
local dev = H.dev()
local hum, cam = getHum(), Workspace.CurrentCamera
local derived = {}
if dev ~= "pc" and hum and cam then
local md = hum.MoveDirection
if md.Magnitude > 0.1 then
local look = Vector3.new(cam.CFrame.LookVector.X, 0, cam.CFrame.LookVector.Z)
if look.Magnitude > 0.01 then
look = look.Unit
local right = Vector3.new(-look.Z, 0, look.X)
local f, r = md:Dot(look), md:Dot(right)
derived.W, derived.S = f > 0.35, f < -0.35
derived.D, derived.A = r > 0.35, r < -0.35
end
end
derived.Space = hum.FloorMaterial == Enum.Material.Air
end
local now = os.clock()
for _, k in ipairs(kbKeys) do
local on = false
if k.code then
on = UIS:IsKeyDown(k.code) or (H.sim[k.name] ~= nil and H.sim[k.name] > now) or derived[k.name] == true
end
if on ~= k.lit then
k.lit = on
tween(k.f, 0.08, { BackgroundColor3 = on and Color3.fromRGB(238, 240, 250) or Color3.fromRGB(16, 16, 20), BackgroundTransparency = on and 0.08 or (0.25 + KB.alpha * 0.05) })
tween(k.l, 0.08, { TextColor3 = on and Color3.fromRGB(24, 24, 30) or Color3.fromRGB(235, 235, 240) })
tween(k.st, 0.08, { Transparency = on and 0.1 or 0.7 })
end
end
end))
H.PT(P11, "Mostrar teclado", "Se ilumina con tus teclas", "kb_on", function(v)
KB.on = v
kbF.Visible = v
end)
H.PT(P11, "Bloquear posición", "Evita moverlo sin querer", "kb_lock", function(v) KB.lock = v end)
Note(P11, "Distribución")
Chips(P11, { "Solo WASD", "Con acciones", "Completo" }, 100, function(i)
KB.layout = i
Sess.ev.kb_layout = i
SessSave()
kbBuild()
end, KB.layout)
H.PS(P11, "Tamaño del teclado (10 = normal)", 5, 20, 1, "kb_scale", 10, "", function(v) KB.scale = v kbScale.Scale = v / 10 end)
H.PS(P11, "Transparencia de las teclas", 0, 12, 1, "kb_alpha", 4, "", function(v)
KB.alpha = v
for _, k in ipairs(kbKeys) do if not k.lit then k.f.BackgroundTransparency = 0.25 + v * 0.05 end end
end)
H.PT(P11, "Mostrar letras", nil, "kb_labels", function(v) KB.labels = v kbBuild() end)
InputRow(P11, "Añadir una tecla (una letra, ej: E)", "Añadir", function(txt)
local ch = tostring(txt or ""):upper():match("%a")
if not ch or not Enum.KeyCode[ch] then toast("Escribe una letra") return end
Sess.ev.kb_extra = Sess.ev.kb_extra or {}
local n = #Sess.ev.kb_extra
Sess.ev.kb_extra[n + 1] = { ch, ch, n % 5, 4 + math.floor(n / 5), 1 }
SessSave()
kbBuild()
end)
Button(P11, "Quitar teclas añadidas", T.text, function()
Sess.ev.kb_extra = {}
SessSave()
kbBuild()
end)
Button(P11, "Restablecer posición", T.text, function()
H.resetPos("kb")
kbF.Position = UDim2.new(0, 24, 1, -220)
end)
Section(P11, "Modo stream")
Note(P11, "Oculta el menú, los botones del juego y los de Roblox durante unos segundos. Se quedan el teclado en pantalla y, si quieres, los datos de FPS. Para cancelar: Control derecho en PC, o toca el teclado 3 veces.")
local StarterGui = game:GetService("StarterGui")
local ST = {
on = false, left = 0, acc = 0, dur = 20, hidden = {}, core = {}, topbar = nil, kept = {}, taps = {},
fx = true, roblox = true, gameUi = true, touch = true, keep = true,
}
local function stSet(o, prop, val)
local key = tostring(prop)
ST.hidden[o] = ST.hidden[o] or {}
if ST.hidden[o][key] ~= nil then return end
local ok, old = pcall(function() return o[prop] end)
if not ok then return end
ST.hidden[o][key] = { old }
pcall(function() o[prop] = val end)
end
local function stHide(o)
if o:IsA("Highlight") or o:IsA("BillboardGui") or o:IsA("SurfaceGui") then
stSet(o, "Enabled", false)
elseif o:IsA("GuiBase3d") then
stSet(o, "Visible", false)
elseif o:IsA("BasePart") then
stSet(o, "LocalTransparencyModifier", 1)
end
end
local function stSweepTouch(root)
for _, o in ipairs(root:GetDescendants()) do
if o:IsA("ImageLabel") or o:IsA("ImageButton") then
stSet(o, "ImageTransparency", 1)
if o.BackgroundTransparency < 1 then stSet(o, "BackgroundTransparency", 1) end
elseif o:IsA("TextLabel") or o:IsA("TextButton") then
stSet(o, "TextTransparency", 1)
end
end
end
local function stSweep()
if ST.fx then
local roots = { gui }
local hb = Workspace:FindFirstChild("XC_Hitboxes")
if hb then roots[#roots + 1] = hb end
for _, r in ipairs(roots) do
for _, o in ipairs(r:GetDescendants()) do
if o:IsA("Highlight") or o:IsA("BillboardGui") or o:IsA("GuiBase3d") or (r ~= gui and o:IsA("BasePart")) then stHide(o) end
end
end
end
local pg = lp:FindFirstChildOfClass("PlayerGui")
if pg then
if ST.gameUi then
for _, g in ipairs(pg:GetChildren()) do
if g:IsA("ScreenGui") and g ~= gui and g ~= guiKeys and g.Name ~= "TouchGui" and string.sub(g.Name, 1, 3) ~= "XC_" and g.Enabled then
stSet(g, "Enabled", false)
end
end
end
if ST.touch then
local tg = pg:FindFirstChild("TouchGui")
if tg then stSweepTouch(tg) end
end
end
end
local function stCore(on)
if not ST.roblox then return end
if not on then
ST.core = {}
pcall(function()
for _, t in ipairs(Enum.CoreGuiType:GetEnumItems()) do
if t ~= Enum.CoreGuiType.All then
ST.core[#ST.core + 1] = { t, StarterGui:GetCoreGuiEnabled(t) }
end
end
end)
pcall(function() ST.topbar = StarterGui:GetCore("TopbarEnabled") end)
pcall(function() StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.All, false) end)
pcall(function() StarterGui:SetCore("TopbarEnabled", false) end)
else
for _, e in ipairs(ST.core) do pcall(function() StarterGui:SetCoreGuiEnabled(e[1], e[2]) end) end
ST.core = {}
if ST.topbar ~= nil then pcall(function() StarterGui:SetCore("TopbarEnabled", ST.topbar) end) end
ST.topbar = nil
end
end
local function stKeepItems()
local list = { hudF }
for _, o in ipairs(env.XC_KEEP or {}) do list[#list + 1] = o end
return list
end
local function stStop()
if not ST.on then return end
ST.on = false
for o, props in pairs(ST.hidden) do
for p, r in pairs(props) do pcall(function() o[p] = r[1] end) end
end
ST.hidden = {}
stCore(true)
for _, o in ipairs(ST.kept) do pcall(function() o.Parent = gui end) end
ST.kept = {}
gui.Enabled = true
toast("Modo stream terminado")
end
local function stStart()
if ST.on then return end
ST.on = true
ST.left = ST.dur or 20
ST.acc = 0
ST.taps = {}
local bl = Lighting:FindFirstChild("XC_Blur")
if bl then stSet(bl, "Enabled", false) end
if ST.keep then
for _, o in ipairs(stKeepItems()) do
if o and o.Parent == gui then
o.Parent = guiKeys
ST.kept[#ST.kept + 1] = o
end
end
end
stCore(false)
gui.Enabled = false
stSweep()
end
H.stream = {
start = stStart, stop = stStop,
tap = function()
if not ST.on then return end
local now = os.clock()
ST.taps[#ST.taps + 1] = now
local n = 0
for i = #ST.taps, 1, -1 do
if now - ST.taps[i] <= 1.2 then n = n + 1 else table.remove(ST.taps, i) end
end
if n >= 3 then stStop() end
end,
}
track(RunService.Heartbeat:Connect(function(dt)
if not ST.on then return end
dt = tonumber(dt) or 0.016
ST.left = ST.left - dt
ST.acc = ST.acc + dt
if ST.acc >= 0.4 then
ST.acc = 0
stSweep()
end
if ST.left <= 0 then stStop() end
end))
track(UIS.InputBegan:Connect(function(input, gp)
if gp then return end
if input.KeyCode == Enum.KeyCode.RightControl then
if ST.on then stStop() else stStart() end
end
end))
H.PS(P11, "Duración (segundos)", 10, 60, 5, "st_dur", 20, "", function(v) ST.dur = math.clamp(v, 10, 60) end)
H.PT(P11, "Ocultar botones de Roblox", "Barra superior, chat, tienda y menú", "st_roblox", function(v) ST.roblox = v end)
H.PT(P11, "Ocultar interfaz del juego", "Menús y botones propios del juego", "st_game", function(v) ST.gameUi = v end)
H.PT(P11, "Ocultar controles táctiles", "Joystick y salto; siguen funcionando", "st_touch", function(v) ST.touch = v end)
H.PT(P11, "Ocultar resaltados y cubos", "ESP, hitbox y marcas en el mundo", "st_fx", function(v) ST.fx = v end)
H.PT(P11, "Mantener visibles los FPS y datos", "Contador, monitor y datos en pantalla", "st_keep", function(v) ST.keep = v end)
Button(P11, "Iniciar modo stream", T.accent, stStart)
table.insert(env.DG_Cleanups or {}, function() pcall(stStop) end)
H.attrEditor = function(page)
Section(page, "Atributos del juego")
Note(page, "Muchos juegos guardan velocidad, salto y fricción como atributos. Cambia un valor y se mantiene.")
local holder = listFrame(page)
local scope = 1
local locks = {}
local function target()
if scope == 1 then return lp.Character end
if scope == 2 then return lp end
if scope == 3 then return getHum() end
return Workspace
end
local rebuild
rebuild = function()
clearList(holder)
local t = target()
if not t then return end
local names = {}
for k, v in pairs(t:GetAttributes()) do
if type(v) == "number" then names[#names + 1] = k end
end
table.sort(names)
if #names == 0 then Note(holder, "Sin atributos numéricos aquí") return end
for i, name in ipairs(names) do
if i > 40 then break end
local v = t:GetAttribute(name)
local step = (v == 0) and 1 or 10 ^ (math.floor(math.log10(math.abs(v))) - 1)
if step >= 1 then step = math.floor(step) end
Stepper(holder, name, -1e9, 1e9, step, v, "", function(nv)
pcall(function() t:SetAttribute(name, nv) end)
locks[t] = locks[t] or {}
locks[t][name] = nv
end)
end
end
Chips(page, { "Personaje", "Jugador", "Humanoide", "Mundo" }, 88, function(i) scope = i rebuild() end, 1)
ButtonRow(page, {
{ "Actualizar lista", T.accent, function() rebuild() end },
{ "Soltar valores", T.red, function() locks = {} toast("Valores liberados") end },
})
local acc = 0
track(RunService.Heartbeat:Connect(function(dt)
acc = acc + (tonumber(dt) or 0)
if acc < 0.25 then return end
acc = 0
for t, list in pairs(locks) do
if t.Parent then
for n, v in pairs(list) do
if t:GetAttribute(n) ~= v then pcall(function() t:SetAttribute(n, v) end) end
end
else
locks[t] = nil
end
end
end))
rebuild()
return rebuild
end
H.attrEditor(P11)
env.DG_Cleanups = env.DG_Cleanups or {}
table.insert(env.DG_Cleanups, function()
xrayOn = false
pcall(xrayApply)
objOn = false
pcall(objClear)
for pr, o in pairs(promptOrig) do pcall(function() pr.HoldDuration, pr.MaxActivationDistance, pr.RequiresLineOfSight = o[1], o[2], o[3] end) end
for i = #delStack, 1, -1 do local r = delStack[i] pcall(function() r[1].Parent = r[2] end) end
lockClock = false
followOn = false
pcall(function() kbF:Destroy() end)
pcall(function() guiKeys:Destroy() end)
pcall(function() blurFx:Destroy() end)
end)
end)
if not okP then DG_Fail("Pestaña Útiles", eP) end
end
do
local okP, eP = pcall(function()
local PA = pages[12]
local H = env.XC_H
local PT, PS = H.PT, H.PS
local A = {
on = false, act = (H.dev() == "pc") and 2 or 1, keyName = "Q", part = 1, prio = 1, fov = 160, smooth = 6, method = 1,
sticky = true, wall = true, team = true, npc = false, bullet = 0, ping = true, maxd = 1000, hl = true, circle = true,
cross = false, info = true, esp = false, trig = false, trigDelay = 60, silent = false, chance = 100, center = 1,
}
local ignore, npcs = {}, {}
local cur, curPart, curName, curChar, silentPos, silentPart = nil, nil, "", nil, nil, nil
local mouseObj = lp:GetMouse()
Note(PA, "Dispositivo: " .. H.devName() .. ". En PC apunta con clic derecho; en móvil usa el botón en pantalla.")
Section(PA, "Aimbot")
local tAim = PT(PA, "Aimbot", "Interruptor general", "aim_on", function(v) A.on = v end)
Note(PA, "Cuándo apunta")
local actChips = Chips(PA, { "Siempre", "Clic derecho", "Tecla" }, 96, function(i)
A.act = i
Sess.ev.aim_act = i
SessSave()
end, tonumber(Sess.ev.aim_act) or A.act)
A.act = tonumber(Sess.ev.aim_act) or A.act
Chips(PA, { "Q", "E", "Shift", "Z" }, 64, function(i) A.keyName = ({ "Q", "E", "LeftShift", "Z" })[i] end, 1)
Section(PA, "Objetivo")
Note(PA, "Parte del cuerpo")
Chips(PA, { "Cabeza", "Torso", "Más cercana al centro" }, 130, function(i) A.part = i end, 1)
Note(PA, "Prioridad")
Chips(PA, { "Centro de pantalla", "Distancia", "Vida" }, 120, function(i) A.prio = i end, 1)
PS(PA, "Radio del círculo (px)", 40, 500, 10, "aim_fov", 160, "", function(v) A.fov = v end)
PS(PA, "Distancia máxima", 50, 3000, 50, "aim_maxd", 1000, "", function(v) A.maxd = v end)
PT(PA, "Ignorar mi equipo", nil, "aim_team", function(v) A.team = v end)
PT(PA, "Solo objetivos visibles", "Comprueba que no haya paredes", "aim_wall", function(v) A.wall = v end)
PT(PA, "Mantener el objetivo", "No cambia mientras siga a tu alcance", "aim_sticky", function(v) A.sticky = v end)
local function npcConsider(d)
if d:IsA("Humanoid") then
local m = d.Parent
if m and m:IsA("Model") and not Players:GetPlayerFromCharacter(m) and m ~= lp.Character then npcs[m] = true end
end
end
track(Workspace.DescendantAdded:Connect(function(d) if A.npc then npcConsider(d) end end))
PT(PA, "Incluir NPCs y bots", nil, "aim_npc", function(v)
A.npc = v
npcs = {}
if v then for _, d in ipairs(Workspace:GetDescendants()) do npcConsider(d) end end
end)
InputRow(PA, "Ignorar jugador (nombre)", "Añadir", function(txt)
local n = tostring(txt or ""):lower():gsub("^%s+", ""):gsub("%s+$", "")
if n == "" then return end
ignore[n] = true
toast("Ignorando: " .. n)
end)
Button(PA, "Vaciar lista de ignorados", T.text, function() ignore = {} toast("Lista vacía") end)
Section(PA, "Puntería")
PS(PA, "Suavidad (1 = instantáneo)", 1, 20, 1, "aim_smooth", 6, "", function(v) A.smooth = v end)
Note(PA, "Método")
Chips(PA, { "Cámara", "Ratón" }, 90, function(i)
A.method = i
if i == 2 and not mousemoverel then toast("Tu executor no tiene mousemoverel, se usa la cámara") end
end, 1)
PS(PA, "Velocidad de la bala (0 = sin predicción)", 0, 2000, 50, "aim_bullet", 0, "", function(v) A.bullet = v end)
PT(PA, "Compensar ping en la predicción", nil, "aim_ping", function(v) A.ping = v end)
Note(PA, "Centro del círculo")
Chips(PA, { "Centro de pantalla", "Cursor" }, 120, function(i) A.center = i end, 1)
Section(PA, "Disparo automático")
PT(PA, "Trigger bot", "Dispara cuando tu mira está sobre un enemigo", "aim_trig", function(v) A.trig = v end)
PS(PA, "Retardo entre disparos (ms)", 0, 500, 10, "aim_trigdelay", 60, "", function(v) A.trigDelay = v end)
Section(PA, "Silent aim (experimental)")
Note(PA, "Cambia a dónde apunta el ratón del juego sin mover tu cámara. Solo funciona si tu executor permite hookmetamethod y el juego usa Mouse.Hit.")
PT(PA, "Silent aim", nil, "aim_silent", function(v)
A.silent = v
if v and not hookmetamethod then toast("Tu executor no tiene hookmetamethod") end
end)
PS(PA, "Probabilidad de acierto (%)", 10, 100, 10, "aim_chance", 100, "", function(v) A.chance = v end)
Section(PA, "Visual")
PT(PA, "Círculo de alcance", nil, "aim_circle", function(v) A.circle = v end)
PT(PA, "Mira central", "Un punto en el centro", "aim_cross", function(v) A.cross = v end)
PT(PA, "Resaltar objetivo", nil, "aim_hl", function(v) A.hl = v end)
