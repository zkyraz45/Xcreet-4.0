Stepper(P10, "Hora del día", 0, 24, 1, math.floor(tonumber(Lighting.ClockTime) or 14), "h", function(v) Lighting.ClockTime = v end)
Toggle(P10, "Sin niebla", nil, false, function(v) Lighting.FogEnd = v and 1000000 or orig.fog end)
Toggle(P10, "Sin sombras", nil, false, function(v) Lighting.GlobalShadows = not v and orig.shadows end)
