if isAC then statN.TextColor3 = T.green end
local ALT = {
chico = "boy", chica = "girl", gato = "cat", perro = "dog", zombi = "zombie", zombie = "zombie", princesa = "princess",
dragon = "dragon", payaso = "clown", vampiro = "vampire", sirena = "mermaid", angel = "angel", demonio = "demon",
ninja = "ninja", robot = "robot", pirata = "pirate", bruja = "witch", hada = "fairy", lobo = "wolf", conejo = "bunny",
esqueleto = "skeleton", soldado = "soldier", policia = "police", doctor = "doctor", anime = "anime", gotico = "goth",
fantasma = "ghost", monstruo = "monster", rey = "king", reina = "queen", caballero = "knight", mago = "wizard",
}
local function playerScore(pl, P)
local best = math.max(M.score(pl.DisplayName, P), M.score(pl.Name, P))
local acc = {}
local ch = pl.Character
if ch then
for _, a in ipairs(ch:GetChildren()) do
if a:IsA("Accessory") then acc[#acc + 1] = a.Name end
end
end
if #acc > 0 then best = math.max(best, M.score(table.concat(acc, " "), P) * 0.85) end
return best
end
local function copySkin(uid, nm)
if Sess.copy and Sess.copy.userId == uid then
removeAllApplied()
updateAll()
report("Tu avatar fue restaurado")
return
end
report("Copiando la skin de " .. tostring(nm) .. "…")
local ok, desc = pcall(function() return Players:GetHumanoidDescriptionFromUserId(uid) end)
if not ok or not desc then report("No se pudo leer el avatar de " .. tostring(nm)) return end
local ok2, how = fullCopy(desc)
if ok2 then
Sess.copy = { userId = uid, name = nm }
SessSave()
report("Skin copiada · " .. tostring(how))
else
report("Falló: " .. tostring(how))
end
updateAll()
end
