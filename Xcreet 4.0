if hookmetamethod and newcclosure and checkcaller then
pcall(function()
local old
old = hookmetamethod(game, "__index", newcclosure(function(self, k)
if A.silent and A.on and silentPos and self == mouseObj and (k == "Hit" or k == "Target") and not checkcaller()
and math.random(1, 100) <= A.chance then
if k == "Hit" then return CFrame.new(silentPos) end
return silentPart
end
return old(self, k)
end))
end)
end
