gui.Parent = lp:WaitForChild("PlayerGui")
end
local function vp()
local s = gui.AbsoluteSize
if s.X < 10 then
local cam = Workspace.CurrentCamera
return cam and cam.ViewportSize or Vector2.new(800, 400)
end
return s
end
local toastF = new("Frame", {
AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -28), Size = UDim2.fromOffset(340, 34),
BackgroundColor3 = Color3.fromRGB(78, 60, 92), BackgroundTransparency = 0.05, BorderSizePixel = 0,
Visible = false, ZIndex = 100,
}, gui)
corner(toastF, 17)
local toastL = label(toastF, {
Size = UDim2.new(1, -20, 1, 0), Position = UDim2.fromOffset(10, 0), TextColor3 = T.white, TextSize = 12,
TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 101,
})
local toastTok = 0
local function toast(msg)
toastTok = toastTok + 1
local tk = toastTok
toastL.Text = tostring(msg)
toastF.Visible = true
task.delay(3, function()
if tk == toastTok then toastF.Visible = false end
end)
end
local function makeDraggable(handle, target, onClick)
local dragging, dragInput, dragStart, startPos, moved = false, nil, nil, nil, false
track(handle.InputBegan:Connect(function(input)
if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
dragging = true
moved = false
dragStart = input.Position
startPos = target.Position
local ch
ch = input.Changed:Connect(function()
if input.UserInputState == Enum.UserInputState.End then
dragging = false
if ch then ch:Disconnect() end
if not moved and onClick then safe(onClick) end
end
end)
end
end))
track(handle.InputChanged:Connect(function(input)
if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
dragInput = input
end
end))
track(UIS.InputChanged:Connect(function(input)
if dragging and input == dragInput then
local d = input.Position - dragStart
if d.Magnitude > 6 then moved = true end
if moved then
local v = vp()
local x = math.clamp(startPos.X.Offset + d.X, 24, v.X - 24)
local y = math.clamp(startPos.Y.Offset + d.Y, 24, v.Y - 24)
target.Position = UDim2.fromOffset(x, y)
end
end
end))
end
local fitScales, panelsList = {}, {}
local function blob(parent, color, size, p1, p2, dur)
local f = new("Frame", {
Size = UDim2.fromOffset(size, size), Position = p1, BackgroundColor3 = color,
BackgroundTransparency = 0.7, BorderSizePixel = 0, ZIndex = 0,
}, parent)
circle(f)
TweenService:Create(f, TweenInfo.new(dur, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), { Position = p2 }):Play()
return f
end
local function makePanel(name, size, pos, radius)
local p = { open = false }
p.root = new("Frame", {
Name = name, AnchorPoint = Vector2.new(0.5, 0.5), Position = pos, Size = size,
BackgroundTransparency = 1, Visible = false,
}, gui)
local fit = new("UIScale", { Scale = 1 }, p.root)
fitScales[#fitScales + 1] = fit
local holder = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1 }, p.root)
p.holder = holder
p.anim = new("UIScale", { Scale = 1 }, holder)
for i = 1, 3 do
local sh = new("Frame", {
AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.5, 3 + i * 2),
Size = UDim2.new(1, i * 6, 1, i * 6), BackgroundColor3 = Color3.fromRGB(80, 45, 100),
BackgroundTransparency = 0.9 + i * 0.025, BorderSizePixel = 0, ZIndex = 0,
}, holder)
corner(sh, radius + i * 3)
end
local g = new("CanvasGroup", {
Name = "Glass", Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(255, 244, 249),
BackgroundTransparency = 0.26, BorderSizePixel = 0, GroupTransparency = 0,
}, holder)
corner(g, radius)
p.grad = new("UIGradient", {
Color = ColorSequence.new(Color3.fromRGB(255, 244, 249), Color3.fromRGB(255, 208, 228)), Rotation = 55,
}, g)
p.wall = new("ImageLabel", {
Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ScaleType = Enum.ScaleType.Crop,
ImageTransparency = 0.4, ZIndex = -3, Visible = false,
}, g)
p.pattern = new("CanvasGroup", {
Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, GroupTransparency = 0.55, ZIndex = -2,
}, g)
local st = stroke(g, 0.1, 1.6, Color3.fromRGB(255, 255, 255))
p.stroke = st
local sg = new("UIGradient", {
Rotation = 45,
Transparency = NumberSequence.new({
NumberSequenceKeypoint.new(0, 0.05),
NumberSequenceKeypoint.new(0.45, 0.7),
NumberSequenceKeypoint.new(1, 0.2),
}),
}, st)
TweenService:Create(sg, TweenInfo.new(7, Enum.EasingStyle.Linear, Enum.EasingDirection.Out, -1), { Rotation = 405 }):Play()
local w, h = size.X.Offset, size.Y.Offset
local b = math.floor(math.min(w, h) * 0.9)
p.blobs = {
blob(g, T.accent, b, UDim2.fromOffset(-b * 0.3, -b * 0.3), UDim2.fromOffset(w - b * 0.7, h - b * 0.6), 7),
blob(g, T.purple, b, UDim2.fromOffset(w - b * 0.7, -b * 0.4), UDim2.fromOffset(-b * 0.2, h - b * 0.7), 9),
}
local sheen = new("Frame", {
Size = UDim2.fromScale(1, 1), BackgroundColor3 = T.white, BorderSizePixel = 0, ZIndex = -1,
}, g)
new("UIGradient", {
Rotation = 62,
Transparency = NumberSequence.new({
NumberSequenceKeypoint.new(0, 0.5), NumberSequenceKeypoint.new(0.28, 0.82),
NumberSequenceKeypoint.new(0.5, 1), NumberSequenceKeypoint.new(0.78, 0.9), NumberSequenceKeypoint.new(1, 0.7),
}),
}, sheen)
local lip = new("Frame", {
AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 1), Size = UDim2.new(1, -radius * 1.4, 0, 1),
BackgroundColor3 = T.white, BorderSizePixel = 0, ZIndex = 5,
}, g)
new("UIGradient", {
Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.5, 0.15), NumberSequenceKeypoint.new(1, 1) }),
}, lip)
local inner = new("Frame", {
Size = UDim2.new(1, -4, 1, -4), Position = UDim2.fromOffset(2, 2), BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 5,
}, g)
corner(inner, math.max(2, radius - 2))
new("UIStroke", { Thickness = 1, Color = T.white, Transparency = 0.82 }, inner)
for _, bl in ipairs(p.blobs) do bl.Visible = false end
p.glass = g
panelsList[#panelsList + 1] = p
return p
end
local blurFx
local function blurSet(on)
if not blurFx or not blurFx.Parent then blurFx = new("BlurEffect", { Name = "XC_Blur", Size = 0 }, Lighting) end
tween(blurFx, 0.45, { Size = on and (Style.blur or 14) or 0 })
end
local function panelShow(p)
p.open = true
if p.useBlur then pcall(blurSet, true) end
p.root.Visible = true
p.anim.Scale = 0.8
p.glass.GroupTransparency = 1
tween(p.anim, 0.6, { Scale = 1 }, Enum.EasingStyle.Back)
tween(p.glass, 0.35, { GroupTransparency = 0 }, Enum.EasingStyle.Quad)
end
local function panelHide(p)
p.open = false
if p.useBlur then pcall(blurSet, false) end
tween(p.anim, 0.25, { Scale = 0.88 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
tween(p.glass, 0.25, { GroupTransparency = 1 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
task.delay(0.27, function()
if not p.open and p.root then p.root.Visible = false end
end)
end
local function updateFit()
local v = vp()
local s = math.clamp(math.min(v.X / 540, v.Y / 420), 0.5, 1) * (Style.uiScale or 1)
for _, f in ipairs(fitScales) do f.Scale = s end
end
local state = { fly = false, noclip = false, infjump = false, speed = false, jump = false, antiafk = true, korblox = false, headless = false }
local vals = { flySpeed = 60, walkSpeed = 32, jumpPower = 100, fov = 70 }
local function getChar() return lp.Character end
local function getHum() local c = lp.Character return c and c:FindFirstChildOfClass("Humanoid") end
local function getRoot() local c = lp.Character return c and c:FindFirstChild("HumanoidRootPart") end
local flyBV, flyBG
local function flyStop()
if flyBV then flyBV:Destroy() flyBV = nil end
if flyBG then flyBG:Destroy() flyBG = nil end
local hum = getHum()
if hum then hum.PlatformStand = false end
end
track(RunService.RenderStepped:Connect(function()
if not state.fly then return end
local root, hum, cam = getRoot(), getHum(), Workspace.CurrentCamera
if not (root and hum and cam) then return end
if not flyBV or flyBV.Parent ~= root then
if flyBV then flyBV:Destroy() end
flyBV = new("BodyVelocity", { MaxForce = Vector3.new(1e9, 1e9, 1e9), Velocity = Vector3.new() }, root)
end
if not flyBG or flyBG.Parent ~= root then
if flyBG then flyBG:Destroy() end
flyBG = new("BodyGyro", { MaxTorque = Vector3.new(1e9, 1e9, 1e9), P = 9e4, D = 1e3, CFrame = cam.CFrame }, root)
end
hum.PlatformStand = true
local mv = cam.CFrame:VectorToObjectSpace(hum.MoveDirection)
local vel = cam.CFrame.LookVector * -mv.Z + cam.CFrame.RightVector * mv.X
if UIS:IsKeyDown(Enum.KeyCode.Space) or hum.Jump then vel = vel + Vector3.new(0, 1, 0) end
if UIS:IsKeyDown(Enum.KeyCode.LeftShift) then vel = vel - Vector3.new(0, 1, 0) end
flyBV.Velocity = vel * vals.flySpeed
flyBG.CFrame = cam.CFrame
end))
track(RunService.Stepped:Connect(function()
if not state.noclip then return end
local c = lp.Character
if not c then return end
for _, p in ipairs(c:GetDescendants()) do
if p:IsA("BasePart") and p.CanCollide then p.CanCollide = false end
end
end))
track(UIS.JumpRequest:Connect(function()
if state.infjump then
local h = getHum()
if h then h:ChangeState(Enum.HumanoidStateType.Jumping) end
end
end))
track(RunService.Heartbeat:Connect(function()
local hum = getHum()
if not hum then return end
if state.speed then hum.WalkSpeed = vals.walkSpeed end
if state.jump then
hum.UseJumpPower = true
hum.JumpPower = vals.jumpPower
end
end))
track(lp.Idled:Connect(function()
if not state.antiafk then return end
local vu = game:GetService("VirtualUser")
vu:CaptureController()
vu:ClickButton2(Vector2.new())
end))
local fbSaved
local function setFullbright(on)
if on then
fbSaved = {
Brightness = Lighting.Brightness, ClockTime = Lighting.ClockTime, FogEnd = Lighting.FogEnd,
GlobalShadows = Lighting.GlobalShadows, Ambient = Lighting.Ambient, OutdoorAmbient = Lighting.OutdoorAmbient,
}
Lighting.Brightness = 2
Lighting.ClockTime = 14
Lighting.FogEnd = 1e6
Lighting.GlobalShadows = false
Lighting.Ambient = Color3.fromRGB(178, 178, 178)
Lighting.OutdoorAmbient = Color3.fromRGB(178, 178, 178)
elseif fbSaved then
for k, v in pairs(fbSaved) do Lighting[k] = v end
fbSaved = nil
end
end
local saved = {}
local rigLabel
local function isR15(hum) return hum.RigType == Enum.HumanoidRigType.R15 end
local function applyKorblox(char, on)
local hum = char:FindFirstChildOfClass("Humanoid")
if not hum then return end
if isR15(hum) then
for name, data in pairs(KORBLOX_R15) do
local part = char:FindFirstChild(name)
if part and part:IsA("MeshPart") then
if on then
if not saved[name] then saved[name] = { part.MeshId, part.TextureID, part.Transparency } end
part.MeshId = data.Mesh
if data.Tex then part.TextureID = data.Tex end
if data.Transp then part.Transparency = data.Transp end
elseif saved[name] then
part.MeshId, part.TextureID, part.Transparency = saved[name][1], saved[name][2], saved[name][3]
saved[name] = nil
end
end
end
else
local leg = char:FindFirstChild("Right Leg")
if not leg then return end
local existing = leg:FindFirstChild("DG_Korblox")
if on then
if not existing then
new("SpecialMesh", {
Name = "DG_Korblox", MeshType = Enum.MeshType.FileMesh,
MeshId = KORBLOX_R6_MESH, TextureId = KORBLOX_R6_TEX, Scale = Vector3.new(1, 1, 1),
}, leg)
end
elseif existing then
existing:Destroy()
end
end
end
local function applyHeadless(char, on)
local head = char:FindFirstChild("Head")
if not head then return end
head.Transparency = on and 1 or 0
for _, d in ipairs(head:GetChildren()) do
if d:IsA("Decal") then d.Transparency = on and 1 or 0 end
end
end
local accessoryStorage = {}
local refreshAccessoriesFunc = nil
local updaters = {}
local updateAll
local applied = {}        -- key -> { undo = función }
local srcCache = {}       -- key -> instancia ya descargada
local baseDesc = nil      -- tu descripción original
local quickApplied = false
local logLabels = {}      -- etiquetas donde se muestra el estado
local function report(msg)
msg = tostring(msg)
warn("[Xcreet] " .. msg)
toast(msg)
for _, l in ipairs(logLabels) do pcall(function() l.Text = msg end) end
end
local ACC_BY_TYPE = {
[8] = "Hat", [41] = "Hair", [42] = "Face", [43] = "Neck", [44] = "Shoulder", [45] = "Front", [46] = "Back",
[47] = "Waist", [64] = "TShirt", [65] = "Shirt", [66] = "Pants", [67] = "Jacket", [68] = "Sweater",
[69] = "Shorts", [70] = "LeftShoe", [71] = "RightShoe", [72] = "DressSkirt",
}
local PROP_BY_TYPE = {
[11] = "Shirt", [12] = "Pants", [2] = "GraphicTShirt", [18] = "Face", [17] = "Head",
[27] = "Torso", [28] = "RightArm", [29] = "LeftArm", [30] = "LeftLeg", [31] = "RightLeg",
}
local CLOTH_CLASS = { Shirt = "Shirt", Pants = "Pants", GraphicTShirt = "ShirtGraphic", Face = "Decal" }
local BODY_GROUPS = {
Head = { "Head" }, Torso = { "UpperTorso", "LowerTorso" },
LeftArm = { "LeftUpperArm", "LeftLowerArm", "LeftHand" }, RightArm = { "RightUpperArm", "RightLowerArm", "RightHand" },
LeftLeg = { "LeftUpperLeg", "LeftLowerLeg", "LeftFoot" }, RightLeg = { "RightUpperLeg", "RightLowerLeg", "RightFoot" },
}
local PART_COLOR = {
HeadColor = { "Head" }, TorsoColor = { "UpperTorso", "LowerTorso", "Torso" },
LeftArmColor = { "LeftUpperArm", "LeftLowerArm", "LeftHand", "Left Arm" },
RightArmColor = { "RightUpperArm", "RightLowerArm", "RightHand", "Right Arm" },
LeftLegColor = { "LeftUpperLeg", "LeftLowerLeg", "LeftFoot", "Left Leg" },
RightLegColor = { "RightUpperLeg", "RightLowerLeg", "RightFoot", "Right Leg" },
}
local SCALE_VALUES = {
HeightScale = "BodyHeightScale", WidthScale = "BodyWidthScale", DepthScale = "BodyDepthScale",
HeadScale = "HeadScale", BodyTypeScale = "BodyTypeScale", ProportionScale = "BodyProportionScale",
}
local function findClass(obj, cls)
if not obj then return nil end
if obj:IsA(cls) then return obj end
return obj:FindFirstChildWhichIsA(cls, true)
end
local ITEM_CLASSES = { "Accessory", "Shirt", "Pants", "ShirtGraphic", "Decal" }
local function resolveItem(obj)
if not obj then return nil end
for _, cn in ipairs(ITEM_CLASSES) do
if obj:IsA(cn) then return obj end
end
for _, cn in ipairs(ITEM_CLASSES) do
local f = obj:FindFirstChildWhichIsA(cn, true)
if f then return f end
end
return nil
end
local fetchCache = {}
local function fetchObject(id)
if fetchCache[id] then return fetchCache[id] end
local errs = {}
for _, url in ipairs({ "rbxassetid://" .. id, "http://www.roblox.com/asset/?id=" .. id }) do
local ok, res = pcall(function() return game:GetObjects(url) end)
if ok and type(res) == "table" and res[1] then
fetchCache[id] = res[1]
return res[1]
end
if not ok then errs[#errs + 1] = "GetObjects: " .. tostring(res):sub(1, 50) end
end
local ok2, m = pcall(function() return game:GetService("InsertService"):LoadAsset(id) end)
if ok2 and m then
fetchCache[id] = m
return m
end
errs[#errs + 1] = "LoadAsset: " .. tostring(m):sub(1, 50)
return nil, table.concat(errs, " | ")
end
local function miniRig(fill)
local okD, d = pcall(function()
local hd = Instance.new("HumanoidDescription")
fill(hd)
return hd
end)
if not okD then return nil, "Descripción: " .. tostring(d):sub(1, 50) end
local ok, rig = pcall(function() return Players:CreateHumanoidModelFromDescription(d, Enum.HumanoidRigType.R15) end)
if ok and rig then return rig end
return nil, "Avatar: " .. tostring(rig):sub(1, 50)
end
local nameCache = {}
local function itemName(id)
if nameCache[id] then return nameCache[id] end
local ok, info = pcall(function() return MarketplaceService:GetProductInfo(id) end)
local n = (ok and info and info.Name) or ("Item " .. tostring(id))
nameCache[id] = n
return n
end
local function acquire(d)
if srcCache[d.key] then return srcCache[d.key] end
if d.kind == "prop" and BODY_GROUPS[d.prop] then
local rig, e = miniRig(function(hd) hd[d.prop] = d.id end)
if rig then srcCache[d.key] = rig return rig end
return nil, e
end
local obj, e1 = fetchObject(d.id)
local inst
if obj then
if d.kind == "acc" then inst = findClass(obj, "Accessory")
else inst = findClass(obj, CLOTH_CLASS[d.prop]) end
end
if inst then srcCache[d.key] = inst return inst end
local rig, e2 = miniRig(function(hd)
if d.kind == "acc" then hd:SetAccessories({ d.entry }, true) else hd[d.prop] = d.id end
end)
if rig then
local inst2
if d.kind == "acc" then
inst2 = rig:FindFirstChildWhichIsA("Accessory")
elseif d.prop == "Face" then
local h = rig:FindFirstChild("Head")
inst2 = h and h:FindFirstChildWhichIsA("Decal")
else
inst2 = rig:FindFirstChildOfClass(CLOTH_CLASS[d.prop])
end
if inst2 then srcCache[d.key] = inst2 return inst2 end
return nil, "El avatar generado no trae el item"
end
return nil, tostring(e1 or "sin respuesta") .. " | " .. tostring(e2)
end
local function copyPartProps(tp, cp, undos)
local old = { MeshId = cp.MeshId, TextureID = cp.TextureID, Size = cp.Size, atts = {}, motors = {} }
for _, a in ipairs(tp:GetChildren()) do
if a:IsA("Attachment") then
local ca = cp:FindFirstChild(a.Name)
if ca and ca:IsA("Attachment") then old.atts[ca] = ca.CFrame ca.CFrame = a.CFrame end
elseif a:IsA("Motor6D") then
local cm = cp:FindFirstChild(a.Name)
if cm and cm:IsA("Motor6D") then old.motors[cm] = { cm.C0, cm.C1 } cm.C0 = a.C0 cm.C1 = a.C1 end
end
end
trySet(cp, "MeshId", tp.MeshId)
trySet(cp, "TextureID", tp.TextureID)
pcall(function() cp.Size = tp.Size end)
undos[#undos + 1] = function()
trySet(cp, "MeshId", old.MeshId)
trySet(cp, "TextureID", old.TextureID)
pcall(function() cp.Size = old.Size end)
for a, cf in pairs(old.atts) do a.CFrame = cf end
for m, v in pairs(old.motors) do m.C0 = v[1] m.C1 = v[2] end
end
end
local function stripJoints(handle)
for _, d in ipairs(handle:GetChildren()) do
if d:IsA("JointInstance") or d:IsA("WeldConstraint") then d:Destroy() end
end
end
local function findCharAttachment(char, name)
for _, d in ipairs(char:GetDescendants()) do
if d:IsA("Attachment") and d.Name == name and d.Parent and d.Parent:IsA("BasePart")
and not d:FindFirstAncestorOfClass("Accessory") then
return d
end
end
return nil
end
local function handleJoined(handle, char)
for _, d in ipairs(handle:GetChildren()) do
if d:IsA("JointInstance") then
local other = (d.Part0 == handle) and d.Part1 or d.Part0
if other and other:IsDescendantOf(char) then return true end
end
end
return false
end
local function weldAccessory(acc, char)
local handle = acc:FindFirstChild("Handle")
if not (handle and handle:IsA("BasePart")) then return false end
stripJoints(handle)
handle.Anchored = false
handle.CanCollide = false
pcall(function() handle.Massless = true end)
local att = handle:FindFirstChildWhichIsA("Attachment")
local target = att and findCharAttachment(char, att.Name)
local w = Instance.new("Weld")
w.Name = "AccessoryWeld"
if target then
w.Part0 = handle
w.C0 = att.CFrame
w.Part1 = target.Parent
w.C1 = target.CFrame
else
local head = char:FindFirstChild("Head")
if not head then w:Destroy() return false end
w.Part0 = head
w.C0 = CFrame.new(0, 0.5, 0)
w.Part1 = handle
local okAP, ap = pcall(function() return acc.AttachmentPoint end)
w.C1 = okAP and ap or CFrame.new()
end
w.Parent = handle
return true
end
local function accTarget(acc, char)
local handle = acc:FindFirstChild("Handle")
local att = handle and handle:FindFirstChildWhichIsA("Attachment")
if att then
local t = findCharAttachment(char, att.Name)
if t and t.Parent then return t.Parent, t.CFrame * att.CFrame:Inverse() end
end
local head = char:FindFirstChild("Head")
if head then
local okAP, ap = pcall(function() return acc.AttachmentPoint end)
return head, CFrame.new(0, 0.5, 0) * ((okAP and ap) or CFrame.new()):Inverse()
end
return nil
end
local function nearChar(handle, char)
local root = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Head")
if not root then return true end
return (handle.Position - root.Position).Magnitude < 14
end
local function followAccessory(acc, char)
local handle = acc:FindFirstChild("Handle")
if not (handle and handle:IsA("BasePart")) then return false end
stripJoints(handle)
handle.Anchored = true
handle.CanCollide = false
pcall(function() handle.CanTouch = false end)
pcall(function() handle.CanQuery = false end)
local con
con = RunService.RenderStepped:Connect(function()
if not acc.Parent or not handle.Parent or not char.Parent then
if con then con:Disconnect() end
return
end
local part, off = accTarget(acc, char)
if part then handle.CFrame = part.CFrame * off end
end)
track(con)
return true
end
local function equipAccessory(template, char, hum)
local acc = template:Clone()
pcall(function() acc:SetAttribute("DG", true) end)
local handle = acc:FindFirstChild("Handle")
local isPart = handle and handle:IsA("BasePart")
if isPart then
stripJoints(handle)
handle.Anchored = false
handle.CanCollide = false
end
pcall(function() hum:AddAccessory(acc) end)
if acc.Parent ~= char then acc.Parent = char end
if isPart then
task.wait(0.2)
if not (handleJoined(handle, char) and nearChar(handle, char)) then
pcall(weldAccessory, acc, char)
task.wait(0.1)
if not nearChar(handle, char) then
followAccessory(acc, char)
end
end
end
return acc
end
local function applyItemRaw(d)
if applied[d.key] then return true end
local c, hum = getChar(), getHum()
if not (c and hum) then return false, "No hay personaje" end
if d.kind == "acc" then
local src, err = acquire(d)
if not src then return false, err end
c, hum = getChar(), getHum()
if not (c and hum) then return false, "No hay personaje" end
local inst = equipAccessory(src, c, hum)
applied[d.key] = { undo = function() inst:Destroy() end }
return true
elseif d.kind == "prop" and CLOTH_CLASS[d.prop] then
local src, err = acquire(d)
if not src then return false, err end
c = getChar()
if not c then return false, "No hay personaje" end
local inst = src:Clone()
local cls = CLOTH_CLASS[d.prop]
local parent = c
if d.prop == "Face" then
parent = c:FindFirstChild("Head")
if not parent then return false, "Sin cabeza" end
inst.Name = "face"
end
local stash = {}
for _, o in ipairs(parent:GetChildren()) do
if o:IsA(cls) then stash[#stash + 1] = o o.Parent = nil end
end
inst.Parent = parent
applied[d.key] = { undo = function()
inst:Destroy()
for _, o in ipairs(stash) do o.Parent = parent end
end }
return true
elseif d.kind == "prop" then -- partes del cuerpo (R15)
if not isR15(hum) then return false, "Las partes del cuerpo solo funcionan en R15" end
local rig, err = acquire(d)
if not rig then return false, err end
local undos, n = {}, 0
for _, name in ipairs(BODY_GROUPS[d.prop]) do
local tp, cp = rig:FindFirstChild(name), c:FindFirstChild(name)
if tp and cp and tp:IsA("MeshPart") and cp:IsA("MeshPart") then
copyPartProps(tp, cp, undos)
n = n + 1
end
end
if n == 0 then return false, "No se encontraron partes para copiar" end
applied[d.key] = { undo = function() for _, u in ipairs(undos) do pcall(u) end end }
return true
elseif d.kind == "colors" then
local bc = c:FindFirstChildOfClass("BodyColors")
local oldBC, oldParts = {}, {}
if bc then
for prop, col in pairs(d.vals) do
local bp = prop .. "3"
pcall(function() oldBC[bp] = bc[bp] bc[bp] = col end)
end
end
for prop, names in pairs(PART_COLOR) do
local col = d.vals[prop]
if col then
for _, n in ipairs(names) do
local p = c:FindFirstChild(n)
if p and p:IsA("BasePart") then oldParts[p] = p.Color p.Color = col end
end
end
end
applied[d.key] = { undo = function()
if bc then for k, v in pairs(oldBC) do pcall(function() bc[k] = v end) end end
for p, col in pairs(oldParts) do pcall(function() p.Color = col end) end
end }
return true
elseif d.kind == "scale" then
local old, n = {}, 0
for key, vname in pairs(SCALE_VALUES) do
local nv = hum:FindFirstChild(vname)
if nv and nv:IsA("NumberValue") and d.vals[key] then
old[nv] = nv.Value
nv.Value = d.vals[key]
n = n + 1
end
end
if n == 0 then return false, "Tu personaje no tiene valores de escala" end
applied[d.key] = { undo = function() for nv, v in pairs(old) do pcall(function() nv.Value = v end) end end }
return true
end
return false, "Tipo de item no soportado"
end
local function applyItem(d)
local ok, r1, r2 = pcall(applyItemRaw, d)
if not ok then return false, tostring(r1):sub(1, 90) end
if r1 and d.id and tostring(d.key):sub(1, 2) == "c_" and not sessBusy then
Sess.items[d.key] = { id = d.id, name = d.name }
SessSave()
end
return r1, r2
end
local function removeItem(key)
local rec = applied[key]
if not rec then return end
applied[key] = nil
pcall(rec.undo)
if not sessBusy and Sess.items[key] then
Sess.items[key] = nil
SessSave()
end
end
local function stashOwnAccessories()
if applied["__own"] then return end
local c = getChar()
if not c then return end
local list = {}
for _, x in ipairs(c:GetChildren()) do
if x:IsA("Accessory") and not x:GetAttribute("DG") then
list[#list + 1] = x
x.Parent = nil
end
end
applied["__own"] = { undo = function()
local ch, h = getChar(), getHum()
for _, x in ipairs(list) do
if ch then
if h then pcall(function() h:AddAccessory(x) end) end
if x.Parent ~= ch then x.Parent = ch end
end
end
end }
end
local function postApply()
saved = {}
local c = getChar()
if c then
if state.korblox then pcall(applyKorblox, c, true) end
if state.headless then pcall(applyHeadless, c, true) end
end
accessoryStorage = {}
if refreshAccessoriesFunc then pcall(refreshAccessoriesFunc) end
end
local function quickRestore()
if not quickApplied then return end
quickApplied = false
local hum = getHum()
if hum and baseDesc then
pcall(function() hum:ApplyDescription(baseDesc) end)
postApply()
end
end
local function removeAllApplied()
local keys = {}
for k in pairs(applied) do keys[#keys + 1] = k end
for _, k in ipairs(keys) do
if k ~= "__own" then removeItem(k) end
end
removeItem("__own")
quickRestore()
if not sessBusy and Sess.copy then
Sess.copy = nil
SessSave()
end
Sess.skinId = nil
end
local function buildRig(desc, rigType)
local ok, rig = pcall(function() return Players:CreateHumanoidModelFromDescription(desc, rigType) end)
if ok and rig then return rig end
return nil, tostring(rig):sub(1, 70)
end
local function swapSpecialMesh(tp, cp, undos)
local tm = tp:FindFirstChildOfClass("SpecialMesh")
if not tm then return false end
local cm = cp:FindFirstChildOfClass("SpecialMesh")
local clone = tm:Clone()
if cm then cm.Parent = nil end
clone.Parent = cp
undos[#undos + 1] = function()
clone:Destroy()
if cm then cm.Parent = cp end
end
return true
end
local function transplantRig(rig)
local c, hum = getChar(), getHum()
if not (c and hum) then return false, "No hay personaje" end
removeItem("__rig")
local undos = {}
local nAcc, nCloth = 0, 0
stashOwnAccessories()
for _, a in ipairs(rig:GetChildren()) do
if a:IsA("Accessory") then
local ok, inst = pcall(equipAccessory, a, c, hum)
if ok and inst then
nAcc = nAcc + 1
undos[#undos + 1] = function() inst:Destroy() end
end
end
end
for _, cls in ipairs({ "Shirt", "Pants", "ShirtGraphic" }) do
local stash = {}
for _, o in ipairs(c:GetChildren()) do
if o:IsA(cls) then stash[#stash + 1] = o o.Parent = nil end
end
local src = rig:FindFirstChildOfClass(cls)
local inst
if src then
inst = src:Clone()
inst.Parent = c
nCloth = nCloth + 1
end
undos[#undos + 1] = function()
if inst then inst:Destroy() end
for _, o in ipairs(stash) do o.Parent = c end
end
end
local rh, ch = rig:FindFirstChild("Head"), c:FindFirstChild("Head")
local rf = rh and rh:FindFirstChildWhichIsA("Decal")
if rf and ch then
local stash = {}
for _, o in ipairs(ch:GetChildren()) do
if o:IsA("Decal") then stash[#stash + 1] = o o.Parent = nil end
end
local inst = rf:Clone()
inst.Parent = ch
nCloth = nCloth + 1
undos[#undos + 1] = function()
inst:Destroy()
for _, o in ipairs(stash) do o.Parent = ch end
end
end
local rbc, cbc = rig:FindFirstChildOfClass("BodyColors"), c:FindFirstChildOfClass("BodyColors")
local oldCols = {}
if rbc and cbc then
for _, p in ipairs({ "HeadColor3", "TorsoColor3", "LeftArmColor3", "RightArmColor3", "LeftLegColor3", "RightLegColor3" }) do
pcall(function() oldCols[p] = cbc[p] cbc[p] = rbc[p] end)
end
end
local oldPartCols = {}
for _, rp in ipairs(rig:GetChildren()) do
if rp:IsA("BasePart") and rp.Name ~= "HumanoidRootPart" then
local cp = c:FindFirstChild(rp.Name)
if cp and cp:IsA("BasePart") then
oldPartCols[cp] = cp.Color
cp.Color = rp.Color
end
end
end
undos[#undos + 1] = function()
if cbc then for p, v in pairs(oldCols) do pcall(function() cbc[p] = v end) end end
for p, v in pairs(oldPartCols) do pcall(function() p.Color = v end) end
end
applied["__rig"] = { undo = function()
for i = #undos, 1, -1 do pcall(undos[i]) end
end }
postApply()
return true, nAcc .. " accesorios, " .. nCloth .. " prendas/cara"
end
local function descCount(d)
local ok, a = pcall(function() return d:GetAccessories(true) end)
return (ok and a) and #a or 0
end
local R15_PARTS = { "Head", "UpperTorso", "LowerTorso", "LeftUpperArm", "LeftLowerArm", "LeftHand", "RightUpperArm", "RightLowerArm",
"RightHand", "LeftUpperLeg", "LeftLowerLeg", "LeftFoot", "RightUpperLeg", "RightLowerLeg", "RightFoot" }
local R6_PARTS = { "Head", "Torso", "Left Arm", "Right Arm", "Left Leg", "Right Leg" }
local function bodyIssues(hum)
local bad = {}
local c = hum and hum.Parent
if not c then return bad end
local list = (hum.RigType == Enum.HumanoidRigType.R15) and R15_PARTS or R6_PARTS
for _, n in ipairs(list) do
local p = c:FindFirstChild(n)
if not (p and p:IsA("BasePart")) then
bad[n] = true
else
pcall(function()
if p.Size.Magnitude < 0.05 then bad[n] = true end
if p:IsA("MeshPart") and p.MeshId == "" then bad[n] = true end
end)
end
end
if not c:FindFirstChild("HumanoidRootPart") then bad.HumanoidRootPart = true end
return bad
end
local function newIssues(hum, base)
local out = {}
for n in pairs(bodyIssues(hum)) do
if not base[n] then out[#out + 1] = n end
end
table.sort(out)
return out
end
local function waitHealthy(hum, base, secs)
local t0, k = os.clock(), 0
local bad = newIssues(hum, base)
while #bad > 0 and os.clock() - t0 < secs and k < 40 do
k = k + 1
task.wait(0.25)
bad = newIssues(hum, base)
end
return bad
end
local function applyDesc(hum, d)
local done, okAD, errAD = false, false, nil
task.spawn(function()
okAD, errAD = pcall(function() hum:ApplyDescription(d) end)
done = true
end)
local t0, k = os.clock(), 0
while not done and os.clock() - t0 < 10 and k < 120 do
k = k + 1
task.wait(0.1)
end
if not done then return false, "tardó demasiado" end
if not okAD then return false, tostring(errAD):sub(1, 70) end
return true
end
local function tryApplyDescription(desc)
local hum = getHum()
if not hum then return false, "No hay personaje" end
if not baseDesc then
local ok, d = pcall(function() return hum:GetAppliedDescription() end)
if ok and d then baseDesc = d end
end
if not baseDesc then return false, "No pude leer tu avatar actual" end
local base = bodyIssues(hum)
local function rollback()
local okR = pcall(function() hum:ApplyDescriptionReset(baseDesc) end)
if not okR then pcall(function() hum:ApplyDescription(baseDesc) end) end
end
local okAD, errAD = applyDesc(hum, desc)
if not okAD then return false, errAD end
local ok, got = pcall(function() return hum:GetAppliedDescription() end)
if ok and got then
local same = got.Shirt == desc.Shirt and got.Pants == desc.Pants and got.GraphicTShirt == desc.GraphicTShirt
and descCount(got) == descCount(desc)
if not same then
rollback()
return false, "el juego no aceptó el cambio"
end
end
local bad = waitHealthy(hum, base, 3)
local note = nil
if #bad > 0 then
report("Reparando el cuerpo (" .. table.concat(bad, ", ") .. ")…")
local d2
pcall(function() d2 = desc:Clone() end)
if d2 then
for _, k in ipairs({ "Head", "Torso", "LeftArm", "RightArm", "LeftLeg", "RightLeg" }) do
pcall(function() d2[k] = 0 end)
end
if applyDesc(hum, d2) then bad = waitHealthy(hum, base, 3) end
end
if #bad > 0 then
rollback()
return false, "el cuerpo de ese avatar se rompe en este juego"
end
note = "avatar aplicado con tu cuerpo base"
end
quickApplied = true
postApply()
return true, note
end
local function descFromCopy(c)
if type(c) ~= "table" then return nil end
local ok, d = pcall(function()
if c.outfitId then return Players:GetHumanoidDescriptionFromOutfitId(c.outfitId) end
return Players:GetHumanoidDescriptionFromUserId(c.userId)
end)
return ok and d or nil
end
local KEEP_CLASSES = { "Attachment", "SpecialMesh", "Decal", "Texture", "WrapTarget", "WrapLayer", "SurfaceAppearance", "FaceControls", "Bone" }
local function isKeepClass(o)
for _, cl in ipairs(KEEP_CLASSES) do
if o:IsA(cl) then return true end
end
return false
end
local function swapBodyRaw(rig)
local c, hum = getChar(), getHum()
if not (c and hum) then return false, "No hay personaje" end
local rigHum = rig:FindFirstChildOfClass("Humanoid")
local names = (hum.RigType == Enum.HumanoidRigType.R15) and R15_PARTS or R6_PARTS
removeItem("__body")
local swaps, wires, moved, motorOld, scaleOld = {}, {}, {}, {}, {}
local hipOld = hum.HipHeight
local function rewire(old, new)
for _, j in ipairs(c:GetDescendants()) do
if j:IsA("JointInstance") or j:IsA("WeldConstraint") then
if j.Part0 == old then wires[#wires + 1] = { j, "Part0", old } j.Part0 = new end
if j.Part1 == old then wires[#wires + 1] = { j, "Part1", old } j.Part1 = new end
end
end
end
local n = 0
for _, name in ipairs(names) do
local old, rp = c:FindFirstChild(name), rig:FindFirstChild(name)
if old and rp and old:IsA("BasePart") and rp:IsA("BasePart") then
local ok = pcall(function()
local new = rp:Clone()
for _, ch in ipairs(new:GetChildren()) do
if ch:IsA("JointInstance") or ch:IsA("WeldConstraint") then ch:Destroy() end
end
new.Anchored = false
for _, pr in ipairs({ "CanCollide", "CanTouch", "CanQuery", "Massless", "CollisionGroup" }) do
pcall(function() new[pr] = old[pr] end)
end
new.CFrame = old.CFrame
new.Parent = c
for _, ch in ipairs(old:GetChildren()) do
if ch:IsA("JointInstance") then
moved[#moved + 1] = { ch, old }
ch.Parent = new
elseif not isKeepClass(ch) then
moved[#moved + 1] = { ch, old }
ch.Parent = new
end
end
rewire(old, new)
old.Parent = nil
swaps[#swaps + 1] = { old, new }
end)
if ok then n = n + 1 end
end
end
if n == 0 then return false, "no se pudo reemplazar ninguna pieza" end
for _, rm in ipairs(rig:GetDescendants()) do
if rm:IsA("Motor6D") then
for _, cm in ipairs(c:GetDescendants()) do
if cm:IsA("Motor6D") and cm.Name == rm.Name then
motorOld[#motorOld + 1] = { cm, cm.C0, cm.C1 }
pcall(function() cm.C0, cm.C1 = rm.C0, rm.C1 end)
break
end
end
end
end
if rigHum then
for _, v in ipairs(rigHum:GetChildren()) do
if v:IsA("NumberValue") then
local mine = hum:FindFirstChild(v.Name)
if mine and mine:IsA("NumberValue") then
scaleOld[#scaleOld + 1] = { mine, mine.Value }
pcall(function() mine.Value = v.Value end)
end
end
end
pcall(function() hum.HipHeight = rigHum.HipHeight end)
end
local rrp, crp = rig:FindFirstChild("HumanoidRootPart"), c:FindFirstChild("HumanoidRootPart")
if rrp and crp then
scaleOld[#scaleOld + 1] = { { crp, "Size" }, crp.Size }
pcall(function() crp.Size = rrp.Size end)
end
local rbc, cbc = rig:FindFirstChildOfClass("BodyColors"), c:FindFirstChildOfClass("BodyColors")
local oldCols = {}
if rbc and cbc then
for _, p in ipairs({ "HeadColor3", "TorsoColor3", "LeftArmColor3", "RightArmColor3", "LeftLegColor3", "RightLegColor3" }) do
pcall(function() oldCols[p] = cbc[p] cbc[p] = rbc[p] end)
end
end
applied["__body"] = { undo = function()
for i = #wires, 1, -1 do
local w = wires[i]
pcall(function() w[1][w[2]] = w[3] end)
end
for i = #moved, 1, -1 do
local m = moved[i]
pcall(function() m[1].Parent = m[2] end)
end
for i = #swaps, 1, -1 do
local sw = swaps[i]
pcall(function() sw[1].Parent = c end)
pcall(function() sw[2]:Destroy() end)
end
for _, m in ipairs(motorOld) do pcall(function() m[1].C0, m[1].C1 = m[2], m[3] end) end
for _, e in ipairs(scaleOld) do
pcall(function()
if type(e[1]) == "table" then e[1][1][e[1][2]] = e[2] else e[1].Value = e[2] end
end)
end
pcall(function() hum.HipHeight = hipOld end)
if cbc then for p, v in pairs(oldCols) do pcall(function() cbc[p] = v end) end end
end }
return true, n .. " piezas del cuerpo"
end
local function swapBody(rig)
local hum = getHum()
local rn
if hum then pcall(function() rn = hum.RequiresNeck hum.RequiresNeck = false end) end
local ok, a1, a2 = pcall(swapBodyRaw, rig)
if hum and rn ~= nil then
task.delay(0.6, function() pcall(function() hum.RequiresNeck = rn end) end)
end
if not ok then return false, tostring(a1) end
return a1, a2
end
local function fullCopy(desc)
local hum = getHum()
if not hum then return false, "No hay personaje" end
removeAllApplied()
report("Método 1: aplicando avatar…")
local ok, err = tryApplyDescription(desc)
if ok then return true, err or "avatar aplicado" end
report("Método 1 falló (" .. tostring(err) .. "). Método 2…")
local rig, e = buildRig(desc, hum.RigType)
if not rig then return false, "no se pudo crear el avatar: " .. tostring(e) end
report("Método 2: reemplazando el cuerpo…")
local base = bodyIssues(hum)
local okB, msgB = pcall(swapBody, rig)
local bodyMsg = ""
if okB and msgB then
local bad = waitHealthy(hum, base, 2)
if #bad > 0 then
removeItem("__body")
report("El cuerpo copiado se veía roto; se mantiene el tuyo")
else
bodyMsg = "cuerpo reemplazado, "
end
end
local ok2, msg = transplantRig(rig)
if ok2 then return true, bodyMsg .. "trasplante: " .. msg end
return false, msg
end
local function repairBody()
local hum = getHum()
if not hum then report("No hay personaje") return end
removeAllApplied()
if not baseDesc then
local ok, d = pcall(function() return hum:GetAppliedDescription() end)
if ok and d then baseDesc = d end
end
if baseDesc then
local okR = pcall(function() hum:ApplyDescriptionReset(baseDesc) end)
if not okR then pcall(function() hum:ApplyDescription(baseDesc) end) end
end
local bad = waitHealthy(hum, {}, 3)
if #bad == 0 then report("Cuerpo comprobado: está completo") else report("Aún faltan: " .. table.concat(bad, ", ") .. ". Reaparece para recuperarlo") end
end
env.XC_REPAIR = repairBody
local function applyReset(hum, d)
local done, ok = false, false
task.spawn(function()
ok = pcall(function() hum:ApplyDescriptionReset(d) end)
done = true
end)
local t0, k = os.clock(), 0
while not done and os.clock() - t0 < 10 and k < 120 do
k = k + 1
task.wait(0.1)
end
if done and ok then return true end
return applyDesc(hum, d)
end
local function restoreOriginal()
local hum = getHum()
if not hum then report("No hay personaje") return end
report("Volviendo a tu avatar de Roblox…")
removeAllApplied()
if env.XC_H.animClear then pcall(env.XC_H.animClear) end
local real
local okD, d = pcall(function() return Players:GetHumanoidDescriptionFromUserId(lp.UserId) end)
if okD and d then real = d end
local target = real or baseDesc
if not target then report("No pude leer tu avatar de Roblox") return end
applyReset(hum, target)
local bad = waitHealthy(hum, {}, 3)
if #bad > 0 and real then
report("Reparando el cuerpo (" .. table.concat(bad, ", ") .. ")…")
local rig = buildRig(real, hum.RigType)
if rig then
pcall(swapBody, rig)
applied["__body"] = nil
bad = waitHealthy(hum, {}, 2)
end
end
baseDesc = target
quickApplied = false
Sess.copy, Sess.skinId, Sess.items, Sess.anim = nil, nil, {}, {}
SessSave()
postApply()
if updateAll then pcall(updateAll) end
if #bad == 0 then
report("Listo: tu avatar y tus animaciones de Roblox")
else
report("Quedó casi todo; si falta una parte, reaparece para recuperarla")
end
end
env.XC_ORIGINAL = restoreOriginal
local function prepareItem(d)
if d.kind ~= "catalog" then return true end
local ok, info = pcall(function() return MarketplaceService:GetProductInfo(d.id) end)
if not ok or not info then return false, "No se pudo leer el item" end
local tid = info.AssetTypeId
local accName = ACC_BY_TYPE[tid]
if accName then
local okE, enum = pcall(function() return Enum.AccessoryType[accName] end)
if not okE or not enum then return false, "Tipo de accesorio no soportado" end
d.entry = { AssetId = d.id, AccessoryType = enum, IsLayered = (tid >= 64), Order = 1 }
d.kind = "acc"
return true
end
if PROP_BY_TYPE[tid] then
d.prop = PROP_BY_TYPE[tid]
d.kind = "prop"
return true
end
return false, "Este tipo de item no se puede probar (id tipo " .. tostring(tid) .. ")"
end
local function runDiagnostics()
report("Probando tu executor…")
local parts = {}
local obj, e1 = fetchObject(1028606)
parts[#parts + 1] = "Descargar items: " .. (obj and "OK" or ("FALLA " .. tostring(e1):sub(1, 40)))
local rig, e2 = miniRig(function() end)
parts[#parts + 1] = "Crear avatar: " .. (rig and "OK" or ("FALLA " .. tostring(e2):sub(1, 40)))
local hum = getHum()
local okG = hum and pcall(function() return hum:GetAppliedDescription() end)
parts[#parts + 1] = "Leer mi avatar: " .. (okG and "OK" or "FALLA")
parts[#parts + 1] = "Rig: " .. (hum and (isR15(hum) and "R15" or "R6") or "?")
report(table.concat(parts, " · "))
end
local restoreSession
restoreSession = function(rep2)
if Sess.auto == false then return end
if env.XC_SAFE then
warn("[Xcreet] El arranque anterior no terminó: se omite restaurar skin y objetos")
Sess.copy, Sess.items, Sess.skinId = nil, {}, nil
SessSave()
return
end
sessBusy = true
local list = {}
for key, it in pairs(Sess.items) do list[#list + 1] = { key = key, it = it } end
local total = #list + (Sess.copy and 1 or 0)
local n = 0
local function tick(txt)
n = n + 1
if rep2 then pcall(rep2, txt, total > 0 and n / total or 1) end
end
local hum = getHum()
if hum and Sess.copy and (Sess.copy.userId or Sess.copy.outfitId) then
if rep2 then pcall(rep2, "Avatar de " .. tostring(Sess.copy.name or "usuario"), 0) end
local desc = descFromCopy(Sess.copy)
if desc then pcall(fullCopy, desc) end
tick("Avatar de " .. tostring(Sess.copy.name or "usuario"))
end
table.sort(list, function(a, b) return a.key < b.key end)
for _, e in ipairs(list) do
local d = { key = e.key, kind = "catalog", id = e.it.id, name = e.it.name }
local ok = pcall(function()
local okP = prepareItem(d)
if okP then applyItem(d) end
end)
tick(tostring(e.it.name or "Objeto"))
end
sessBusy = false
if updateAll then pcall(updateAll) end
end
local function onChar(char)
saved = {}
accessoryStorage = {}
applied = {}
baseDesc = nil
quickApplied = false
local hum = char:WaitForChild("Humanoid", 10)
char:WaitForChild("HumanoidRootPart", 10)
task.wait(0.6)
if not hum then return end
if rigLabel then rigLabel.Text = isR15(hum) and "R15" or "R6" end
if state.korblox then pcall(applyKorblox, char, true) end
if state.headless then pcall(applyHeadless, char, true) end
if refreshAccessoriesFunc then refreshAccessoriesFunc() end
if updateAll then pcall(updateAll) end
if sessReady and (Sess.copy or next(Sess.items)) then
task.wait(0.8)
pcall(restoreSession)
end
end
track(lp.CharacterAdded:Connect(function(c) task.spawn(onChar, c) end))
local v0 = vp()
local hud, setMode, tPill, tWidget
do
local fps = 60
local function getPing()
local ok, v = pcall(function() return Stats.Network.ServerStatsItem["Data Ping"]:GetValue() end)
return ok and math.floor(v + 0.5) or 0
end
local function getMem()
local ok, v = pcall(function() return Stats:GetTotalMemoryUsageMb() end)
return ok and math.floor(v) or 0
end
local function fpsColor(f) return f >= 50 and T.green or (f >= 30 and T.yellow or T.red) end
local function pingColor(p) return p <= 80 and T.green or (p <= 160 and T.yellow or T.red) end
local pill = makePanel("FPSPill", UDim2.fromOffset(112, 36), UDim2.fromOffset(90, 60), 18)
local pillDot = new("Frame", {
Size = UDim2.fromOffset(8, 8), Position = UDim2.new(0, 14, 0.5, -4), BackgroundColor3 = T.green, BorderSizePixel = 0,
}, pill.glass)
circle(pillDot)
local pillText = label(pill.glass, {
Position = UDim2.fromOffset(30, 0), Size = UDim2.new(1, -38, 1, 0), Text = "60 FPS",
Font = Enum.Font.GothamBold, TextSize = 14,
})
local pillHit = new("TextButton", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", ZIndex = 20 }, pill.glass)
local widget = makePanel("Widget", UDim2.fromOffset(230, 100), UDim2.fromOffset(150, 80), 22)
local W = widget.glass
label(W, { Text = "Δ MONITOR", Position = UDim2.fromOffset(14, 9), Size = UDim2.new(0.5, 0, 0, 14), TextSize = 10, Font = Enum.Font.GothamBold, TextColor3 = T.sub })
local wTime = label(W, {
Position = UDim2.new(0.5, 0, 0, 9), Size = UDim2.new(0.5, -14, 0, 14), TextXAlignment = Enum.TextXAlignment.Right,
TextSize = 10, TextColor3 = T.sub,
})
local function column(i, caption)
local x = 14 + (i - 1) * 68
local v = label(W, { Position = UDim2.fromOffset(x, 28), Size = UDim2.fromOffset(66, 30), Font = Enum.Font.GothamBold, TextSize = 22, Text = "--" })
label(W, { Position = UDim2.fromOffset(x, 58), Size = UDim2.fromOffset(66, 14), Text = caption, TextSize = 10, TextColor3 = T.sub })
return v
end
local wFps = column(1, "FPS")
local wPing = column(2, "PING ms")
local wRam = column(3, "RAM MB")
local barBg = new("Frame", {
Position = UDim2.new(0, 14, 0, 82), Size = UDim2.new(1, -28, 0, 5), BackgroundColor3 = T.text,
BackgroundTransparency = 0.85, BorderSizePixel = 0,
}, W)
circle(barBg)
local barFill = new("Frame", { Size = UDim2.new(0.5, 0, 1, 0), BackgroundColor3 = T.green, BorderSizePixel = 0 }, barBg)
circle(barFill)
local widgetHit = new("TextButton", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", ZIndex = 20 }, W)
env.XC_KEEP = { pill.root, widget.root }
hud = { mode = "off" }
function setMode(m)
local from = (hud.mode == "widget") and widget or pill
hud.mode = m
if m == "pill" then
if not pill.open then pill.root.Position = from.root.Position panelShow(pill) end
if widget.open then panelHide(widget) end
elseif m == "widget" then
if not widget.open then widget.root.Position = from.root.Position panelShow(widget) end
if pill.open then panelHide(pill) end
else
if pill.open then panelHide(pill) end
if widget.open then panelHide(widget) end
end
if tPill then tPill.Set(m == "pill", true) end
if tWidget then tWidget.Set(m == "widget", true) end
end
makeDraggable(pillHit, pill.root, function() setMode("widget") end)
makeDraggable(widgetHit, widget.root, function() setMode("pill") end)
local acc, frames = 0, 0
track(RunService.RenderStepped:Connect(function(dt)
acc = acc + dt
frames = frames + 1
if acc >= 0.5 then
fps = math.floor(frames / acc + 0.5)
frames, acc = 0, 0
local col = fpsColor(fps)
if pill.open then
pillText.Text = fps .. " FPS"
pillDot.BackgroundColor3 = col
end
if widget.open then
local ping = getPing()
wFps.Text = tostring(fps)
wFps.TextColor3 = col
wPing.Text = tostring(ping)
wPing.TextColor3 = pingColor(ping)
wRam.Text = tostring(getMem())
wTime.Text = os.date("%H:%M") .. "  ·  " .. #Players:GetPlayers() .. "/" .. Players.MaxPlayers
barFill.BackgroundColor3 = col
tween(barFill, 0.4, { Size = UDim2.new(math.clamp(fps / 120, 0.03, 1), 0, 1, 0) })
end
end
end))
end
