} },
}
local catKw, catIdx, subIdx, catPages, catToken, catLoaded, catCount = "", 1, 1, nil, 0, false, 0
local catStatus, catList, catMore
local searchCatalog
local bundleKeys = {}
local function toggleBundle(id, nm)
if bundleKeys[id] then
for _, k in ipairs(bundleKeys[id]) do removeItem(k) end
bundleKeys[id] = nil
report("Quitado: " .. tostring(nm))
updateAll()
return
end
local ok, info = pcall(function() return MarketplaceService:GetProductInfo(id, Enum.InfoType.Bundle) end)
if not ok or type(info) ~= "table" or not info.Items then report("No pude leer el paquete") return end
local keys, n, lastErr = {}, 0, nil
for _, it in ipairs(info.Items) do
if it.Type == "Asset" then
local d = { key = "c_" .. it.Id, kind = "catalog", id = it.Id, name = it.Name }
local ok2, err = prepareItem(d)
if ok2 then ok2, err = applyItem(d) end
if ok2 then
n = n + 1
keys[#keys + 1] = d.key
else
lastErr = err
end
end
end
if n == 0 then report("No se pudo: " .. tostring(lastErr or "sin piezas compatibles")) return end
bundleKeys[id] = keys
updateAll()
report("Puesto: " .. tostring(nm) .. " (" .. n .. " piezas)")
end
local function priceText(price)
if price == nil then return "No disponible" end
if price == 0 then return "Gratis" end
return "R$ " .. tostring(price)
end
local catSort, catMin, catMax, catSale, catAlt = 1, nil, nil, 1, false
local SORTS = {
{ "Relevancia", "Relevance" }, { "Más vendidos", "Bestselling" }, { "Favoritos", "MostFavorited" },
{ "Recientes", "RecentlyCreated" }, { "Precio menor", "PriceLowToHigh" }, { "Precio mayor", "PriceHighToLow" },
}
local function gridFrame(page)
local f = new("Frame", {
Size = UDim2.new(1, 0, 0, 0), BackgroundTransparency = 1, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = nextOrder(),
}, page)
local gl = new("UIGridLayout", {
CellSize = UDim2.fromOffset(150, 216), CellPadding = UDim2.fromOffset(10, 10), SortOrder = Enum.SortOrder.LayoutOrder,
}, f)
local function relayout()
local w = f.AbsoluteSize.X
if type(w) ~= "number" or w < 100 then return end
local cols = math.max(2, math.floor((w + 10) / 170))
local cw = math.floor((w - 10 * (cols - 1)) / cols)
gl.CellSize = UDim2.fromOffset(cw, cw + 68)
end
track(f:GetPropertyChangedSignal("AbsoluteSize"):Connect(relayout))
relayout()
return f
end
local function catCard(d, parent)
local card = new("TextButton", {
Text = "", AutoButtonColor = false, BackgroundColor3 = T.white, BackgroundTransparency = 0.26,
BorderSizePixel = 0, LayoutOrder = nextOrder(),
}, parent or catList)
corner(card, 14)
local st = stroke(card, 0.35, 1.2)
local thumbUrl = d.thumb or ("rbxthumb://type=Asset&id=" .. tostring(d.id) .. "&w=420&h=420")
local img = new("ImageLabel", {
Position = UDim2.fromOffset(6, 6), Size = UDim2.new(1, -12, 1, -74), BackgroundColor3 = T.white,
BackgroundTransparency = 0.45, BorderSizePixel = 0, ScaleType = Enum.ScaleType.Fit, ImageTransparency = 1,
Image = thumbUrl,
}, card)
corner(img, 10)
task.spawn(function()
for k = 1, 44 do
if not img.Parent then return end
if img.IsLoaded == true then break end
if k == 22 and d.id then img.Image = thumbUrl:gsub("w=420&h=420", "w=150&h=150") end
task.wait(0.15)
end
if img.Parent then tween(img, 0.3, { ImageTransparency = 0 }) end
end)
local nameL = label(card, {
Position = UDim2.new(0, 9, 1, -64), Size = UDim2.new(1, -18, 0, 34), Text = d.name or "Cargando", TextSize = 12,
Font = Enum.Font.GothamBold, TextWrapped = true, TextYAlignment = Enum.TextYAlignment.Top,
TextTruncate = Enum.TextTruncate.AtEnd,
})
local priceL = label(card, {
Position = UDim2.new(0, 9, 1, -26), Size = UDim2.new(1, -18, 0, 18), Text = d.price or "", TextSize = 12,
Font = Enum.Font.GothamBold, TextColor3 = (d.price == "Gratis") and T.green or T.sub,
})
if d.tag then
local tg = label(card, {
Position = UDim2.fromOffset(12, 12), Size = UDim2.fromOffset(0, 16), AutomaticSize = Enum.AutomaticSize.X, Text = d.tag,
TextSize = 9, Font = Enum.Font.GothamBold, TextColor3 = T.white, BackgroundTransparency = 0.2,
BackgroundColor3 = Color3.fromRGB(30, 30, 36), TextXAlignment = Enum.TextXAlignment.Center,
TextTruncate = Enum.TextTruncate.None,
})
corner(tg, 8)
new("UIPadding", { PaddingLeft = UDim.new(0, 7), PaddingRight = UDim.new(0, 7) }, tg)
end
if not d.name and d.id then
task.spawn(function()
local n = itemName(d.id)
d.name = n
if nameL.Parent then nameL.Text = n end
end)
end
if d.second then
local pill = new("TextButton", {
AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -12, 0, 12), Size = UDim2.fromOffset(34, 20),
Text = d.secondText or "3D", Font = Enum.Font.GothamBold, TextSize = 10, TextColor3 = T.white,
AutoButtonColor = false, BorderSizePixel = 0,
}, card)
accentReg(pill, "BackgroundColor3")
circle(pill)
pill.Activated:Connect(function() task.spawn(safe, d.second) end)
end
local function upd()
local on = d.active and d.active() or false
st.Color = on and T.accent or Color3.fromRGB(255, 255, 255)
st.Transparency = on and 0 or 0.35
st.Thickness = on and 2 or 1.2
priceL.Text = on and "Puesto" or (d.price or "")
priceL.TextColor3 = on and T.accent or ((d.price == "Gratis") and T.green or T.sub)
end
updaters[card] = upd
upd()
local busy = false
card.Activated:Connect(function()
if busy then return end
busy = true
task.spawn(function()
safe(d.primary)
busy = false
updateAll()
end)
end)
return card
end
local function itemCard(id, nm, price)
local it = { key = "c_" .. id, kind = "catalog", id = id, name = nm }
local function primary()
if applied[it.key] then
removeItem(it.key)
report("Quitado: " .. tostring(it.name or "objeto"))
else
local ok, err = prepareItem(it)
if ok then ok, err = applyItem(it) end
if ok then report("Puesto: " .. tostring(it.name or "objeto")) else report("No se pudo poner: " .. tostring(err)) end
end
end
return catCard({
id = id, name = nm, price = price, primary = primary, active = function() return applied[it.key] ~= nil end,
second = function()
local obj = resolveItem(fetchObject(id))
openViewer(it.name or ("Objeto " .. tostring(id)), obj, id, function() return applied[it.key] ~= nil end, function(done)
task.spawn(function() primary() updateAll() if done then done() end end)
end)
end,
})
end
local function runSearch(assetTypes, bundleTypes, offsale)
local p = CatalogSearchParams.new()
p.SearchKeyword = catKw
pcall(function() p.SortType = Enum.CatalogSortType[SORTS[catSort][2]] end)
pcall(function() p.IncludeOffSale = offsale end)
if catSale == 3 then pcall(function() p.SalesTypeFilter = Enum.SalesTypeFilter.Premium end) end
if catSale == 4 then pcall(function() p.SalesTypeFilter = Enum.SalesTypeFilter.Collectibles end) end
local mn, mx = catMin, catMax
if catSale == 2 then mn, mx = 0, 0 end
if mn then pcall(function() p.MinPrice = mn end) end
if mx then pcall(function() p.MaxPrice = mx end) end
if assetTypes then p.AssetTypes = enumList(assetTypes, Enum.AvatarAssetType) end
if bundleTypes then p.BundleTypes = enumList(bundleTypes, Enum.BundleType) end
return AvatarEditorService:SearchCatalog(p)
end
local function pageLen(pg)
local ok, cur = pcall(function() return pg:GetCurrentPage() end)
return (ok and type(cur) == "table") and #cur or 0
end
searchCatalog = function(append)
catToken = catToken + 1
local tk = catToken
local f = CATS[catIdx][2][subIdx] or CATS[catIdx][2][1]
local mode = f[4]
catStatus.Text = "Buscando…"
catMore.Visible = false
if not append then
clearList(catList)
catPages = nil
catCount = 0
catAlt = false
end
local items, hasMore
if AvatarEditorService then
local ok = pcall(function()
if append and catPages then
catPages:AdvanceToNextPageAsync()
else
local pages = runSearch(f[2], f[3], false)
if pageLen(pages) == 0 then pages = runSearch(f[2], f[3], true) end
if pageLen(pages) == 0 and f[5] then
pages = runSearch(nil, f[5], true)
catAlt = true
end
catPages = pages
end
items = catPages:GetCurrentPage()
hasMore = not catPages.IsFinished
end)
if not ok then items = nil end
end
if not items and not append and mode == "item" then
local url = CATALOG_PROXY .. "?Category=11&Limit=30&Keyword=" .. HttpService:UrlEncode(catKw)
local body = httpGet(url)
if body then
local okj, data = pcall(function() return HttpService:JSONDecode(body) end)
if okj and data and data.data then
items = data.data
hasMore = false
end
end
end
if tk ~= catToken then return end
if not items then
catStatus.Text = "No se pudo conectar al catálogo"
return
end
local eff = catAlt and "bundle" or mode
for _, it in ipairs(items) do
local id = it.Id or it.id
local itype = tostring(it.ItemType or it.itemType or "Asset")
local nm = it.Name or it.name
local price = priceText(it.Price or it.price)
local thumbB = "rbxthumb://type=BundleThumbnail&id=" .. tostring(id) .. "&w=420&h=420"
if id then
if eff == "item" then
if itype:find("Asset") then
catCount = catCount + 1
itemCard(id, nm, price)
end
elseif eff == "emote" then
if itype:find("Asset") then
catCount = catCount + 1
catCard({
id = id, name = nm, price = price, tag = "Emote",
primary = function() AnimAPI.emoteWheel({ id = id, name = nm }) end,
second = function() AnimAPI.emoteView({ id = id, name = nm }) end, secondText = "Ver",
})
end
elseif eff == "slot" then
catCount = catCount + 1
local slot = f[6]
catCard({
id = id, name = nm, price = price, thumb = thumbB, tag = f[1],
primary = function() AnimAPI.packSlot(id, nm, slot) end,
second = function() AnimAPI.packSlotView(id, nm, slot) end, secondText = "Ver",
})
elseif eff == "pack" then
catCount = catCount + 1
catCard({
id = id, name = nm, price = price, thumb = thumbB, tag = "Pack",
primary = function() AnimAPI.packEquip(id, nm) end,
second = function() AnimAPI.packView(id, nm) end, secondText = "Ver",
})
elseif eff == "bundle" then
catCount = catCount + 1
catCard({
id = id, name = nm, price = price, thumb = thumbB, tag = "Paquete",
primary = function() toggleBundle(id, nm) end, active = function() return bundleKeys[id] ~= nil end,
})
end
end
end
local rango = ""
if catSale == 2 then rango = " · gratis"
elseif catMin or catMax then rango = " · R$ " .. tostring(catMin or 0) .. " a " .. tostring(catMax or "∞") end
	catStatus.Text = catCount .. " resultados" .. ((catKw ~= "") and (" para \"" .. catKw .. "\"") or "") .. rango
catMore.Visible = hasMore and #items > 0
end
InputRow(P4, "Buscar (ej: hat, wings, ninja, dance)", "Buscar", function(text)
catKw = tostring(text or "")
catLoaded = true
searchCatalog(false)
end)
local catNames = {}
for i, c in ipairs(CATS) do catNames[i] = c[1] end
local subChips = {}
Chips(P4, catNames, 100, function(i)
catIdx = i
subIdx = 1
for ci, ch in ipairs(subChips) do
ch.bar.Visible = (ci == catIdx)
if ci == catIdx then ch.Set(1, true) end
end
catLoaded = true
searchCatalog(false)
end, 1)
for ci, c in ipairs(CATS) do
local names = {}
for si, f in ipairs(c[2]) do names[si] = f[1] end
subChips[ci] = Chips(P4, names, 96, function(i)
subIdx = i
catLoaded = true
searchCatalog(false)
end, 1)
subChips[ci].bar.Visible = (ci == 1)
end
Section(P4, "Filtros")
Chips(P4, { "Relevancia", "Más vendidos", "Favoritos", "Recientes", "Precio menor", "Precio mayor" }, 100, function(i)
catSort = i
catLoaded = true
searchCatalog(false)
end, 1)
Chips(P4, { "Todo", "Gratis", "Premium", "Coleccionables" }, 100, function(i)
catSale = i
catLoaded = true
searchCatalog(false)
end, 1)
local priceChips
local function setRange(mn, mx)
catMin, catMax = mn, mx
catLoaded = true
searchCatalog(false)
end
priceChips = Chips(P4, { "Cualquier precio", "1 a 50", "50 a 200", "200 a 500", "500 o más" }, 110, function(i)
local r = { { nil, nil }, { 1, 50 }, { 50, 200 }, { 200, 500 }, { 500, nil } }
setRange(r[i][1], r[i][2])
end, 1)
InputRow(P4, "Precio en Robux (mín-máx, ej: 25-300)", "Aplicar", function(txt)
local a, b = tostring(txt or ""):match("(%d*)%s*[-–a]%s*(%d*)")
if not a and not b then
local only = tostring(txt or ""):match("%d+")
if only then a, b = "0", only end
end
if (a == nil or a == "") and (b == nil or b == "") then toast("Escribe un rango, ej: 25-300") return end
setRange(tonumber(a), tonumber(b))
end)
InputRow(P4, "Poner ropa u objeto por ID", "Añadir", function(txt)
local id = tostring(txt or ""):match("%d+")
if not id then toast("Escribe un ID") return end
itemCard(tonumber(id), nil, "Por ID")
end)
catStatus = Note(P4, "Toca Buscar o una categoría")
LogBox(P4, "Registro")
catList = gridFrame(P4)
env.XC_CAT = {
card = catCard, grid = gridFrame, bundle = toggleBundle, bundleKeys = bundleKeys, price = priceText,
enumList = enumList, translate = nil,
}
env.XC_CatSearch = function(q)
catKw = tostring(q or "")
catLoaded = true
if not win.open then openWindow() end
selectTab(4)
task.spawn(safe, searchCatalog, false)
end
catMore = Button(P4, "Cargar más", T.accent, function() searchCatalog(true) end)
catMore.Visible = false
tabHooks[4] = function()
if not catLoaded then
catLoaded = true
searchCatalog(false)
end
end
end)
if not okP then DG_Fail("Pestaña 4", eP) end
end
do
local okP, eP = pcall(function()
local P5 = pages[5]
local myScripts = env.DG_Scripts
if type(myScripts) ~= "table" then
myScripts = {}
if isfile and readfile then
pcall(function()
if isfile(SCRIPT_FILE) then
local data = HttpService:JSONDecode(readfile(SCRIPT_FILE))
if type(data) == "table" then myScripts = data end
end
end)
end
end
env.DG_Scripts = myScripts
local function saveScripts()
if writefile then
pcall(function() writefile(SCRIPT_FILE, HttpService:JSONEncode(myScripts)) end)
end
end
local function runCode(code)
local fn, err = loadstring(code)
if not fn then
toast("Error de sintaxis")
warn("[Xcreet] " .. tostring(err))
return
end
task.spawn(function()
local ok, e = pcall(fn)
if ok then toast("Script ejecutado") else toast("Error al ejecutar (ver consola)") warn("[Xcreet] " .. tostring(e)) end
end)
end
local function copyText(txt)
local cp = setclipboard or toclipboard or set_clipboard or (Clipboard and Clipboard.set)
if cp then
local ok = pcall(cp, txt)
toast(ok and "Copiado al portapapeles" or "No se pudo copiar")
else
toast("Tu executor no tiene portapapeles")
end
end
Section(P5, "Nuevo script")
local nameBox = InputRow(P5, "Nombre del script", "Limpiar", function() end)
local codeRow = Row(P5, 120)
local codeBox = new("TextBox", {
Position = UDim2.fromOffset(8, 8), Size = UDim2.new(1, -16, 1, -16), BackgroundColor3 = T.white,
BackgroundTransparency = 0.2, BorderSizePixel = 0, Text = "", PlaceholderText = "Pega aquí tu script…",
PlaceholderColor3 = T.sub, TextColor3 = T.text, Font = Enum.Font.Code, TextSize = 12, MultiLine = true,
TextWrapped = true, ClearTextOnFocus = false, TextXAlignment = Enum.TextXAlignment.Left,
TextYAlignment = Enum.TextYAlignment.Top, ClipsDescendants = true,
}, codeRow)
corner(codeBox, 12)
new("UIPadding", { PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8), PaddingTop = UDim.new(0, 6) }, codeBox)
local editing = nil
local scList
local renderScripts
ButtonRow(P5, {
{ "Guardar", T.green, function()
local name = nameBox.Text:gsub("^%s+", ""):gsub("%s+$", "")
if codeBox.Text == "" then toast("Escribe o pega un script") return end
if name == "" then name = "Script " .. (#myScripts + 1) end
if editing and myScripts[editing] then
myScripts[editing] = { name = name, code = codeBox.Text }
else
myScripts[#myScripts + 1] = { name = name, code = codeBox.Text }
end
editing = nil
saveScripts()
nameBox.Text, codeBox.Text = "", ""
renderScripts()
toast("Guardado")
end },
{ "Ejecutar", T.accent, function()
if codeBox.Text == "" then toast("No hay código") return end
runCode(codeBox.Text)
end },
{ "Limpiar", T.text, function()
editing = nil
nameBox.Text, codeBox.Text = "", ""
end },
})
Section(P5, "Guardados")
scList = listFrame(P5)
renderScripts = function()
clearList(scList)
if #myScripts == 0 then
local e = new("Frame", {
Size = UDim2.new(1, 0, 0, 36), BackgroundColor3 = T.white, BackgroundTransparency = 0.7,
BorderSizePixel = 0, LayoutOrder = 1,
}, scList)
corner(e, 14)
label(e, {
Text = "Aún no hay scripts guardados.", Position = UDim2.fromOffset(12, 0), Size = UDim2.new(1, -24, 1, 0),
Font = Enum.Font.Gotham, TextSize = 12, TextColor3 = T.sub, TextXAlignment = Enum.TextXAlignment.Center,
})
return
end
for i, s in ipairs(myScripts) do
local row = new("Frame", {
Size = UDim2.new(1, 0, 0, 46), BackgroundColor3 = T.white, BackgroundTransparency = 0.26,
BorderSizePixel = 0, LayoutOrder = i,
}, scList)
corner(row, 16)
stroke(row, 0.3, 1.2)
label(row, {
Text = s.name, Position = UDim2.fromOffset(14, 0), Size = UDim2.new(1, -262, 1, 0), TextSize = 13,
Font = Enum.Font.GothamBold,
})
local function mini(txt, x, color, cb, useAccent)
local b = new("TextButton", {
AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, x, 0.5, 0), Size = UDim2.fromOffset(56, 28),
BackgroundColor3 = color, Text = txt, Font = Enum.Font.GothamBold, TextSize = 11, TextColor3 = T.white,
AutoButtonColor = false, BorderSizePixel = 0,
}, row)
if useAccent then accentReg(b, "BackgroundColor3") end
circle(b)
b.Activated:Connect(function() cb(b) end)
return b
end
mini("Ejecutar", -194, T.green, function() runCode(s.code) end)
mini("Copiar", -132, T.accent, function() copyText(s.code) end, true)
mini("Editar", -70, T.yellow, function()
editing = i
nameBox.Text, codeBox.Text = s.name, s.code
toast("Editando · toca Guardar")
end)
local armed = false
mini("Borrar", -8, T.red, function(b)
if not armed then
armed = true
b.Text = "¿Seguro?"
task.delay(2, function()
armed = false
if b.Parent then b.Text = "Borrar" end
end)
else
table.remove(myScripts, i)
if editing == i then editing = nil end
saveScripts()
renderScripts()
end
end)
end
end
renderScripts()
end)
if not okP then DG_Fail("Pestaña 5", eP) end
end
local setBoost, clearShader, animRestore
do
local okP, eP = pcall(function()
local P6 = pages[6]
local boostFlags = { perf = false, fx = false, tex = false }
local boostSaved = {
perf = setmetatable({}, { __mode = "k" }),
fx = setmetatable({}, { __mode = "k" }),
tex = setmetatable({}, { __mode = "k" }),
}
local boostGlobal = nil
local boostConn
local FX_CLASSES = { "ParticleEmitter", "Trail", "Beam", "Fire", "Smoke", "Sparkles" }
local function isFx(o)
for _, c in ipairs(FX_CLASSES) do
if o:IsA(c) then return true end
end
return false
end
local function processInst(o)
if boostFlags.perf and o:IsA("BasePart") and not o:IsA("Terrain") then
local par = o.Parent
if not (par and par:FindFirstChildOfClass("Humanoid")) then
local s = boostSaved.perf[o]
if not s then
s = { Material = o.Material, Reflectance = o.Reflectance, CastShadow = o.CastShadow }
if o:IsA("MeshPart") then s.RenderFidelity = o.RenderFidelity end
boostSaved.perf[o] = s
end
o.Material = Enum.Material.SmoothPlastic
o.Reflectance = 0
o.CastShadow = false
if o:IsA("MeshPart") then pcall(function() o.RenderFidelity = Enum.RenderFidelity.Performance end) end
end
end
if boostFlags.fx and isFx(o) then
if boostSaved.fx[o] == nil then boostSaved.fx[o] = o.Enabled end
o.Enabled = false
end
if boostFlags.tex and (o:IsA("Decal") or o:IsA("Texture")) then
local par = o.Parent
if not (par and par.Parent and par.Parent:FindFirstChildOfClass("Humanoid")) then
if boostSaved.tex[o] == nil then boostSaved.tex[o] = o.Transparency end
o.Transparency = 1
end
end
end
local function boostScan()
task.spawn(function()
local n = 0
for _, o in ipairs(Workspace:GetDescendants()) do
pcall(processInst, o)
n = n + 1
if n % 400 == 0 then task.wait() end
end
end)
end
local function boostGlobalApply(on)
local Terrain = Workspace:FindFirstChildOfClass("Terrain")
if on then
if boostGlobal then return end
boostGlobal = { post = {} }
pcall(function() boostGlobal.q = settings().Rendering.QualityLevel end)
pcall(function() settings().Rendering.QualityLevel = Enum.QualityLevel.Level01 end)
boostGlobal.shadows = Lighting.GlobalShadows
Lighting.GlobalShadows = false
for _, e in ipairs(Lighting:GetChildren()) do
if e:IsA("PostEffect") and e.Name:sub(1, 3) ~= "DG_" and e.Name:sub(1, 3) ~= "XC_" then
boostGlobal.post[e] = e.Enabled
e.Enabled = false
end
end
if Terrain then
boostGlobal.water = {
Terrain.WaterWaveSize, Terrain.WaterWaveSpeed, Terrain.WaterReflectance, Terrain.WaterTransparency,
}
Terrain.WaterWaveSize, Terrain.WaterWaveSpeed, Terrain.WaterReflectance = 0, 0, 0
pcall(function() Terrain.Decoration = false end)
end
elseif boostGlobal then
pcall(function() if boostGlobal.q then settings().Rendering.QualityLevel = boostGlobal.q end end)
Lighting.GlobalShadows = boostGlobal.shadows
for e, v in pairs(boostGlobal.post) do pcall(function() e.Enabled = v end) end
if Terrain and boostGlobal.water then
local w = boostGlobal.water
Terrain.WaterWaveSize, Terrain.WaterWaveSpeed, Terrain.WaterReflectance, Terrain.WaterTransparency = w[1], w[2], w[3], w[4]
pcall(function() Terrain.Decoration = true end)
end
boostGlobal = nil
end
end
local function boostManageConn()
local any = boostFlags.perf or boostFlags.fx or boostFlags.tex
if any and not boostConn then
boostConn = Workspace.DescendantAdded:Connect(function(o) pcall(processInst, o) end)
elseif not any and boostConn then
boostConn:Disconnect()
boostConn = nil
end
end
local function boostRestore(flag)
local s = boostSaved[flag]
for o, v in pairs(s) do
pcall(function()
if flag == "perf" then
o.Material, o.Reflectance, o.CastShadow = v.Material, v.Reflectance, v.CastShadow
if v.RenderFidelity then o.RenderFidelity = v.RenderFidelity end
elseif flag == "fx" then
o.Enabled = v
else
o.Transparency = v
end
end)
s[o] = nil
end
end
function setBoost(flag, on)
boostFlags[flag] = on
if flag == "perf" then boostGlobalApply(on) end
if on then boostScan() else boostRestore(flag) end
boostManageConn()
end
Section(P6, "FPS Booster")
local tPerf = Toggle(P6, "Modo rendimiento", "Sin sombras, materiales lisos, calidad mínima", false, function(v) setBoost("perf", v) Sess.gfx.perf = v SessSave() end)
local tFx = Toggle(P6, "Sin partículas ni efectos", "Humo, fuego, estelas, rayos", false, function(v) setBoost("fx", v) Sess.gfx.fx = v SessSave() end)
local tTex = Toggle(P6, "Sin texturas", "Oculta decals y texturas del mapa", false, function(v) setBoost("tex", v) Sess.gfx.tex = v SessSave() end)
Stepper(P6, "Límite de FPS", 30, 360, 30, 60, "", function(v)
if setfpscap then setfpscap(v) else toast("Tu executor no soporta setfpscap") end
end)
ButtonRow(P6, {
{ "Máximo rendimiento", T.green, function()
tPerf.Set(true) tFx.Set(true) tTex.Set(true)
end },
{ "Restaurar todo", T.red, function()
tPerf.Set(false) tFx.Set(false) tTex.Set(false)
end },
})
local SHADERS = {
["RTX"] = {
tech = "Future", exposure = 0.15, softness = 0.25, bloom = { 0.55, 30, 0.9 }, sat = 0.12, con = 0.14,
tint = Color3.fromRGB(255, 250, 245), sun = 0.12,
atmo = { Density = 0.28, Offset = 0.15, Color = Color3.fromRGB(199, 215, 235), Decay = Color3.fromRGB(106, 112, 125), Glare = 0.25, Haze = 1.4 },
},
["Cinemático"] = {
tech = "Future", exposure = 0, softness = 0.3, bloom = { 0.35, 24, 1 }, sat = -0.08, con = 0.28,
tint = Color3.fromRGB(255, 236, 215), sun = 0.08, dof = 0.2,
atmo = { Density = 0.3, Offset = 0.25, Color = Color3.fromRGB(190, 175, 160), Decay = Color3.fromRGB(95, 80, 70), Glare = 0.1, Haze = 1.8 },
},
["Realista"] = {
tech = "Future", exposure = 0.05, softness = 0.2, bloom = { 0.3, 24, 1 }, sat = 0.05, con = 0.1,
tint = Color3.new(1, 1, 1), sun = 0.1,
atmo = { Density = 0.2, Offset = 0.1, Color = Color3.fromRGB(199, 220, 255), Decay = Color3.fromRGB(120, 130, 140), Glare = 0.1, Haze = 0.8 },
},
["Neón"] = {
tech = "Future", exposure = 0.1, softness = 0.2, bloom = { 1.2, 40, 0.7 }, sat = 0.55, con = 0.2,
tint = Color3.fromRGB(235, 210, 255), sun = 0,
},
["Atardecer"] = {
tech = "Future", exposure = 0.1, softness = 0.3, bloom = { 0.5, 28, 0.9 }, sat = 0.2, con = 0.1,
tint = Color3.fromRGB(255, 208, 165), sun = 0.22, clock = 17.6,
atmo = { Density = 0.35, Offset = 0.3, Color = Color3.fromRGB(255, 190, 140), Decay = Color3.fromRGB(190, 110, 90), Glare = 0.5, Haze = 2 },
},
["Frío"] = {
tech = "Future", exposure = 0, softness = 0.2, bloom = { 0.4, 26, 0.95 }, sat = 0.05, con = 0.12,
tint = Color3.fromRGB(205, 228, 255), sun = 0.08,
},
}
local SHADER_NAMES = { "Apagado", "RTX", "Cinemático", "Realista", "Neón", "Atardecer", "Frío" }
local shaderFx, shaderSaved, hiddenAtmos = {}, nil, {}
local shaderPreset = "Apagado"
local shaderAdj = { sat = 0, con = 0, bloom = 0 }
function clearShader()
for _, f in pairs(shaderFx) do pcall(function() f:Destroy() end) end
shaderFx = {}
for _, a in ipairs(hiddenAtmos) do pcall(function() a[1].Parent = a[2] end) end
hiddenAtmos = {}
if shaderSaved then
for k, v in pairs(shaderSaved) do
if k ~= "Technology" then pcall(function() Lighting[k] = v end) end
end
if shaderSaved.Technology then trySet(Lighting, "Technology", shaderSaved.Technology) end
shaderSaved = nil
end
end
local function applyShader(name)
shaderPreset = name
local p = SHADERS[name]
if not p then clearShader() return end
if not shaderSaved then
shaderSaved = {
ExposureCompensation = Lighting.ExposureCompensation, ShadowSoftness = Lighting.ShadowSoftness,
GlobalShadows = Lighting.GlobalShadows, ClockTime = Lighting.ClockTime,
EnvironmentDiffuseScale = Lighting.EnvironmentDiffuseScale, EnvironmentSpecularScale = Lighting.EnvironmentSpecularScale,
}
local okT, tech = pcall(function() return Lighting.Technology end)
if not okT and gethiddenproperty then okT, tech = pcall(gethiddenproperty, Lighting, "Technology") end
if okT then shaderSaved.Technology = tech end
end
for _, f in pairs(shaderFx) do pcall(function() f:Destroy() end) end
shaderFx = {}
if p.tech then
local okE, e = pcall(function() return Enum.Technology[p.tech] end)
if okE and e then trySet(Lighting, "Technology", e) end
end
pcall(function()
Lighting.ExposureCompensation = p.exposure or 0
Lighting.EnvironmentDiffuseScale = 1
Lighting.EnvironmentSpecularScale = 1
Lighting.ShadowSoftness = p.softness or 0.2
Lighting.GlobalShadows = true
if p.clock then Lighting.ClockTime = p.clock end
end)
shaderFx.bloom = new("BloomEffect", {
Name = "DG_Bloom", Intensity = math.max(0, p.bloom[1] + shaderAdj.bloom * 0.12), Size = p.bloom[2], Threshold = p.bloom[3],
}, Lighting)
shaderFx.cc = new("ColorCorrectionEffect", {
Name = "DG_CC", Saturation = p.sat + shaderAdj.sat * 0.06, Contrast = p.con + shaderAdj.con * 0.04,
TintColor = p.tint or Color3.new(1, 1, 1),
}, Lighting)
shaderFx.sun = new("SunRaysEffect", { Name = "DG_Sun", Intensity = p.sun or 0.05, Spread = 0.7 }, Lighting)
if p.dof then
shaderFx.dof = new("DepthOfFieldEffect", {
Name = "DG_DOF", FarIntensity = p.dof, FocusDistance = 60, InFocusRadius = 45, NearIntensity = 0,
}, Lighting)
end
if p.atmo then
for _, a in ipairs(Lighting:GetChildren()) do
if a:IsA("Atmosphere") and a.Name ~= "DG_Atmo" then
hiddenAtmos[#hiddenAtmos + 1] = { a, Lighting }
a.Parent = nil
end
end
local props = { Name = "DG_Atmo" }
for k, v in pairs(p.atmo) do props[k] = v end
shaderFx.atmo = new("Atmosphere", props, Lighting)
end
end
Section(P6, "Shaders / RTX")
local shChips = Chips(P6, SHADER_NAMES, 92, function(i, name) applyShader(name) Sess.gfx.preset = name SessSave() end, 1)
local function reShader() if SHADERS[shaderPreset] then applyShader(shaderPreset) end end
Stepper(P6, "Saturación", -5, 5, 1, 0, "", function(v) shaderAdj.sat = v reShader() end)
Stepper(P6, "Contraste", -5, 5, 1, 0, "", function(v) shaderAdj.con = v reShader() end)
Stepper(P6, "Bloom (brillo)", -5, 5, 1, 0, "", function(v) shaderAdj.bloom = v reShader() end)
Note(P6, "Usa iluminación Future, bloom y atmósfera. No es ray tracing real.")
Section(P6, "Máximo · shader avanzado")
local U = Sess.gfx.u
if type(U) ~= "table" then U = {} Sess.gfx.u = U end
local UD = { bloom = 0, sun = 0, dof = 0, atmo = 0, haze = 0, glare = 0, expo = 0, sat = 0, con = 0, soft = 0, spec = 0, water = 0, wet = 0, rain = 0, stars = 0, vig = 0, grade = 1, bars = false }
for k, v in pairs(UD) do if U[k] == nil then U[k] = v end end
local ufx, usaved, uAtmos, wetParts, wetTerrain = {}, nil, {}, {}, {}
local rainObj, rainConn, wetConn, fxGui, vigF = nil, nil, nil, nil, {}
local GRADES = {
Color3.fromRGB(255, 255, 255), Color3.fromRGB(255, 232, 205), Color3.fromRGB(205, 225, 255),
Color3.fromRGB(255, 218, 232), Color3.fromRGB(220, 255, 225), Color3.fromRGB(255, 240, 190),
}
local Terrain = Workspace:FindFirstChildOfClass("Terrain")
local function usave()
if usaved then return end
usaved = {
ExposureCompensation = Lighting.ExposureCompensation, ShadowSoftness = Lighting.ShadowSoftness,
EnvironmentSpecularScale = Lighting.EnvironmentSpecularScale, EnvironmentDiffuseScale = Lighting.EnvironmentDiffuseScale,
}
local okT, tech = pcall(function() return Lighting.Technology end)
if not okT and gethiddenproperty then okT, tech = pcall(gethiddenproperty, Lighting, "Technology") end
if okT then usaved.Technology = tech end
if Terrain then
usaved.WaterReflectance = Terrain.WaterReflectance
usaved.WaterTransparency = Terrain.WaterTransparency
usaved.WaterWaveSize = Terrain.WaterWaveSize
end
local sky = Lighting:FindFirstChildOfClass("Sky")
if sky then usaved.StarCount = sky.StarCount end
end
local function ufind(name, class, props)
local o = ufx[name]
if o and o.Parent then return o end
props = props or {}
props.Name = "XC_" .. name
o = new(class, props, Lighting)
ufx[name] = o
return o
end
local function udrop(name)
local o = ufx[name]
if o then pcall(function() o:Destroy() end) ufx[name] = nil end
end
local function wetClassify(p)
if not p:IsA("BasePart") or p:IsA("Terrain") or not p.Anchored then return false end
local s = p.Size
if s.X * s.Z < 300 or s.Y > 40 or p.Transparency > 0.9 then return false end
if math.abs(p.CFrame.UpVector.Y) < 0.9 then return false end
local m = p.Parent
if m and m:FindFirstChildOfClass("Humanoid") then return false end
return true
end
local function wetStyle(p, lvl)
local o = wetParts[p]
if not o then
o = { r = p.Reflectance, c = p.Color }
wetParts[p] = o
end
p.Reflectance = math.clamp(o.r + lvl * 0.032, 0, 0.45)
p.Color = o.c:Lerp(Color3.new(0, 0, 0), lvl * 0.028)
end
local WET_MATS = { "Grass", "Sand", "Ground", "Mud", "Asphalt", "Pavement", "Concrete", "Cobblestone", "Slate", "Rock", "Sandstone", "Basalt", "LeafyGrass", "Limestone", "Salt", "Snow" }
local wetToken = 0
local function wetApply()
wetToken = wetToken + 1
local tk = wetToken
local lvl = U.wet
if lvl <= 0 then
for p, o in pairs(wetParts) do pcall(function() p.Reflectance = o.r p.Color = o.c end) end
wetParts = {}
if Terrain then
for mat, c in pairs(wetTerrain) do pcall(function() Terrain:SetMaterialColor(mat, c) end) end
end
wetTerrain = {}
if wetConn then wetConn:Disconnect() wetConn = nil end
return
end
task.spawn(function()
local n = 0
for _, p in ipairs(Workspace:GetDescendants()) do
if tk ~= wetToken then return end
if wetClassify(p) then pcall(wetStyle, p, lvl) end
n = n + 1
if n % 400 == 0 then task.wait() end
end
if Terrain then
for _, mn in ipairs(WET_MATS) do
pcall(function()
local mat = Enum.Material[mn]
if wetTerrain[mat] == nil then wetTerrain[mat] = Terrain:GetMaterialColor(mat) end
Terrain:SetMaterialColor(mat, wetTerrain[mat]:Lerp(Color3.new(0, 0, 0), lvl * 0.04))
end)
end
end
end)
if not wetConn then
wetConn = Workspace.DescendantAdded:Connect(function(p)
if U.wet > 0 then
task.defer(function()
if wetClassify(p) then pcall(wetStyle, p, U.wet) end
end)
end
end)
end
end
local function rainApply()
if U.rain <= 0 then
if rainConn then rainConn:Disconnect() rainConn = nil end
if rainObj then pcall(function() rainObj:Destroy() end) rainObj = nil end
return
end
if not (rainObj and rainObj.Parent) then
rainObj = new("Part", {
Name = "XC_Rain", Anchored = true, CanCollide = false, CanQuery = false, CanTouch = false,
Transparency = 1, Size = Vector3.new(80, 1, 80),
}, Workspace)
new("ParticleEmitter", {
Name = "Drops", Texture = "rbxasset://textures/particles/smoke_main.dds", Lifetime = NumberRange.new(0.9, 1.1),
Speed = NumberRange.new(95, 115), EmissionDirection = Enum.NormalId.Bottom, SpreadAngle = Vector2.new(2, 2),
Size = NumberSequence.new(0.32), Transparency = NumberSequence.new(0.62), LightEmission = 0.25,
Color = ColorSequence.new(Color3.fromRGB(205, 220, 240)), Orientation = Enum.ParticleOrientation.VelocityParallel,
Acceleration = Vector3.new(0, -50, 0), LockedToPart = false,
}, rainObj)
end
local pe = rainObj:FindFirstChild("Drops")
if pe then pe.Rate = U.rain * 140 end
if not rainConn then
rainConn = RunService.RenderStepped:Connect(function()
local c = Workspace.CurrentCamera
if c and rainObj then rainObj.CFrame = CFrame.new(c.CFrame.Position + Vector3.new(0, 40, 0)) end
end)
end
end
local function fxGuiEnsure()
if fxGui and fxGui.Parent then return end
fxGui = new("ScreenGui", { Name = "XC_Fx", ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = 5, ZIndexBehavior = Enum.ZIndexBehavior.Sibling })
local okP2 = pcall(function() fxGui.Parent = gui.Parent end)
if not okP2 then fxGui.Parent = lp:WaitForChild("PlayerGui") end
vigF = {}
local defs = {
{ UDim2.new(0, 0, 0, 0), UDim2.new(1, 0, 0.38, 0), 90 }, { UDim2.new(0, 0, 0.62, 0), UDim2.new(1, 0, 0.38, 0), -90 },
{ UDim2.new(0, 0, 0, 0), UDim2.new(0.28, 0, 1, 0), 0 }, { UDim2.new(0.72, 0, 0, 0), UDim2.new(0.28, 0, 1, 0), 180 },
}
for i, d in ipairs(defs) do
local f = new("Frame", { Position = d[1], Size = d[2], BackgroundColor3 = Color3.new(0, 0, 0), BorderSizePixel = 0, ZIndex = 1 }, fxGui)
local g = new("UIGradient", { Rotation = d[3], Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.6), NumberSequenceKeypoint.new(1, 1) }) }, f)
vigF[i] = g
end
for i, top in ipairs({ true, false }) do
local b = new("Frame", {
AnchorPoint = Vector2.new(0, top and 0 or 1), Position = UDim2.new(0, 0, top and 0 or 1, 0), Size = UDim2.new(1, 0, 0, 0),
BackgroundColor3 = Color3.new(0, 0, 0), BorderSizePixel = 0, ZIndex = 2, Name = "Bar" .. i,
}, fxGui)
end
end
local function fxGuiApply()
if U.vig <= 0 and not U.bars then
if fxGui then pcall(function() fxGui:Destroy() end) fxGui = nil end
return
end
fxGuiEnsure()
for _, g in ipairs(vigF) do
local a = math.clamp(0.95 - U.vig * 0.07, 0.2, 1)
g.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, (U.vig <= 0) and 1 or a), NumberSequenceKeypoint.new(1, 1) })
end
for i = 1, 2 do
local b = fxGui:FindFirstChild("Bar" .. i)
if b then tween(b, 0.4, { Size = UDim2.new(1, 0, U.bars and 0.115 or 0, 0) }) end
end
end
local function uclear()
for name in pairs(ufx) do udrop(name) end
for _, a in ipairs(uAtmos) do pcall(function() a[1].Parent = a[2] end) end
uAtmos = {}
if usaved then
for k, v in pairs(usaved) do
if k == "Technology" then trySet(Lighting, "Technology", v)
elseif k == "StarCount" then
local sky = Lighting:FindFirstChildOfClass("Sky")
if sky then pcall(function() sky.StarCount = v end) end
elseif k:sub(1, 5) == "Water" then
if Terrain then pcall(function() Terrain[k] = v end) end
else
pcall(function() Lighting[k] = v end)
end
end
usaved = nil
end
end
local function uapplyNow()
local any = U.bars
for k, v in pairs(U) do
if k ~= "grade" and k ~= "bars" and type(v) == "number" and v ~= 0 then any = true end
end
if U.grade ~= 1 then any = true end
if not any then
uclear()
wetApply() rainApply() fxGuiApply()
return
end
usave()
local lvlMax = math.max(U.bloom, U.sun, U.atmo, U.spec, U.soft)
if lvlMax > 0 then
local okE, e = pcall(function() return Enum.Technology.Future end)
if okE and e then trySet(Lighting, "Technology", e) end
end
pcall(function()
Lighting.ExposureCompensation = (usaved.ExposureCompensation or 0) + U.expo * 0.15
Lighting.ShadowSoftness = (U.soft > 0) and math.clamp(U.soft * 0.1, 0, 1) or usaved.ShadowSoftness
if U.spec > 0 then
Lighting.EnvironmentSpecularScale = math.clamp(U.spec * 0.1, 0, 1)
Lighting.EnvironmentDiffuseScale = 1
else
Lighting.EnvironmentSpecularScale = usaved.EnvironmentSpecularScale
Lighting.EnvironmentDiffuseScale = usaved.EnvironmentDiffuseScale
end
end)
if U.bloom > 0 then
local b = ufind("Bloom", "BloomEffect")
b.Intensity, b.Size, b.Threshold = U.bloom * 0.14, 20 + U.bloom * 3, math.max(0.5, 1 - U.bloom * 0.045)
else udrop("Bloom") end
if U.sat ~= 0 or U.con ~= 0 or U.grade ~= 1 then
local c = ufind("CC", "ColorCorrectionEffect")
c.Saturation, c.Contrast, c.TintColor = U.sat * 0.1, U.con * 0.06, GRADES[U.grade] or GRADES[1]
else udrop("CC") end
if U.sun > 0 then
local s = ufind("Sun", "SunRaysEffect")
s.Intensity, s.Spread = math.clamp(U.sun * 0.05, 0, 0.5), math.clamp(0.25 + U.sun * 0.07, 0, 1)
else udrop("Sun") end
if U.dof > 0 then
local d = ufind("DOF", "DepthOfFieldEffect")
d.FarIntensity, d.FocusDistance, d.InFocusRadius, d.NearIntensity = math.clamp(U.dof * 0.07, 0, 1), 55, 40, 0
else udrop("DOF") end
if U.atmo > 0 or U.haze > 0 or U.glare > 0 then
if #uAtmos == 0 then
for _, a in ipairs(Lighting:GetChildren()) do
if a:IsA("Atmosphere") and a.Name ~= "XC_Atmo" and a.Name ~= "DG_Atmo" then
uAtmos[#uAtmos + 1] = { a, Lighting }
a.Parent = nil
end
end
end
local at = ufind("Atmo", "Atmosphere")
local tint = GRADES[U.grade] or GRADES[1]
at.Density = math.clamp(U.atmo * 0.05, 0, 0.6)
at.Offset = 0.25
at.Color = Color3.fromRGB(199, 215, 235):Lerp(tint, 0.5)
at.Decay = Color3.fromRGB(106, 112, 125):Lerp(tint, 0.35)
at.Glare = math.clamp(U.glare * 0.12, 0, 1)
at.Haze = math.clamp(U.haze * 0.5, 0, 5)
else
udrop("Atmo")
for _, a in ipairs(uAtmos) do pcall(function() a[1].Parent = a[2] end) end
uAtmos = {}
end
if Terrain then
if U.water > 0 then
Terrain.WaterReflectance = math.clamp(U.water * 0.1, 0, 1)
Terrain.WaterTransparency = math.clamp(0.9 - U.water * 0.05, 0.3, 1)
Terrain.WaterWaveSize = math.clamp(0.15 + U.water * 0.02, 0, 1)
elseif usaved then
Terrain.WaterReflectance, Terrain.WaterTransparency, Terrain.WaterWaveSize = usaved.WaterReflectance, usaved.WaterTransparency, usaved.WaterWaveSize
end
end
local sky = Lighting:FindFirstChildOfClass("Sky")
if sky then
if U.stars > 0 then pcall(function() sky.StarCount = U.stars * 500 end)
elseif usaved and usaved.StarCount then pcall(function() sky.StarCount = usaved.StarCount end) end
end
wetApply()
rainApply()
fxGuiApply()
end
local upend = false
local function uapply()
SessSave()
if upend then return end
upend = true
task.defer(function()
upend = false
local ok, e = pcall(uapplyNow)
if not ok then warn("[Xcreet] gráficos: " .. tostring(e)) end
end)
end
local ctl = {}
local function US(title, key, mn, mx)
ctl[key] = Stepper(P6, title, mn, mx, 1, U[key], "", function(v) U[key] = v uapply() end)
end
local UPRESETS = {
{ "Apagado", {} },
{ "Suave", { bloom = 2, sun = 2, atmo = 2, haze = 2, sat = 1, con = 1, soft = 3, spec = 3 } },
{ "Alto", { bloom = 4, sun = 4, dof = 2, atmo = 4, haze = 3, glare = 2, sat = 2, con = 2, soft = 5, spec = 5, vig = 3, stars = 3, water = 5 } },
{ "Máximo", { bloom = 6, sun = 7, dof = 4, atmo = 6, haze = 4, glare = 4, expo = 1, sat = 3, con = 3, soft = 8, spec = 8, vig = 5, wet = 4, water = 8, stars = 6 } },
{ "Cine", { bloom = 5, sun = 3, dof = 5, atmo = 4, haze = 5, con = 5, sat = -1, vig = 6, bars = true, grade = 2, soft = 6, spec = 5 } },
{ "Lluvia", { bloom = 3, atmo = 7, haze = 7, wet = 9, rain = 6, water = 9, con = 3, sat = -2, expo = -1, grade = 3, vig = 4, spec = 8, soft = 5 } },
}
local presetNames = {}
for i, p in ipairs(UPRESETS) do presetNames[i] = p[1] end
local gradeCtl, barsCtl
Chips(P6, presetNames, 84, function(i)
local pv = UPRESETS[i][2]
for k, d in pairs(UD) do U[k] = (pv[k] ~= nil) and pv[k] or d end
for k, c in pairs(ctl) do c.Set(U[k], true) end
if gradeCtl then gradeCtl.Set(U.grade, true) end
if barsCtl then barsCtl.Set(U.bars, true) end
uapply()
end, 1)
US("Bloom", "bloom", 0, 10)
US("Rayos de sol", "sun", 0, 10)
US("Profundidad de campo", "dof", 0, 10)
US("Atmósfera", "atmo", 0, 10)
US("Neblina", "haze", 0, 10)
US("Brillo del sol", "glare", 0, 10)
US("Exposición", "expo", -5, 10)
US("Saturación", "sat", -5, 10)
US("Contraste", "con", -5, 10)
US("Sombras suaves", "soft", 0, 10)
US("Reflejos del entorno", "spec", 0, 10)
US("Reflejos del agua", "water", 0, 10)
US("Suelo mojado", "wet", 0, 10)
US("Lluvia", "rain", 0, 10)
US("Estrellas", "stars", 0, 10)
US("Viñeta", "vig", 0, 10)
Note(P6, "Tono de color")
gradeCtl = Chips(P6, { "Neutro", "Cálido", "Frío", "Rosado", "Verde", "Dorado" }, 80, function(i) U.grade = i uapply() end, U.grade)
barsCtl = Toggle(P6, "Barras cinematográficas", nil, U.bars, function(v) U.bars = v uapply() end)
Button(P6, "Restablecer todo", T.red, function()
for k, d in pairs(UD) do U[k] = d end
for k, c in pairs(ctl) do c.Set(U[k], true) end
gradeCtl.Set(1, true)
barsCtl.Set(false, true)
uapply()
end)
env.XC_H.gfx = function()
if Sess.auto == false then return end
if Sess.gfx.perf then tPerf.Set(true) end
if Sess.gfx.fx then tFx.Set(true) end
if Sess.gfx.tex then tTex.Set(true) end
if Sess.gfx.preset and Sess.gfx.preset ~= "Apagado" and SHADERS[Sess.gfx.preset] then
for i, n in ipairs(SHADER_NAMES) do
if n == Sess.gfx.preset then shChips.Set(i, true) end
end
applyShader(Sess.gfx.preset)
end
pcall(uapplyNow)
end
env.DG_Cleanups = env.DG_Cleanups or {}
table.insert(env.DG_Cleanups, function()
local w, r, v, b = U.wet, U.rain, U.vig, U.bars
U.wet, U.rain, U.vig, U.bars = 0, 0, 0, false
pcall(wetApply) pcall(rainApply) pcall(fxGuiApply) pcall(uclear)
U.wet, U.rain, U.vig, U.bars = w, r, v, b
end)
end)
if not okP then DG_Fail("Pestaña 6", eP) end
end
do
local okP, eP = pcall(function()
local P7 = pages[7]
Section(P7, "Tema")
local presetNames = {}
for i, p in ipairs(PRESETS) do presetNames[i] = p.name end
Chips(P7, presetNames, 118, function(i) applyPreset(i) end, Style.preset or 1)
