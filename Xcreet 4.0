local status = Note(PV, "Escribe una palabra o toca Buscar")
local function deep(t)
if type(t) ~= "table" then return t end
local o = {}
for k, v in pairs(t) do o[k] = deep(v) end
return o
end
local PROPS_N = {
"Shirt", "Pants", "GraphicTShirt", "Face", "Head", "Torso", "LeftArm", "RightArm", "LeftLeg", "RightLeg",
"ClimbAnimation", "FallAnimation", "IdleAnimation", "JumpAnimation", "MoodAnimation", "RunAnimation", "SwimAnimation", "WalkAnimation",
"HeightScale", "WidthScale", "DepthScale", "HeadScale", "BodyTypeScale", "ProportionScale",
}
local PROPS_C = { "HeadColor", "TorsoColor", "LeftArmColor", "RightArmColor", "LeftLegColor", "RightLegColor" }
local function serDesc(desc)
local d = {}
for _, k in ipairs(PROPS_N) do
local ok, v = pcall(function() return desc[k] end)
if ok and type(v) == "number" then d[k] = v end
end
for _, k in ipairs(PROPS_C) do
local ok, v = pcall(function() return desc[k] end)
if ok and typeof(v) == "Color3" then d[k] = { math.floor(v.R * 255 + 0.5), math.floor(v.G * 255 + 0.5), math.floor(v.B * 255 + 0.5) } end
end
local accs = {}
local ok, list = pcall(function() return desc:GetAccessories(true) end)
if ok and type(list) == "table" then
for _, a in ipairs(list) do
pcall(function()
accs[#accs + 1] = { id = a.AssetId, ty = a.AccessoryType.Name, order = a.Order, layered = a.IsLayered, p = a.Puffiness }
end)
end
end
d.acc = accs
return d
end
local function deserDesc(d)
local desc = Instance.new("HumanoidDescription")
for k, v in pairs(d) do
if k ~= "acc" then
if type(v) == "table" then
pcall(function() desc[k] = Color3.fromRGB(v[1], v[2], v[3]) end)
else
pcall(function() desc[k] = v end)
end
end
end
local list = {}
for _, a in ipairs(d.acc or {}) do
local okE, e = pcall(function() return Enum.AccessoryType[a.ty] end)
if okE and e then
list[#list + 1] = { AssetId = a.id, AccessoryType = e, Order = a.order or 1, IsLayered = a.layered and true or false, Puffiness = a.p }
end
end
pcall(function() desc:SetAccessories(list, true) end)
return desc
end
