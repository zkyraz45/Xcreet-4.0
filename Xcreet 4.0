{ name = "Sakura", g = { { 255, 240, 245 }, { 255, 205, 220 } }, b = { { 255, 175, 200 }, { 255, 215, 230 } }, stroke = { 255, 255, 255 }, accent = { 240, 110, 150 }, decor = "cute" },
{ name = "Océano", g = { { 235, 248, 255 }, { 190, 225, 245 } }, b = { { 120, 200, 235 }, { 150, 170, 240 } }, stroke = { 255, 255, 255 }, accent = { 70, 150, 215 }, decor = "none" },
{ name = "Atardecer", g = { { 255, 245, 232 }, { 255, 205, 180 } }, b = { { 255, 160, 120 }, { 240, 130, 170 } }, stroke = { 255, 255, 255 }, accent = { 235, 120, 90 }, decor = "none" },
{ name = "Limón", g = { { 255, 252, 230 }, { 250, 238, 170 } }, b = { { 250, 225, 110 }, { 190, 230, 140 } }, stroke = { 255, 255, 255 }, accent = { 215, 170, 40 }, decor = "none" },
{ name = "Algodón", g = { { 250, 240, 255 }, { 215, 235, 255 } }, b = { { 255, 180, 225 }, { 170, 215, 255 } }, stroke = { 255, 255, 255 }, accent = { 200, 140, 235 }, decor = "cute" },
{ name = "Cristal", g = { { 255, 255, 255 }, { 222, 230, 245 } }, b = { { 200, 215, 245 }, { 235, 225, 250 } }, stroke = { 255, 255, 255 }, accent = { 52, 56, 70 }, decor = "none" },
{ name = "Bosque", g = { { 238, 250, 240 }, { 190, 225, 200 } }, b = { { 120, 200, 150 }, { 175, 215, 120 } }, stroke = { 255, 255, 255 }, accent = { 65, 160, 105 }, decor = "none" },
}
local function c3(t) return Color3.fromRGB(t[1], t[2], t[3]) end
local Style = env.DG_Style
if type(Style) ~= "table" then
Style = nil
if isfile and readfile then
pcall(function()
if isfile(STYLE_FILE) then
local d = HttpService:JSONDecode(readfile(STYLE_FILE))
if type(d) == "table" and d.accent and d.g1 then Style = d end
end
end)
end
end
if not Style then
local p = PRESETS[3]
Style = {
preset = 3, g1 = p.g[1], g2 = p.g[2], b1 = p.b[1], b2 = p.b[2], stroke = p.stroke, accent = p.accent,
decor = p.decor, pattern = "Corazones", wallId = "", wallAlpha = 6,
}
end
if type(Style.stickers) ~= "table" then Style.stickers = {} end
if Style.wallAlpha == nil then Style.wallAlpha = 6 end
if Style.uiScale == nil then Style.uiScale = 1 end
if Style.glassT == nil then Style.glassT = 0 end
if Style.wallId == nil then Style.wallId = "" end
if Style.pattern == nil then Style.pattern = "Corazones" end
if Style.decor == nil then Style.decor = "none" end
if Style.ver ~= 4 then
local cp
for i, p in ipairs(PRESETS) do if p.name == "Cristal" then cp = p Style.preset = i end end
if cp then
Style.g1, Style.g2, Style.b1, Style.b2, Style.stroke, Style.accent = cp.g[1], cp.g[2], cp.b[1], cp.b[2], cp.stroke, cp.accent
Style.decor, Style.pattern = "none", "Ninguno"
end
Style.ver = 4
end
if Style.blur == nil then Style.blur = 14 end
env.DG_Style = Style
T.accent = c3(Style.accent)
local function saveStyle()
if writefile then pcall(function() writefile(STYLE_FILE, HttpService:JSONEncode(Style)) end) end
end
local Sess = { v = 1 }
if isfile and readfile then
pcall(function()
if isfile(SESS_FILE) then
local d = HttpService:JSONDecode(readfile(SESS_FILE))
if type(d) == "table" then Sess = d end
end
end)
end
if type(Sess.anim) ~= "table" then Sess.anim = {} end
if type(Sess.items) ~= "table" then Sess.items = {} end
if type(Sess.gfx) ~= "table" then Sess.gfx = {} end
if type(Sess.ev) ~= "table" then Sess.ev = {} end
local sessDirty, sessBusy, sessReady = false, false, false
env.XC_H = {}
local function SessSave()
if sessDirty then return end
sessDirty = true
task.delay(0.6, function()
sessDirty = false
if writefile then pcall(function() writefile(SESS_FILE, HttpService:JSONEncode(Sess)) end) end
end)
end
local gui = new("ScreenGui", {
Name = "DG_" .. tostring(math.random(100000, 999999)),
ResetOnSpawn = false, IgnoreGuiInset = true,
ZIndexBehavior = Enum.ZIndexBehavior.Sibling, DisplayOrder = 999,
})
