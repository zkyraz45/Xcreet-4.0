Text = "Aplicar", Font = Enum.Font.GothamBold, TextSize = 13, TextColor3 = T.white, AutoButtonColor = false,
BorderSizePixel = 0,
}, row)
accentReg(go, "BackgroundColor3")
circle(go)
track(go.Activated:Connect(function()
local a1, a2 = hexToArr(b1.Text), hexToArr(b2.Text)
if not a1 or not a2 then toast("Escribe dos colores hex válidos") return end
Style.g1, Style.g2 = a1, a2
applyStyle()
end))
end
Section(P7, "Fondo de pantalla")
local patNames = { "Ninguno", "Corazones", "Puntitos", "Brillitos", "Burbujas" }
local patIdx = 1
for i, n in ipairs(patNames) do if n == Style.pattern then patIdx = i end end
local patChips = Chips(P7, patNames, 104, function(i, n)
Style.pattern = n
applyStyle()
end, patIdx)
InputRow(P7, "ID de imagen de Roblox", "Aplicar", function(txt)
local id = tostring(txt or ""):match("%d+")
if not id then toast("ID inválido") return end
Style.wallId = id
applyStyle()
toast("Fondo aplicado")
end)
Stepper(P7, "Visibilidad de la imagen", 1, 10, 1, Style.wallAlpha or 6, "", function(v)
Style.wallAlpha = v
applyStyle()
end)
ButtonRow(P7, {
{ "Quitar imagen", T.red, function()
Style.wallId = ""
applyStyle()
end },
{ "Restablecer estilo", T.text, function()
Style.pattern = "Corazones"
Style.wallId = ""
Style.wallAlpha = 6
patChips.Set(2, true)
applyPreset(1)
end },
})
Section(P7, "En pantalla")
tPill = Toggle(P7, "Contador de FPS", nil, false, function(v) setMode(v and "pill" or "off") end)
tWidget = Toggle(P7, "Widget de rendimiento", nil, false, function(v) setMode(v and "widget" or "off") end)
Section(P7, "Menú")
local keyRow = Row(P7, 44)
titles(keyRow, "Abrir / cerrar", nil, 190)
label(keyRow, {
AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -14, 0.5, 0), Size = UDim2.fromOffset(170, 24),
TextXAlignment = Enum.TextXAlignment.Right, TextSize = 12, TextColor3 = T.sub, Text = "RightShift · botón Δ",
})
Button(P7, "Cerrar menú", T.text, closeWindow)
local function destroyAll()
for _, f in ipairs(env.DG_Cleanups or {}) do pcall(f) end
state.fly, state.noclip, state.infjump, state.speed, state.jump = false, false, false, false, false
pcall(flyStop)
local hum = getHum()
if hum then pcall(function() hum.WalkSpeed = 16 hum.UseJumpPower = true hum.JumpPower = 50 end) end
pcall(setFullbright, false)
pcall(removeAllApplied)
pcall(clearShader)
if animRestore then pcall(animRestore) end
pcall(function() setBoost("perf", false) setBoost("fx", false) setBoost("tex", false) end)
local c = getChar()
if c then
if state.korblox then pcall(applyKorblox, c, false) end
if state.headless then pcall(applyHeadless, c, false) end
end
for _, cn in ipairs(conns) do pcall(function() cn:Disconnect() end) end
pcall(function() gui:Destroy() end)
env.DeltaGlassUnload = nil
end
env.DeltaGlassUnload = destroyAll
Button(P7, "Descargar script (apagar todo)", T.red, function()
closeWindow()
task.delay(0.35, destroyAll)
end)
end)
if not okP then DG_Fail("Pestaña 7", eP) end
end
do
local okP, eP = pcall(function()
local WS, R, BS = 310, 108, 64
local DEFAULTS = {
{ n = "Saludar", i = 507770239, k = "anim" }, { n = "Señalar", i = 507770453, k = "anim" },
{ n = "Celebrar", i = 507770677, k = "anim" }, { n = "Reír", i = 507770818, k = "anim" },
{ n = "Bailar 1", i = 507771019, k = "anim" }, { n = "Bailar 2", i = 507776043, k = "anim" },
{ n = "Bailar 3", i = 507777268, k = "anim" },
}
if type(Style.wheel) ~= "table" then Style.wheel = {} end
for i = 1, 8 do
if type(Style.wheel[i]) ~= "table" then
local d = DEFAULTS[i]
Style.wheel[i] = d and { n = d.n, i = d.i, k = d.k } or {}
end
end
local wheel = makePanel("EmoteWheel", UDim2.fromOffset(WS, WS), UDim2.fromOffset(v0.X / 2, v0.Y / 2), WS / 2)
wheel.root.ZIndex = 50
local bubble = makePanel("EmoteBubble", UDim2.fromOffset(48, 48), UDim2.fromOffset(v0.X / 2 + 70, 66), 24)
bubble.root.ZIndex = 40
local closeOnPick = true
local objs = {}
if type(Style.wheelCfg) ~= "table" then Style.wheelCfg = {} end
local bgImg = new("ImageLabel", {
Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ScaleType = Enum.ScaleType.Crop, Visible = false, ZIndex = 1,
}, wheel.glass)
circle(bgImg)
local function colOf(a)
if type(a) == "table" and #a >= 3 then return Color3.fromRGB(a[1], a[2], a[3]) end
return nil
end
local function deep(t)
if type(t) ~= "table" then return t end
local o = {}
for k, v in pairs(t) do o[k] = deep(v) end
return o
end
local function refresh(i)
local o, s = objs[i], Style.wheel[i]
if not o then return end
if s and s.i then
o.ph.Visible = false
if s.t then
o.im.Image = "rbxthumb://type=Asset&id=" .. tostring(s.t) .. "&w=150&h=150"
o.im.Visible = true
o.nm.Text = tostring(s.n or "")
o.nm.Visible = true
o.txt.Visible = false
else
o.im.Visible = false
o.nm.Visible = false
o.txt.Text = tostring(s.n or "Emote")
o.txt.Visible = true
end
else
o.im.Visible, o.nm.Visible, o.txt.Visible = false, false, false
o.ph.Visible = true
end
end
function Wheel.open()
if wheel.open then return end
wheel.root.Position = UDim2.fromOffset(vp().X / 2, vp().Y / 2)
panelShow(wheel)
end
function Wheel.close() if wheel.open then panelHide(wheel) end end
function Wheel.toggle() if wheel.open then Wheel.close() else Wheel.open() end end
function Wheel.setClose(v) closeOnPick = v and true or false end
for i = 1, 8 do
local a = math.rad(-90 + (i - 1) * 45)
local b = new("TextButton", {
AnchorPoint = Vector2.new(0.5, 0.5),
Position = UDim2.fromOffset(WS / 2 + math.cos(a) * R, WS / 2 + math.sin(a) * R),
Size = UDim2.fromOffset(BS, BS), BackgroundColor3 = T.white, BackgroundTransparency = 0.3,
Text = "", AutoButtonColor = false, BorderSizePixel = 0, ZIndex = 5,
}, wheel.glass)
circle(b)
local sk = stroke(b, 0.1, 2)
sk.Parent = b
accentReg(sk, "Color")
local im = new("ImageLabel", {
Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ScaleType = Enum.ScaleType.Crop,
Visible = false, ZIndex = 6,
}, b)
circle(im)
local nm = label(b, {
Text = "", Size = UDim2.new(1, -8, 0, 14), Position = UDim2.new(0, 4, 1, -18), TextSize = 9,
Font = Enum.Font.GothamBold, TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 8,
BackgroundTransparency = 0.25, BackgroundColor3 = T.white, Visible = false,
})
corner(nm, 7)
local txt = label(b, {
Text = "", Size = UDim2.new(1, -8, 1, -8), Position = UDim2.fromOffset(4, 4), TextSize = 11,
Font = Enum.Font.GothamBold, TextXAlignment = Enum.TextXAlignment.Center, TextWrapped = true,
TextTruncate = Enum.TextTruncate.None, ZIndex = 7, Visible = false,
})
local ph = label(b, {
Text = tostring(i), Size = UDim2.fromScale(1, 1), TextSize = 22, Font = Enum.Font.FredokaOne,
TextColor3 = T.sub, TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 7,
})
objs[i] = { im = im, nm = nm, txt = txt, ph = ph, b = b, sk = sk }
refresh(i)
track(b.Activated:Connect(function()
local s = Style.wheel[i]
if not (s and s.i) then toast("Espacio " .. i .. " vacío · asígnalo en la pestaña Emotes") return end
tween(b, 0.1, { Size = UDim2.fromOffset(BS - 8, BS - 8) })
task.delay(0.12, function() tween(b, 0.25, { Size = UDim2.fromOffset(BS, BS) }, Enum.EasingStyle.Back) end)
if closeOnPick then Wheel.close() end
if Wheel.play then task.spawn(safe, Wheel.play, s) end
end))
end
local center = new("TextButton", {
AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(74, 74),
Text = "✕", Font = Enum.Font.GothamBold, TextSize = 24, TextColor3 = T.white, AutoButtonColor = false,
BorderSizePixel = 0, ZIndex = 5,
}, wheel.glass)
circle(center)
accentReg(center, "BackgroundColor3")
stroke(center, 0.2, 2)
makeDraggable(center, wheel.root, function() Wheel.close() end)
local bl = label(bubble.glass, {
Size = UDim2.fromScale(1, 1), Text = Style.wheelIcon or "◉", Font = Enum.Font.GothamBold, TextSize = 26,
TextXAlignment = Enum.TextXAlignment.Center, TextTruncate = Enum.TextTruncate.None,
})
local bhit = new("TextButton", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", ZIndex = 20 }, bubble.glass)
makeDraggable(bhit, bubble.root, function() Wheel.toggle() end)
function Wheel.setIcon(t)
t = tostring(t or "")
if t == "" then return end
Style.wheelIcon = t
bl.Text = t
saveStyle()
end
function Wheel.showBubble(on)
Style.wheelOn = on and true or false
if on then
if not bubble.open then panelShow(bubble) end
else
if bubble.open then panelHide(bubble) end
Wheel.close()
end
saveStyle()
end
function Wheel.set(i, data)
Style.wheel[i] = data or {}
refresh(i)
saveStyle()
end
function Wheel.reset()
for i = 1, 8 do
local d = DEFAULTS[i]
Style.wheel[i] = d and { n = d.n, i = d.i, k = d.k } or {}
refresh(i)
end
saveStyle()
end
function Wheel.applyCfg()
local c = Style.wheelCfg
if c.bg then
bgImg.Image = "rbxthumb://type=Asset&id=" .. tostring(c.bg) .. "&w=420&h=420"
bgImg.ImageTransparency = math.clamp(tonumber(c.bgT) or 0.2, 0, 1)
bgImg.Visible = true
else
bgImg.Visible = false
end
local sc, rc, tc = colOf(c.slot), colOf(c.ring), colOf(c.text)
for _, o in ipairs(objs) do
o.b.BackgroundColor3 = sc or T.white
o.sk.Color = rc or T.accent
o.txt.TextColor3 = tc or T.text
o.ph.TextColor3 = tc or T.sub
o.nm.TextColor3 = tc or T.text
o.nm.BackgroundColor3 = sc or T.white
end
center.BackgroundColor3 = rc or T.accent
end
function Wheel.setCfg(k, v)
Style.wheelCfg[k] = v
Wheel.applyCfg()
saveStyle()
end
function Wheel.resetCfg()
Style.wheelCfg = {}
Wheel.applyCfg()
saveStyle()
end
function Wheel.snapshot()
return { slots = deep(Style.wheel), cfg = deep(Style.wheelCfg) }
end
function Wheel.load(p)
if type(p) ~= "table" then return end
Style.wheel = deep(p.slots) or {}
for i = 1, 8 do if type(Style.wheel[i]) ~= "table" then Style.wheel[i] = {} end end
Style.wheelCfg = deep(p.cfg) or {}
for i = 1, 8 do refresh(i) end
Wheel.applyCfg()
saveStyle()
end
repaintFns[#repaintFns + 1] = function() Wheel.applyCfg() end
Wheel.applyCfg()
function Wheel.sync()
pcall(function()
wheel.wall.Image = win.wall.Image
wheel.wall.ImageTransparency = win.wall.ImageTransparency
wheel.wall.Visible = win.wall.Visible
end)
end
if Style.wheelOn ~= false then panelShow(bubble) end
end)
if not okP then DG_Fail("Rueda de emotes", eP) end
end
do
local okP, eP = pcall(function()
local P8 = pages[8]
local curTrack, loopEmote, stopOnMove = nil, Sess.loop ~= false, true
local chosen = {}   -- espacio -> lista de ids (se vuelven a poner al reaparecer)
local origIds = {}  -- Animation -> id original
local equippedNames, updSummary = {}, nil
local isPreview = false
local SLOT_NAMES = { "idle", "walk", "run", "jump", "fall", "climb", "swim", "swimidle" }
local SLOT_LABELS = { "Quieto", "Caminar", "Correr", "Saltar", "Caer", "Trepar", "Nadar", "Flotar" }
local SLOT_LABEL = {}
for i, s in ipairs(SLOT_NAMES) do SLOT_LABEL[s] = SLOT_LABELS[i] end
local EMOTES = {
{ "Saludar", 507770239 }, { "Señalar", 507770453 }, { "Celebrar", 507770677 }, { "Reír", 507770818 },
{ "Bailar 1", 507771019 }, { "Bailar 2", 507776043 }, { "Bailar 3", 507777268 },
}
local function idStr(id)
local n = tostring(id):match("%d+")
return n and ("rbxassetid://" .. n) or nil
end
local function animateScript()
local c = getChar()
return c and c:FindFirstChild("Animate")
end
local function stopEmote()
isPreview = false
if curTrack then
local t = curTrack
curTrack = nil
pcall(function() t:Stop(0.2) end)
end
end
local function playAnimId(id, looped)
local hum = getHum()
if not hum then return false, "No hay personaje" end
local animator = hum:FindFirstChildOfClass("Animator")
if not animator then
animator = Instance.new("Animator")
animator.Parent = hum
end
stopEmote()
local anim = Instance.new("Animation")
anim.AnimationId = "rbxassetid://" .. tostring(id)
local ok, track = pcall(function() return animator:LoadAnimation(anim) end)
if not ok or not track then return false, "no se pudo cargar" end
pcall(function() track.Priority = Enum.AnimationPriority.Action end)
pcall(function() track.Looped = looped and true or false end)
local t0 = os.clock()
while track.Length == 0 and os.clock() - t0 < 3 do task.wait(0.1) end
if track.Length == 0 then
pcall(function() track:Destroy() end)
return false, "esa animación no está permitida aquí"
end
track:Play(0.2)
curTrack = track
local mine = track
track.Stopped:Connect(function()
task.defer(function()
if curTrack == mine and loopEmote then pcall(function() mine:Play(0.15) end) end
end)
end)
return true
end
local function playEmote(id)
local ok, err = playAnimId(id, loopEmote)
if not ok then report("Emote: " .. tostring(err)) end
end
local function resolveAnimIds(assetId)
local ids = {}
local obj = fetchObject(assetId)
if obj then
if obj:IsA("Animation") then ids[#ids + 1] = obj.AnimationId end
for _, x in ipairs(obj:GetDescendants()) do
if x:IsA("Animation") then ids[#ids + 1] = x.AnimationId end
end
end
return ids
end
local function playResolved(id, kind, looped)
local cand = {}
local function addId(v)
local n = tostring(v):match("%d+")
if n then cand[#cand + 1] = n end
end
if kind == "asset" then
for _, s in ipairs(resolveAnimIds(id)) do addId(s) end
addId(id)
else
addId(id)
for _, s in ipairs(resolveAnimIds(id)) do addId(s) end
end
local lastErr = "sin animación"
for _, n in ipairs(cand) do
local ok, err = playAnimId(n, looped)
if ok then return true end
lastErr = err
end
return false, lastErr
end
Wheel.play = function(s)
local ok, err = playResolved(s.i, s.k, loopEmote)
if not ok then report("Emote: " .. tostring(err)) end
end
track(RunService.Heartbeat:Connect(function()
if curTrack and stopOnMove and not isPreview then
local hum = getHum()
if hum and hum.MoveDirection.Magnitude > 0.1 then stopEmote() end
end
end))
local function setSlot(slot, ids, nm)
local an = animateScript()
if not an then return false, "tu personaje no tiene el script Animate" end
local folder = an:FindFirstChild(slot)
if not folder then return false, "no existe '" .. slot .. "' en este juego" end
local list = {}
for _, a in ipairs(folder:GetChildren()) do
if a:IsA("Animation") then list[#list + 1] = a end
end
table.sort(list, function(x, y) return x.Name < y.Name end)
for i, a in ipairs(list) do
local s = idStr(ids[i] or ids[1])
if s then
if origIds[a] == nil then origIds[a] = a.AnimationId end
a.AnimationId = s
end
end
chosen[slot] = ids
equippedNames[slot] = nm or equippedNames[slot] or ("ID " .. (tostring(ids[1]):match("%d+") or "?"))
Sess.anim[slot] = { ids = ids, name = equippedNames[slot] }
SessSave()
if updSummary then pcall(updSummary) end
return #list > 0
end
local function refreshAnimate()
local hum = getHum()
local animator = hum and hum:FindFirstChildOfClass("Animator")
if animator then
for _, t in ipairs(animator:GetPlayingAnimationTracks()) do
pcall(function() t:Stop(0) end)
end
end
local an = animateScript()
if an then
pcall(function() an.Disabled = true end)
task.wait()
pcall(function() an.Disabled = false end)
end
end
local function restoreAnim()
stopEmote()
for a, id in pairs(origIds) do pcall(function() a.AnimationId = id end) end
origIds = {}
chosen = {}
equippedNames = {}
Sess.anim = {}
SessSave()
if updSummary then pcall(updSummary) end
refreshAnimate()
end
animRestore = restoreAnim
for slot, v in pairs(Sess.anim) do
if type(v) == "table" and type(v.ids) == "table" then
chosen[slot] = v.ids
equippedNames[slot] = v.name
end
end
local function reapplyChosen(passes)
for pass = 1, passes do
local an = animateScript()
if an then
for slot, ids in pairs(chosen) do pcall(setSlot, slot, ids, equippedNames[slot]) end
refreshAnimate()
end
if pass < passes then task.wait(pass == 1 and 0.8 or 1.6) end
end
end
env.XC_H.animApply = function(map)
if type(map) ~= "table" then return end
for slot, v in pairs(map) do
if type(v) == "table" and type(v.ids) == "table" then pcall(setSlot, slot, v.ids, v.name) end
end
pcall(refreshAnimate)
end
env.XC_H.animClear = function() pcall(restoreAnim) end
env.XC_H.anim = function()
if Sess.auto == false or next(chosen) == nil then return end
reapplyChosen(1)
end
track(lp.CharacterAdded:Connect(function(ch)
origIds = {}
curTrack = nil
if next(chosen) == nil then return end
task.spawn(function()
ch:WaitForChild("Animate", 12)
reapplyChosen(3)
end)
end))
local watchAcc = 0
track(RunService.Heartbeat:Connect(function(dt)
watchAcc = watchAcc + (tonumber(dt) or 0)
if watchAcc < 2.5 then return end
watchAcc = 0
if next(chosen) == nil then return end
local an = animateScript()
if not an then return end
local bad = false
for slot, ids in pairs(chosen) do
local folder = an:FindFirstChild(slot)
local first = folder and folder:FindFirstChildWhichIsA("Animation")
local want = idStr(ids[1])
if first and want and first.AnimationId ~= want then bad = true break end
end
if bad then
origIds = {}
task.spawn(reapplyChosen, 1)
end
end))
Section(P8, "Emotes")
LogBox(P8, "Registro")
local function emoteRow(a, b, c)
local defs = {}
for _, e in ipairs({ a, b, c }) do
if e then defs[#defs + 1] = { e[1], T.accent, function() playEmote(e[2]) end } end
end
ButtonRow(P8, defs)
end
emoteRow(EMOTES[1], EMOTES[2], EMOTES[3])
emoteRow(EMOTES[4], EMOTES[5], EMOTES[6])
emoteRow(EMOTES[7])
InputRow(P8, "ID de emote o animación", "Reproducir", function(txt)
local n = tostring(txt or ""):match("%d+")
if not n then toast("ID inválido") return end
playEmote(n)
end)
Toggle(P8, "Repetir en bucle", nil, loopEmote, function(v)
loopEmote = v
Sess.loop = v
SessSave()
if curTrack then pcall(function() curTrack.Looped = v end) end
end)
Toggle(P8, "Detener al moverme", nil, true, function(v) stopOnMove = v end)
Button(P8, "Detener emote", T.red, stopEmote)
Section(P8, "Rueda de emotes")
Note(P8, "Toca la bolita de arriba para abrir la rueda (la puedes mover).")
Toggle(P8, "Mostrar bolita", nil, Style.wheelOn ~= false, function(v) Wheel.showBubble(v) end)
Toggle(P8, "Cerrar rueda al elegir", nil, true, function(v) Wheel.setClose(v) end)
local wheelSlot = 1
local wheelChips = Chips(P8, { "1", "2", "3", "4", "5", "6", "7", "8" }, 44, function(i) wheelSlot = i end, 1)
local function assignWheel(name, id, kind)
Wheel.set(wheelSlot, { n = name, i = id, k = kind, t = (kind == "asset") and id or nil })
toast("Espacio " .. wheelSlot .. ": " .. tostring(name))
end
local function assignNext(name, id, kind)
assignWheel(name, id, kind)
local nx = wheelSlot % 8 + 1
wheelSlot = nx
wheelChips.Set(nx, true)
end
InputRow(P8, "ID y nombre para el espacio elegido", "Asignar", function(txt)
local id, nm = tostring(txt or ""):match("(%d+)%s*(.*)")
if not id then toast("Escribe un ID") return end
if nm == "" then nm = "Emote " .. wheelSlot end
assignWheel(nm, tonumber(id), "anim")
end)
ButtonRow(P8, {
{ "Abrir rueda", T.accent, function() Wheel.open() end },
{ "Vaciar espacio", T.red, function() Wheel.set(wheelSlot, {}) end },
{ "Por defecto", T.text, function() Wheel.reset() end },
})
InputRow(P8, "Símbolo de la bolita", "Cambiar", function(t) Wheel.setIcon(t) end)
Section(P8, "Aspecto de la rueda")
Note(P8, "Fondo con el ID de una imagen o decal de Roblox. Los colores pueden ser un preajuste o un hex.")
local function parseHex(txt)
local h = tostring(txt or ""):gsub("%s+", "")
local ok, c = pcall(Color3.fromHex, h)
if not ok or typeof(c) ~= "Color3" then return nil end
return { math.floor(c.R * 255 + 0.5), math.floor(c.G * 255 + 0.5), math.floor(c.B * 255 + 0.5) }
end
InputRow(P8, "ID de imagen de fondo", "Aplicar", function(t)
local id = tostring(t or ""):match("%d+")
if not id then toast("Escribe un ID") return end
Wheel.setCfg("bg", tonumber(id))
toast("Fondo aplicado")
end)
Stepper(P8, "Opacidad del fondo (%)", 0, 100, 10, math.floor((1 - (tonumber(Style.wheelCfg and Style.wheelCfg.bgT) or 0.2)) * 100 + 0.5), "", function(v)
Wheel.setCfg("bgT", 1 - v / 100)
end)
ButtonRow(P8, {
{ "Quitar fondo", T.red, function() Wheel.setCfg("bg", nil) end },
{ "Abrir rueda", T.accent, function() Wheel.open() end },
})
local WPRE = {
{ "Original", nil }, { "Negro", { 22, 22, 26 } }, { "Blanco", { 244, 244, 248 } }, { "Rosa", { 255, 143, 184 } },
{ "Azul", { 110, 160, 255 } }, { "Verde", { 110, 220, 160 } }, { "Morado", { 170, 130, 255 } },
}
local function colorBlock(title, key)
Note(P8, title)
local names = {}
for i, p in ipairs(WPRE) do names[i] = p[1] end
local has = Style.wheelCfg and Style.wheelCfg[key]
Chips(P8, names, 70, function(i) Wheel.setCfg(key, WPRE[i][2]) end, has and 0 or 1)
InputRow(P8, "Hex (ej: #FF8FB8)", "Aplicar", function(t)
local a = parseHex(t)
if not a then toast("Color inválido") return end
Wheel.setCfg(key, a)
end)
end
colorBlock("Color de los espacios", "slot")
colorBlock("Color del borde y del centro", "ring")
colorBlock("Color del texto", "text")
Button(P8, "Restablecer aspecto", T.text, function() Wheel.resetCfg() toast("Aspecto restablecido") end)
Section(P8, "Configuraciones de la rueda")
Note(P8, "Guarda los 8 espacios junto con el aspecto y cámbialos con un toque.")
local profBox
local rebuildProf
rebuildProf = function()
clearList(profBox)
local list = Style.wheelProfiles
if type(list) ~= "table" or #list == 0 then Note(profBox, "Aún no guardaste ninguna") return end
for i, p in ipairs(list) do
local row = Row(profBox, 44)
label(row, {
Position = UDim2.fromOffset(14, 0), Size = UDim2.new(1, -170, 1, 0), Text = tostring(p.name or ("Config " .. i)),
TextSize = 13, Font = Enum.Font.GothamBold,
})
local del = new("TextButton", {
AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0), Size = UDim2.fromOffset(66, 28),
BackgroundColor3 = T.red, Text = "Borrar", Font = Enum.Font.GothamBold, TextSize = 12, TextColor3 = T.white,
AutoButtonColor = false, BorderSizePixel = 0,
}, row)
circle(del)
local use = new("TextButton", {
AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -82, 0.5, 0), Size = UDim2.fromOffset(66, 28),
Text = "Cargar", Font = Enum.Font.GothamBold, TextSize = 12, TextColor3 = T.white,
AutoButtonColor = false, BorderSizePixel = 0,
}, row)
accentReg(use, "BackgroundColor3")
circle(use)
track(use.Activated:Connect(function()
Wheel.load(p)
toast("Rueda: " .. tostring(p.name))
end))
track(del.Activated:Connect(function()
table.remove(Style.wheelProfiles, i)
saveStyle()
rebuildProf()
end))
end
end
InputRow(P8, "Nombre de la configuración", "Guardar", function(t)
local nm = tostring(t or ""):gsub("^%s+", ""):gsub("%s+$", "")
if nm == "" then toast("Escribe un nombre") return end
if type(Style.wheelProfiles) ~= "table" then Style.wheelProfiles = {} end
local snap = Wheel.snapshot()
snap.name = nm
local done = false
for i, p in ipairs(Style.wheelProfiles) do
if p.name == nm then Style.wheelProfiles[i] = snap done = true end
end
if not done then Style.wheelProfiles[#Style.wheelProfiles + 1] = snap end
saveStyle()
rebuildProf()
toast("Guardada: " .. nm)
end)
profBox = listFrame(P8)
rebuildProf()
Section(P8, "Animaciones del personaje")
Note(P8, "Mezcla: ej. correr de un pack y saltar de otro.")
local sumRow = Row(P8, 44)
local sumL = label(sumRow, {
Position = UDim2.fromOffset(12, 0), Size = UDim2.new(1, -24, 1, 0), TextSize = 11, Font = Enum.Font.Gotham,
TextColor3 = T.sub, TextWrapped = true, TextTruncate = Enum.TextTruncate.None,
})
updSummary = function()
local parts = {}
for _, s in ipairs(SLOT_NAMES) do
if equippedNames[s] then parts[#parts + 1] = SLOT_LABEL[s] .. ": " .. tostring(equippedNames[s]) end
end
sumL.Text = (#parts > 0) and ("Equipadas · " .. table.concat(parts, " · ")) or "Equipadas: ninguna (usas las normales)"
end
updSummary()
Note(P8, "Packs, emotes y animaciones sueltas: búscalos en la pestaña Catálogo.")
local copyUserAnims
local slotIdx = 1
Chips(P8, SLOT_LABELS, 84, function(i) slotIdx = i end, 1)
InputRow(P8, "ID de animación para el espacio elegido", "Poner", function(txt)
local n = tostring(txt or ""):match("%d+")
if not n then toast("ID inválido") return end
local ok, err = setSlot(SLOT_NAMES[slotIdx], { n }, "ID " .. n)
if ok then
refreshAnimate()
report("Animación puesta en: " .. SLOT_LABELS[slotIdx])
else
report("No se pudo: " .. tostring(err))
end
end)
InputRow(P8, "Copiar animaciones de un usuario", "Copiar", function(txt) copyUserAnims(txt) end)
Button(P8, "Restaurar mis animaciones", T.text, function()
restoreAnim()
report("Animaciones originales restauradas")
end)
local ANIM_TYPE_SLOT = { [48] = "climb", [50] = "fall", [51] = "idle", [52] = "jump", [53] = "run", [54] = "swim", [55] = "walk" }
local function useAnimItem(d)
local ok, info = pcall(function() return MarketplaceService:GetProductInfo(d.id) end)
local tid = ok and info and info.AssetTypeId or nil
local ids = {}
local obj = fetchObject(d.id)
if obj then
if obj:IsA("Animation") then ids[#ids + 1] = obj.AnimationId end
for _, x in ipairs(obj:GetDescendants()) do
if x:IsA("Animation") then ids[#ids + 1] = x.AnimationId end
end
end
local slot = tid and ANIM_TYPE_SLOT[tid]
if slot then
if #ids == 0 then ids[1] = d.id end
local okS, err = setSlot(slot, ids, d.name)
if okS then
refreshAnimate()
report("Puesta: " .. tostring(d.name or "animación"))
else
report("No se pudo: " .. tostring(err))
end
return
end
local okE, errE = playResolved(d.id, "asset", loopEmote)
if okE then report("Reproduciendo: " .. tostring(d.name or "emote")) else report("Emote: " .. tostring(errE)) end
end
local function slotAndIds(id)
local ok, info = pcall(function() return MarketplaceService:GetProductInfo(id) end)
local tid = (ok and type(info) == "table") and info.AssetTypeId or nil
local found = {}
local obj = fetchObject(id)
if obj then
if obj:IsA("Animation") then found[#found + 1] = { obj.Name, obj.AnimationId } end
for _, x in ipairs(obj:GetDescendants()) do
if x:IsA("Animation") then found[#found + 1] = { x.Name, x.AnimationId } end
end
end
table.sort(found, function(a, b) return a[1] < b[1] end)
local ids = {}
for i, f in ipairs(found) do ids[i] = f[2] end
return tid and ANIM_TYPE_SLOT[tid] or nil, ids
end
local function useBundle(bundleId, bname)
report("Cargando pack " .. tostring(bname) .. "…")
local ok, info = pcall(function() return MarketplaceService:GetProductInfo(bundleId, Enum.InfoType.Bundle) end)
if not ok or type(info) ~= "table" or not info.Items then report("No pude leer el pack") return end
local n = 0
for _, it in ipairs(info.Items) do
if it.Type == "Asset" then
local slot, ids = slotAndIds(it.Id)
if slot then
if #ids == 0 then ids[1] = it.Id end
if setSlot(slot, ids, tostring(bname)) then n = n + 1 end
end
end
end
if n == 0 then report("No se pudo: el pack no trae animaciones o el juego no usa Animate") return end
refreshAnimate()
report("Pack puesto: " .. tostring(bname) .. " (" .. n .. ")")
end
copyUserAnims = function(txt)
local name = tostring(txt or ""):gsub("%s+", "")
if name == "" then toast("Escribe un usuario") return end
report("Buscando a " .. name .. "…")
local okU, uid = pcall(function() return Players:GetUserIdFromNameAsync(name) end)
if not okU or not uid then report("Usuario no encontrado") return end
local okD, desc = pcall(function() return Players:GetHumanoidDescriptionFromUserId(uid) end)
if not okD or not desc then report("No se pudo leer su avatar") return end
local n = 0
for slot, prop in pairs({
idle = "IdleAnimation", walk = "WalkAnimation", run = "RunAnimation", jump = "JumpAnimation",
fall = "FallAnimation", climb = "ClimbAnimation", swim = "SwimAnimation",
}) do
local okP, v = pcall(function() return desc[prop] end)
if okP and type(v) == "number" and v > 0 then
local _, ids = slotAndIds(v)
if #ids == 0 then ids[1] = v end
if setSlot(slot, ids, name) then n = n + 1 end
end
end
if n == 0 then report("Ese usuario usa las animaciones normales") return end
refreshAnimate()
report("Animaciones copiadas (" .. n .. ")")
end
local function previewIds(ids, nm)
local n = tostring(ids[1] or ""):match("%d+")
if not n then report("No hay animación para probar") return end
local okp, err = playAnimId(n, true)
if okp then
isPreview = true
report("Probando: " .. tostring(nm) .. " · «Detener emote» para parar")
else
report("No se puede probar: " .. tostring(err))
end
end
local function loadPackAnims(bundleId)
local ok, info = pcall(function() return MarketplaceService:GetProductInfo(bundleId, Enum.InfoType.Bundle) end)
if not ok or type(info) ~= "table" or not info.Items then return nil end
local list = {}
for _, it in ipairs(info.Items) do
if it.Type == "Asset" then
local slot, ids = slotAndIds(it.Id)
if #ids == 0 then ids[1] = it.Id end
local lbl = slot and SLOT_LABEL[slot] or "Animación"
list[#list + 1] = { name = tostring(it.Name or lbl), label = lbl, slot = slot, ids = ids, id = it.Id }
end
end
return list
end
local function previewRig()
local c, hum = getChar(), getHum()
if c and hum and isR15(hum) then
pcall(function() c.Archivable = true end)
local ok, clone = pcall(function() return c:Clone() end)
if ok and clone and clone:FindFirstChildOfClass("Humanoid") then return clone end
end
local ok, rig = pcall(function()
return Players:CreateHumanoidModelFromDescription(Instance.new("HumanoidDescription"), Enum.HumanoidRigType.R15)
end)
if ok and rig then return rig end
return nil
end
local function equipOne(a)
if not a then return end
if not a.slot then report("Esa no es una animación de movimiento") return end
local okS, err = setSlot(a.slot, a.ids, a.name)
if okS then
refreshAnimate()
report("Puesta en " .. tostring(a.label) .. ": " .. tostring(a.name))
else
report("No se pudo: " .. tostring(err))
end
end
local function viewPack(bundleId, bname)
report("Cargando «" .. tostring(bname) .. "»…")
local list = loadPackAnims(bundleId)
if not list or #list == 0 then report("No pude leer las animaciones de ese pack") return end
local rig = previewRig()
if not rig then report("No pude crear el muñeco 3D") return end
openViewer(tostring(bname), rig, nil, nil, nil, nil, {
anims = list,
act = { text = "Poner esta", cb = function(a) equipOne(a) end },
act2 = { text = "Poner todo", cb = function() useBundle(bundleId, bname) end },
})
end
local function viewAnim(d)
report("Cargando animación…")
local slot, ids = slotAndIds(d.id)
if #ids == 0 then ids[1] = d.id end
local rig = previewRig()
if not rig then report("No pude crear el muñeco 3D") return end
local a = { name = tostring(d.name or "Animación"), label = slot and SLOT_LABEL[slot] or "Animación", slot = slot, ids = ids }
openViewer(a.name, rig, nil, nil, nil, nil, {
anims = { a },
act = { text = "Poner", cb = function() equipOne(a) end },
act2 = { text = "Probar en mí", cb = function() previewIds(ids, a.name) end },
})
end
local function emoteCandidates(id)
local cand = {}
for _, s in ipairs(resolveAnimIds(id)) do
local n = tostring(s):match("%d+")
if n then cand[#cand + 1] = n end
end
cand[#cand + 1] = tostring(id)
return cand
end
local function viewEmote(d)
report("Cargando emote…")
local rig = previewRig()
if not rig then report("No pude crear el muñeco 3D") return end
local nm = tostring(d.name or "Emote")
openViewer(nm, rig, nil, nil, nil, nil, {
anims = { { name = nm, label = "Emote", ids = emoteCandidates(d.id) } },
act = { text = "A rueda", cb = function() assignNext(nm, d.id, "asset") end },
act2 = { text = "Probar en mí", cb = function() isPreview = false Wheel.play({ i = d.id, k = "asset" }) end },
})
end
AnimAPI.packEquip = useBundle
AnimAPI.packSlot = function(bundleId, bname, slot)
report("Cargando «" .. tostring(bname) .. "»…")
local list = loadPackAnims(bundleId)
if not list then report("No pude leer el pack") return end
for _, a in ipairs(list) do
if a.slot == slot then equipOne(a) return end
end
report("Ese pack no trae " .. tostring(SLOT_LABEL[slot] or slot))
end
AnimAPI.packSlotView = function(bundleId, bname, slot)
report("Cargando «" .. tostring(bname) .. "»…")
local list = loadPackAnims(bundleId)
if not list then report("No pude leer el pack") return end
local pick
for _, a in ipairs(list) do
if a.slot == slot then pick = a break end
end
if not pick then report("Ese pack no trae " .. tostring(SLOT_LABEL[slot] or slot)) return end
local rig = previewRig()
if not rig then report("No pude crear el muñeco 3D") return end
openViewer(tostring(bname) .. " · " .. tostring(SLOT_LABEL[slot]), rig, nil, nil, nil, nil, {
anims = { pick },
act = { text = "Poner", cb = function(a) equipOne(a) end },
act2 = { text = "Poner todo", cb = function() useBundle(bundleId, bname) end },
})
end
AnimAPI.packView = viewPack
AnimAPI.animEquip = function(d) useAnimItem(d) end
AnimAPI.animView = viewAnim
AnimAPI.emoteView = viewEmote
AnimAPI.emoteWheel = function(d) assignNext(tostring(d.name or "Emote"), d.id, "asset") end
end)
if not okP then DG_Fail("Pestaña 8", eP) end
end
