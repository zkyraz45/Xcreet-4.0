local function isEnemyPlayer(pl)
if pl == lp or ignore[pl.Name:lower()] then return false end
if A.team and pl.Team ~= nil and lp.Team ~= nil and pl.Team == lp.Team then return false end
return true
end
local function candidates()
local list = {}
for _, pl in ipairs(Players:GetPlayers()) do
if isEnemyPlayer(pl) and pl.Character then list[#list + 1] = { ch = pl.Character, name = pl.DisplayName } end
end
if A.npc then
for m in pairs(npcs) do
if m.Parent then list[#list + 1] = { ch = m, name = m.Name } else npcs[m] = nil end
end
end
return list
end
local function pick(ch, cam, c)
local hum = ch:FindFirstChildOfClass("Humanoid")
if not hum or hum.Health <= 0 then return nil end
local head = ch:FindFirstChild("Head")
local torso = ch:FindFirstChild("UpperTorso") or ch:FindFirstChild("Torso") or ch:FindFirstChild("HumanoidRootPart")
if A.part == 1 then return head or torso, hum end
if A.part == 2 then return torso or head, hum end
local best, bd
for _, p in ipairs({ head, torso }) do
if p then
local sp = cam:WorldToViewportPoint(p.Position)
local d = (Vector2.new(sp.X, sp.Y) - c).Magnitude
if not bd or d < bd then best, bd = p, d end
end
end
return best, hum
end
local function visibleTo(part, ch, cam)
if not A.wall then return true end
local rp = RaycastParams.new()
pcall(function() rp.FilterType = Enum.RaycastFilterType.Exclude end)
rp.FilterDescendantsInstances = { lp.Character, ch }
local o = cam.CFrame.Position
return Workspace:Raycast(o, part.Position - o, rp) == nil
end
local function engaged()
if not A.on then return false end
if A.act == 1 then return true end
if A.act == 2 then return UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) end
return UIS:IsKeyDown(Enum.KeyCode[A.keyName] or Enum.KeyCode.Q)
end
local function fireShot(vp)
local tool = lp.Character and lp.Character:FindFirstChildOfClass("Tool")
if tool then pcall(function() tool:Activate() end) return end
if mouse1click then pcall(mouse1click) return end
local vim
pcall(function() vim = game:GetService("VirtualInputManager") end)
if vim then
pcall(function()
vim:SendMouseButtonEvent(vp.X / 2, vp.Y / 2, 0, true, game, 0)
task.wait(0.02)
vim:SendMouseButtonEvent(vp.X / 2, vp.Y / 2, 0, false, game, 0)
end)
end
end
local lastShot, espAcc = 0, 0
local function step(dt)
dt = tonumber(dt) or 0.016
local cam = Workspace.CurrentCamera
if not cam then return end
local vp = cam.ViewportSize
local c = (A.center == 2) and UIS:GetMouseLocation() or Vector2.new(vp.X / 2, vp.Y / 2)
apState.Text = A.on and "ON" or "OFF"
apState.TextColor3 = A.on and T.green or Color3.fromRGB(140, 140, 148)
apS.Color = A.on and T.green or Color3.new(1, 1, 1)
apS.Transparency = A.on and 0.1 or 0.75
ring.Visible = A.on and A.circle
ring.Position = UDim2.fromOffset(c.X, c.Y)
ring.Size = UDim2.fromOffset(A.fov * 2, A.fov * 2)
dotF.Visible = A.on and A.cross
dotF.Position = UDim2.fromOffset(vp.X / 2, vp.Y / 2)
if not A.on then
cur, curPart, curChar, silentPos, silentPart = nil, nil, nil, nil, nil
hlTarget.Enabled = false
infoL.Visible = false
for ch, h in pairs(espHl) do pcall(function() h:Destroy() end) espHl[ch] = nil end
return
end
local list = candidates()
local camPos = cam.CFrame.Position
local best, bestPart, bestScore, bestHum, bestName
if A.sticky and curChar and curChar.Parent and curPart and curPart.Parent then
local part, hum = pick(curChar, cam, c)
if part and hum.Health > 0 then
local sp, on = cam:WorldToViewportPoint(part.Position)
if on and (Vector2.new(sp.X, sp.Y) - c).Magnitude <= A.fov * 1.35 and (part.Position - camPos).Magnitude <= A.maxd
and visibleTo(part, curChar, cam) then
best, bestPart, bestHum, bestName = curChar, part, hum, curName
end
end
end
if not best then
for _, e in ipairs(list) do
local part, hum = pick(e.ch, cam, c)
if part then
local sp, on = cam:WorldToViewportPoint(part.Position)
if on then
local d2 = (Vector2.new(sp.X, sp.Y) - c).Magnitude
local d3 = (part.Position - camPos).Magnitude
if d2 <= A.fov and d3 <= A.maxd and visibleTo(part, e.ch, cam) then
local score = (A.prio == 1 and d2) or (A.prio == 2 and d3) or hum.Health
if not bestScore or score < bestScore then
best, bestPart, bestScore, bestHum, bestName = e.ch, part, score, hum, e.name
end
end
end
end
end
end
curChar, curPart, curName = best, bestPart, bestName
if best then
local pos = bestPart.Position
if A.bullet > 0 then
local dist = (pos - camPos).Magnitude
local t = dist / A.bullet
if A.ping then
local ok, p = pcall(function() return game:GetService("Stats").Network.ServerStatsItem["Data Ping"]:GetValue() end)
if ok and type(p) == "number" then t = t + p / 2000 end
end
pos = pos + bestPart.AssemblyLinearVelocity * t
end
silentPos, silentPart = pos, bestPart
hlTarget.Adornee = best
hlTarget.Enabled = A.hl
infoL.Visible = A.info
infoL.Position = UDim2.fromOffset(c.X, c.Y + A.fov + 8)
infoL.Text = string.format("%s · %d HP · %d st", tostring(bestName), math.floor(bestHum.Health), math.floor((pos - camPos).Magnitude))
if engaged() then
if A.method == 2 and mousemoverel then
local sp = cam:WorldToViewportPoint(pos)
local dx, dy = (sp.X - c.X) / math.max(1, A.smooth), (sp.Y - c.Y) / math.max(1, A.smooth)
pcall(mousemoverel, dx, dy)
else
local want = CFrame.lookAt(camPos, pos)
local alpha = (A.smooth <= 1) and 1 or math.clamp(dt * 60 / A.smooth, 0.02, 1)
cam.CFrame = cam.CFrame:Lerp(want, alpha)
end
end
else
silentPos, silentPart = nil, nil
hlTarget.Enabled = false
infoL.Visible = false
end
if A.trig and os.clock() - lastShot >= A.trigDelay / 1000 then
local ray = cam:ViewportPointToRay(vp.X / 2, vp.Y / 2)
local rp = RaycastParams.new()
pcall(function() rp.FilterType = Enum.RaycastFilterType.Exclude end)
rp.FilterDescendantsInstances = { lp.Character }
local res = Workspace:Raycast(ray.Origin, ray.Direction * A.maxd, rp)
if res and res.Instance then
local m = res.Instance:FindFirstAncestorOfClass("Model")
local ok = false
if m then
local pl = Players:GetPlayerFromCharacter(m)
if pl then ok = isEnemyPlayer(pl) else ok = A.npc and npcs[m] == true end
local hum = m:FindFirstChildOfClass("Humanoid")
if ok and hum and hum.Health <= 0 then ok = false end
end
if ok then
lastShot = os.clock()
task.spawn(fireShot, vp)
end
end
end
espAcc = espAcc + dt
if espAcc > 0.4 then
espAcc = 0
local seen = {}
if A.esp then
for _, e in ipairs(list) do
seen[e.ch] = true
if not espHl[e.ch] then
espHl[e.ch] = new("Highlight", {
Adornee = e.ch, FillColor = Color3.fromRGB(255, 90, 100), OutlineColor = Color3.new(1, 1, 1), FillTransparency = 0.75,
DepthMode = Enum.HighlightDepthMode.AlwaysOnTop,
}, gui)
end
end
end
for ch, h in pairs(espHl) do
if not seen[ch] or not ch.Parent then pcall(function() h:Destroy() end) espHl[ch] = nil end
end
end
end
local bound = pcall(function() RunService:BindToRenderStep("XC_Aim", Enum.RenderPriority.Camera.Value + 1, step) end)
if not bound then track(RunService.RenderStepped:Connect(step)) end
env.DG_Cleanups = env.DG_Cleanups or {}
table.insert(env.DG_Cleanups, function()
A.on, A.silent = false, false
pcall(function() RunService:UnbindFromRenderStep("XC_Aim") end)
for _, h in pairs(espHl) do pcall(function() h:Destroy() end) end
for _, o in ipairs({ ring, dotF, infoL, hlTarget, aimPill }) do pcall(function() o:Destroy() end) end
end)
end)
if not okP then DG_Fail("Pestaña Aim", eP) end
end
do
local okP, eP = pcall(function()
local PV = pages[13]
local XC, M = env.XC_CAT, env.XC_M
